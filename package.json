{
  "name": "pixelkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run gen:data && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gen:data": "node scripts/generate-combinations.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "astro check",
    "lint": "eslint . --ext .js,.mjs,.ts,.astro",
    "format": "prettier --write \"**/*.{js,mjs,ts,astro,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.3",
    "@astrojs/sitemap": "3.2.1",
    "@astrojs/tailwind": "^5.1.1",
    "@types/utif": "^3.0.6",
    "astro": "^4.15.0",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "jspdf": "^2.5.1",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "upng-js": "^2.1.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/upng-js": "^2.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-astro": "^1.2.3",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^2.0.5"
  }
}
