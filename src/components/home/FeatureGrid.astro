---
// Feature Grid — "Why PixelKit" with mobile-optimized horizontal card layout

const features = [
  {
    title: 'Private by design',
    body: 'Files are processed locally with Web Workers and Canvas API. Nothing is uploaded, stored, or logged anywhere.',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  },
  {
    title: 'Exact KB targets',
    body: 'Binary-search compression hits your target — 50KB, 100KB, 200KB — with maximum visual quality at that target size.',
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    title: 'No signup, no watermark',
    body: '100% free forever. No accounts, no intrusive ads, and no artificial restrictions. Just fast conversions.',
    icon: '<path d="M12 2l3 7h7l-5.5 4.5L18 20l-6-4-6 4 1.5-6.5L2 9h7z"/>',
  },
  {
    title: 'Works offline',
    body: 'Once loaded, PixelKit keeps functioning even without an internet connection — all engines are cached locally.',
    icon: '<path d="M5 12.55a11 11 0 0 1 14 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.94 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>',
  },
];
---

<section class="mt-12 sm:mt-20 px-2 sm:px-0" aria-labelledby="features-heading">
  <div class="mx-auto max-w-4xl">
    <div>
      <h2
        id="features-heading"
        class="text-lg sm:text-2xl font-bold tracking-tight text-fg"
      >
        Why PixelKit
      </h2>
      <p class="text-[11px] sm:text-xs text-muted mt-0.5">
        Engineered for complete on-device privacy, precision, and speed
      </p>
    </div>

    <div class="mt-4 sm:mt-5 grid gap-2.5 sm:gap-4 sm:grid-cols-2">
      {features.map((f) => (
        <div class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-3.5 sm:p-5 flex items-start gap-3 sm:gap-4 shadow-xs">
          <div class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-xl bg-accent/10 border border-accent/20 text-accent">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={f.icon}
            />
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="text-xs sm:text-sm font-semibold text-fg">{f.title}</h3>
            <p class="mt-1 text-[11px] sm:text-xs text-muted leading-relaxed">{f.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>