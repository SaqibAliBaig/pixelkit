---
import Badge from '@components/ui/Badge.astro';
---

<section class="text-center px-2">
  <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
    <span>No uploads · No accounts · 100% Free</span>
  </Badge>

  <h1 class="mt-3.5 sm:mt-4 text-balance text-3xl font-bold tracking-tight sm:text-5xl lg:text-6xl text-fg">
    Convert &amp; compress files.<br />
    <span class="bg-gradient-to-r from-fg via-muted to-muted/70 bg-clip-text text-transparent">Right in your browser.</span>
  </h1>

  <p class="mx-auto mt-3 sm:mt-5 max-w-prose text-balance text-sm sm:text-base text-muted leading-relaxed">
    Convert, compress, crop, and resize images to exact KB targets or pixel dimensions.
    PixelKit runs 100% on your device, so your files never leave your browser.
  </p>
</section>