---
import Badge from '@components/ui/Badge.astro';

const quickTools = [
  { label: 'Compress Image', href: '/compress-image/' },
  { label: 'Image Converter', href: '/convert/' },
  { label: 'Scale & Resize', href: '/resize-image/' },
  { label: 'Crop Aspect Ratio', href: '/crop-image/' },
  { label: 'Passport Photo', href: '/passport-photo-resizer/' },
];
---

<section class="text-center px-2">
  <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
    <span>100% Client-Side · No Uploads · Free Forever</span>
  </Badge>

  <h1 class="mt-3 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-fg leading-snug sm:leading-none">
    Compress, convert, resize &amp; crop images.<br />
    <span class="bg-gradient-to-r from-fg via-muted to-muted/70 bg-clip-text text-transparent">Right in your browser.</span>
  </h1>

  <p class="mx-auto mt-2.5 sm:mt-5 max-w-prose text-balance text-xs sm:text-base text-muted leading-relaxed">
    All-in-one online image compressor, format converter, pixel resizer, and aspect-ratio cropper.
    Hit exact KB limits (50KB, 100KB, 200KB) across JPG, PNG, WebP, HEIC, SVG &amp; PDF—files never leave your device.
  </p>

  <nav
    aria-label="Core image tools"
    class="mt-4 sm:mt-6 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2"
  >
    {quickTools.map((tool) => (
      <a
        href={tool.href}
        class="inline-flex items-center gap-1 rounded-full border border-border bg-surface/90 px-3 py-1.5 text-xs font-medium text-fg hover:border-accent/50 hover:text-accent transition-colors shadow-xs"
      >
        <span>{tool.label}</span>
      </a>
    ))}
  </nav>
</section>
