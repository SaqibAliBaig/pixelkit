---
import Badge from '@components/ui/Badge.astro';
---

<section class="text-center">
  <Badge variant="muted" class="mx-auto">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
    No uploads · No accounts · Free
  </Badge>

  <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">
    Convert &amp; compress files.<br />
    <span class="text-muted">Right in your browser.</span>
  </h1>

  <p class="mx-auto mt-5 max-w-prose text-balance text-base text-muted leading-relaxed sm:text-lg">
    HEIC → JPG. PNG → PDF. Any image to an exact KB target. PixelKit runs
    entirely on your device, so files never leave your browser.
  </p>
</section>