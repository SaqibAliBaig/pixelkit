---
const items = [
  { label: 'No uploads', sub: 'Files never leave your device' },
  { label: 'No accounts', sub: 'No signup, no email' },
  { label: 'No limits', sub: 'Unlimited files, always free' },
  { label: 'Open stack', sub: 'Built on Astro + vanilla TS' },
];
---

<section
  class="mt-16 border-y border-border bg-surface/50"
  aria-label="Trust signals"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <ul class="grid grid-cols-2 gap-x-6 gap-y-6 py-8 sm:grid-cols-4">
      {items.map((it) => (
        <li class="text-center">
          <p class="flex items-center justify-center gap-1.5 text-sm font-semibold text-fg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-success"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            {it.label}
          </p>
          <p class="mt-1 text-xs text-muted">{it.sub}</p>
        </li>
      ))}
    </ul>
  </div>
</section>