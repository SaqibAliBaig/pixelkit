---
import Converter from '../converter/Converter.astro';
import type { CropAspectPreset } from '@lib/worker/types';

// Default page — HEIC to JPG at no target, so users on the homepage get a
// useful tool immediately.
interface Props {
  from?: string;
  to?: string;
  fromMime?: string;
  toMime?: string;
  targetKb?: number | null;
  initialTool?: 'all' | 'compress' | 'convert' | 'resize' | 'crop' | 'passport' | 'dpi' | 'exif';
  initialSizeMode?: 'max' | 'exact' | 'range' | 'quality';
  minKb?: number | null;
  maxKb?: number | null;
  initialCropAspect?: CropAspectPreset;
  initialUnit?: 'px' | 'cm' | 'mm' | 'in';
  initialWidth?: number | null;
  initialHeight?: number | null;
  initialDpi?: number | null;
  preserveMetadata?: boolean;
  initialMergePdf?: boolean;
  preset?: string;
  category?: 'all' | 'visa' | 'exam' | 'id' | 'social';
}

const {
  from = 'heic',
  to = 'jpg',
  fromMime = 'image/heic',
  toMime = 'image/jpeg',
  targetKb = null,
  initialTool = 'all',
  initialSizeMode,
  minKb,
  maxKb,
  initialCropAspect,
  initialUnit,
  initialWidth,
  initialHeight,
  initialDpi,
  preserveMetadata,
  initialMergePdf,
  preset,
  category,
} = Astro.props;
---

<div class="mx-auto mt-4 sm:mt-10 max-w-4xl">
  <Converter
    from={from}
    to={to}
    fromMime={fromMime}
    toMime={toMime}
    targetKb={targetKb}
    initialTool={initialTool}
    initialSizeMode={initialSizeMode}
    minKb={minKb}
    maxKb={maxKb}
    initialCropAspect={initialCropAspect}
    initialUnit={initialUnit}
    initialWidth={initialWidth}
    initialHeight={initialHeight}
    initialDpi={initialDpi}
    preserveMetadata={preserveMetadata}
    initialMergePdf={initialMergePdf}
    preset={preset}
    category={category}
  />
</div>
