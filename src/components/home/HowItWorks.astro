---
// "How It Works" Section — Clean mobile card flow and responsive 3-step layout

const steps = [
  {
    n: '1',
    step: '01',
    title: 'Drop your files',
    body: 'Drag any photo or document into the drop zone, or browse. Zero signup required — the tool boots immediately.',
  },
  {
    n: '2',
    step: '02',
    title: 'Choose target size',
    body: 'Select output format and optional exact KB limit. PixelKit smartly compresses files to hit your exact size target.',
  },
  {
    n: '3',
    step: '03',
    title: 'Download instantly',
    body: 'Download processed files straight from your device memory. Since nothing leaves your browser, there is zero wait time.',
  },
];
---

<section class="mt-12 sm:mt-20 px-2 sm:px-0" aria-labelledby="how-heading">
  <div class="mx-auto max-w-4xl">
    <div>
      <h2
        id="how-heading"
        class="text-lg sm:text-2xl font-bold tracking-tight text-fg"
      >
        How it works
      </h2>
      <p class="text-[11px] sm:text-xs text-muted mt-0.5">
        Fast, automated 3-step conversion running 100% in your browser
      </p>
    </div>

    <!-- Mobile horizontal card flow, Desktop 3-column grid -->
    <ol class="mt-4 sm:mt-5 grid gap-2.5 sm:gap-4 sm:grid-cols-3">
      {steps.map((s) => (
        <li class="relative rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-3.5 sm:p-5 flex sm:flex-col items-start gap-3.5 sm:gap-0 shadow-xs">
          <div class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl bg-accent text-accent-fg font-mono text-xs font-bold shrink-0 shadow-xs">
            {s.step}
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="sm:mt-3 text-xs sm:text-sm font-semibold text-fg">{s.title}</h3>
            <p class="mt-1 text-[11px] sm:text-xs text-muted leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>