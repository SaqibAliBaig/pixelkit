---
// Popular Conversions Grid — Mobile-first 2-column layout and clean desktop cards

const conversions = [
  { from: 'HEIC', to: 'JPG', label: 'HEIC → JPG', href: '/heic-to-jpg/', note: 'iPhone photos', badge: null },
  { from: 'HEIC', to: 'JPG', label: 'HEIC → JPG', href: '/heic-to-jpg-under-100kb/', note: 'Aadhaar, forms', badge: '100 KB' },
  { from: 'PNG', to: 'JPG', label: 'PNG → JPG', href: '/png-to-jpg/', note: 'Smaller files', badge: null },
  { from: 'JPG', to: 'PDF', label: 'JPG → PDF', href: '/jpg-to-pdf/', note: 'Documents', badge: null },
  { from: 'JPG', to: 'PDF', label: 'JPG → PDF', href: '/jpg-to-pdf-under-100kb/', note: 'Portal uploads', badge: '100 KB' },
  { from: 'PNG', to: 'WEBP', label: 'PNG → WEBP', href: '/png-to-webp/', note: 'Web images', badge: null },
  { from: 'JPG', to: 'WEBP', label: 'JPG → WEBP', href: '/jpg-to-webp/', note: 'Fast loading', badge: null },
  { from: 'HEIC', to: 'JPG', label: 'HEIC → JPG', href: '/heic-to-jpg-under-50kb/', note: 'Exam portals', badge: '50 KB' },
];
---

<section class="mt-12 sm:mt-20 px-2 sm:px-0" aria-labelledby="popular-heading">
  <div class="mx-auto max-w-4xl">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h2
          id="popular-heading"
          class="text-lg sm:text-2xl font-bold tracking-tight text-fg"
        >
          Popular conversions
        </h2>
        <p class="text-[11px] sm:text-xs text-muted mt-0.5">
          One-click presets for web, government forms & social media
        </p>
      </div>

      <a
        href="/convert/"
        class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-accent hover:opacity-80 transition-opacity shrink-0"
      >
        <span>All</span>
        <span class="hidden sm:inline">conversions</span>
        <span>→</span>
      </a>
    </div>

    <!-- 2-column grid on mobile, 4-column on desktop -->
    <ul class="mt-4 sm:mt-5 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3">
      {conversions.map((c) => (
        <li>
          <a
            href={c.href}
            class="group relative flex flex-col justify-between rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-3 sm:p-4 hover:border-accent/40 hover:bg-surface active:scale-[0.98] transition-all h-full shadow-xs hover:shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between gap-1">
                <span class="text-xs sm:text-sm font-semibold text-fg group-hover:text-accent transition-colors">
                  {c.label}
                </span>
                {c.badge && (
                  <span class="rounded font-mono text-[9px] sm:text-[10px] font-bold px-1.5 py-0.5 bg-accent/10 text-accent border border-accent/25 shrink-0">
                    {c.badge}
                  </span>
                )}
              </div>
            </div>
            <div class="mt-2.5 flex items-center justify-between text-[11px] sm:text-xs text-muted">
              <span class="truncate">{c.note}</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted/60 group-hover:text-accent group-hover:translate-x-0.5 transition-all shrink-0 ml-1">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <!-- Quick Jump Presets Organized by Tool Category -->
    <div class="mt-4 pt-4 border-t border-border/60 space-y-2.5 text-xs">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-muted font-medium text-[11px] mr-1">Compress & exact KB:</span>
        <a href="/compress-image-to-10kb/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">10KB</a>
        <a href="/compress-image-to-20kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Resize / Compress to 20KB</a>
        <a href="/compress-image-to-30kb/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">30KB</a>
        <a href="/compress-image-to-50kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Resize / Compress to 50KB</a>
        <a href="/compress-image-to-100kb/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">100KB</a>
        <a href="/compress-image-to-200kb/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">200KB</a>
        <a href="/compress-image-to-1mb/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">1MB</a>
        <a href="/compress-jpg-to-100kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">JPG to 100KB</a>
        <a href="/compress-image-without-losing-quality/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Without Losing Quality</a>
        <a href="/reduce-image-size-in-kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Reduce Size in KB</a>
        <a href="/increase-image-size-in-kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Increase Size in KB</a>
        <a href="/resize-image-to-20kb-to-50kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Resize Image to 20KB–50KB</a>
        <a href="/aadhaar-pdf-compressor/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Aadhaar PDF 100KB</a>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="text-muted font-medium text-[11px] mr-1">Resize, CM & 300 DPI:</span>
        <a href="/resize-image/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Resize Image</a>
        <a href="/image-resizer-in-cm/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Resizer in CM</a>
        <a href="/change-image-dpi-to-300/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">300 DPI Converter</a>
        <a href="/pixels-to-cm-converter/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Pixels to CM</a>
        <a href="/cm-to-pixels-at-300-dpi/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">CM to Pixels 300 DPI</a>
        <a href="/portal-photo-size-chart/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Portal Photo Chart</a>
        <a href="/signature-resizer/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Signature Resizer</a>
        <a href="/social-media-image-resizer/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Social Media Resizer</a>
        <a href="/bulk-image-resizer/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Bulk Resizer</a>
        <a href="/exif-metadata-remover/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">EXIF Remover</a>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="text-muted font-medium text-[11px] mr-1">PDF & format tools:</span>
        <a href="/heic-to-pdf/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">HEIC to PDF</a>
        <a href="/webp-to-pdf/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">WebP to PDF</a>
        <a href="/svg-to-pdf/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">SVG to PDF</a>
        <a href="/png-to-avif/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">PNG to AVIF</a>
        <a href="/heic-to-png/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">HEIC to PNG</a>
        <a href="/png-to-pdf/" class="rounded-lg border border-border bg-surface px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">PNG to PDF</a>
        <a href="/merge-jpg-to-pdf/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Merge JPG to PDF</a>
        <a href="/image-to-pdf-200kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Image to PDF 200KB</a>
        <a href="/how-to-convert-heic-to-jpg-on-windows/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">HEIC on Windows</a>
        <a href="/how-to-convert-photo-to-pdf-on-iphone/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Photo to PDF on iPhone</a>
        <a href="/photo-to-pdf/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Photo to PDF</a>
        <a href="/photo-to-pdf-200kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Photo to PDF 200KB</a>
        <a href="/photo-to-pdf-100kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Photo to PDF 100KB</a>
        <a href="/jpg-to-jpeg/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Convert JPG to JPEG</a>
        <a href="/how-to-convert-image-to-pdf/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">How to Convert Image to PDF</a>
        <a href="/image-to-pdf/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Image to PDF →</a>
      </div>
    </div>
  </div>
</section>