---
// Static template only. Not rendered directly — used by the island for
// downloads and per-file error states. Kept as a component for tests and
// SSR consistency.
interface Props {
  filename: string;
  sizeLabel: string;
  downloadUrl: string;
  originalLabel?: string;
}

const { filename, sizeLabel, downloadUrl, originalLabel } = Astro.props;
---

<div class="flex items-center gap-3 rounded-xl border border-success/30 bg-success/5 px-3 py-3">
  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-success/15 text-success">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </div>
  <div class="min-w-0 flex-1">
    <p class="truncate text-sm font-medium text-fg">{filename}</p>
    <p class="text-xs text-muted">
      {originalLabel && <span>{originalLabel} → </span>}
      {sizeLabel}
    </p>
  </div>
  <a
    href={downloadUrl}
    download={filename}
    class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-3 py-1.5 text-xs font-medium text-accent-fg hover:opacity-90"
  >
    Download
  </a>
</div>