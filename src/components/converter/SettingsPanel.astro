      </div>

      <p id="pk-dpi-hint" class={`text-[11px] text-muted leading-snug ${initialTool === 'dpi' || initialDpi ? '' : 'hidden'}`}>
        Embeds official JFIF / EXIF / pHYs print density headers with zero quality loss.
      </p>
    </div>

    
    <!-- Toggle More Tools Button (Hidden on Home 'all', visible on dedicated tools) -->
    <div id="pk-more-tools-toggle-wrapper" class={initialTool === 'all' ? 'hidden' : 'pt-0.5'}>
      <button
        type="button"
        id="pk-toggle-more-tools-btn"
        class="w-full flex items-center justify-between rounded-xl border border-dashed border-border/80 bg-surface/60 hover:bg-surface px-3.5 py-2.5 text-xs font-medium text-muted hover:text-fg hover:border-accent/40 transition-all cursor-pointer group shadow-2xs"
        aria-expanded="false"
      >
        <span class="flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-md bg-accent/15 text-accent font-bold text-xs group-hover:scale-105 transition-transform">+</span>
          <span id="pk-more-tools-btn-label">
            {initialTool === 'convert' ? 'Add Compression, Crop, or Resize (Optional)' :
             initialTool === 'compress' ? 'Add Format, Crop, or Resize (Optional)' :
             initialTool === 'crop' ? 'Add Resize, Format, or Compression (Optional)' :
             initialTool === 'resize' ? 'Add Crop, Format, or Compression (Optional)' :
             initialTool === 'dpi' ? 'Add Resize, Compression, or Format (Optional)' :
             initialTool === 'exif' ? 'Add Compression, Resize, or Crop (Optional)' :
             'Additional Editing & Compression Tools'}
          </span>
          <span id="pk-more-tools-active-badge" class="hidden text-[10px] font-mono px-1.5 py-0.2 rounded bg-accent/20 text-accent font-bold">1 active</span>
        </span>
        <span class="text-[11px] text-accent font-semibold flex items-center gap-1 group-hover:underline">
          <span id="pk-more-tools-action-text">Show</span>
          <svg id="pk-more-tools-chevron" class="w-3.5 h-3.5 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </button>
    </div>

<!-- STAGE 6: Advanced Options & Filters -->
    <details
      open={isExifTool || !initialPreserveMetadata}
      class={`group rounded-xl border p-3 text-xs ${
        isExifTool ? 'border-accent bg-accent/5 shadow-xs ring-1 ring-accent/20' : 'border-border/80 bg-surface/40'
      }`}
      id="pk-stage-advanced"
    >
      <summary class="flex items-center justify-between font-semibold text-fg cursor-pointer select-none">
        <div class="flex items-center gap-2">
          <span>{isExifTool ? 'EXIF & Privacy Scrubbing' : 'Advanced Options & Filters'}</span>
          <span id="pk-editing-active-badge" class={`${!initialPreserveMetadata ? '' : 'hidden'} h-2 w-2 rounded-full bg-accent animate-pulse`} title="Edits active"></span>
        </div>
        <svg class="h-4 w-4 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="mt-3 pt-3 border-t border-border/60 space-y-2">
        <p id="pk-exif-status-note" class={`text-[11px] font-medium text-accent leading-snug ${!initialPreserveMetadata ? '' : 'hidden'}`}>
          Privacy mode active: All hidden EXIF, GPS location, camera serial &amp; timestamp tags will be stripped cleanly.
        </p>
        <div class="flex items-center gap-2 text-xs text-fg cursor-pointer" onclick="document.getElementById('pk-preserve-metadata')?.click()">
          <input
            id="pk-preserve-metadata"
            type="checkbox"
            checked={initialPreserveMetadata}
            aria-label="Preserve EXIF metadata (Camera, GPS, date)"
            class="h-4 w-4 rounded border-border accent-accent cursor-pointer"
          />
          <span class="select-none">Preserve EXIF metadata (Camera, GPS, date)</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-fg cursor-pointer" onclick="document.getElementById('pk-strip-transparency')?.click()">
          <input
            id="pk-strip-transparency"
            type="checkbox"
            checked
            aria-label="Fill transparent backgrounds with white (for JPG)"
            class="h-4 w-4 rounded border-border accent-accent cursor-pointer"
          />
          <span class="select-none">Fill transparent backgrounds with white (for JPG)</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-fg cursor-pointer" onclick="document.getElementById('pk-auto-orient')?.click()">
          <input
            id="pk-auto-orient"
            type="checkbox"
            checked
            aria-label="Auto-orient photos (EXIF correction)"
            class="h-4 w-4 rounded border-border accent-accent cursor-pointer"
          />
          <span class="select-none">Auto-orient photos (EXIF correction)</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-fg cursor-pointer" onclick="document.getElementById('pk-grayscale-filter')?.click()">
          <input
            id="pk-grayscale-filter"
            type="checkbox"
            aria-label="Black & White (Grayscale filter)"
            class="h-4 w-4 rounded border-border accent-accent cursor-pointer"
          />
          <span class="select-none">Black &amp; White (Grayscale filter)</span>
        </div>
      </div>
    </details>

    </div>

    <!-- Quick Discovery Card for Portal Presets (Pinned to the very end) -->
    <div id="pk-card-portal-discovery" class={`rounded-xl border border-border/70 bg-surface/50 p-3 hover:border-accent/40 transition-colors ${initialTool === 'all' ? '' : 'hidden'}`}>
      <div class="flex items-start gap-2.5">
        <div class="h-7 w-7 rounded-lg bg-accent/10 border border-accent/25 flex items-center justify-center text-accent shrink-0 mt-0.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <line x1="7" y1="8" x2="17" y2="8"></line>
            <line x1="7" y1="12" x2="17" y2="12"></line>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="text-xs font-bold text-fg block">Official Visa &amp; Passport Profiles</span>
          <p class="text-[11px] text-muted mt-0.5 leading-snug">
            Need 1-click verified specs for US Visa, Indian Passport, Schengen, Exam 50KB or Canada PR?
          </p>
          <button
            type="button"
            id="pk-btn-switch-to-portal"
            class="mt-2 text-xs font-bold text-accent hover:underline inline-flex items-center gap-1 cursor-pointer"
          >
            Browse {totalCount} Official Portal Presets →
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- PANEL 2: Portal Presets Mode (Dedicated, Spacious, Zero Truncation) -->
  <div id="pk-panel-portal" class={`mt-4 space-y-3 ${initialTool === 'passport' ? '' : 'hidden'}`}>
    <div class="flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-fg uppercase tracking-wider block">
          {panelTitle}
        </span>
        <p class="text-[11px] text-muted mt-0.5">
          {panelSubtitle}
        </p>
      </div>
      <button
        type="button"
        id="pk-portal-panel-reset"
        class="text-[11px] text-muted hover:text-accent font-medium hidden cursor-pointer shrink-0"
      >
        Reset to manual
      </button>
    </div>

    <!-- Live Search & Category Filters -->
    <div class="space-y-2">
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-muted">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="search"
          id="pk-portal-search"
          placeholder="Filter presets (e.g. US, UK, UPSC, China)..."
          class="w-full rounded-lg border border-border bg-surface pl-8 pr-3 py-1.5 text-xs text-fg placeholder:text-muted focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
          autocomplete="off"
        />
      </div>

      <div class="flex flex-wrap gap-1.5 text-[11px]" id="pk-portal-category-filters">
        <button
          type="button"
          class={`pk-cat-filter shrink-0 whitespace-nowrap rounded-lg border px-2.5 py-1 text-xs font-medium cursor-pointer transition-all shadow-2xs ${
            initialCat === 'all'
              ? 'active border-accent bg-accent/15 font-semibold text-accent shadow-xs'
              : 'border-border bg-surface text-muted hover:text-fg hover:border-accent/40'
          }`}
          data-cat="all"
        >
          All ({totalCount})
        </button>
        <button
          type="button"
          class={`pk-cat-filter shrink-0 whitespace-nowrap rounded-lg border px-2.5 py-1 text-xs font-medium cursor-pointer transition-all shadow-2xs ${
            initialCat === 'visa'
              ? 'active border-accent bg-accent/15 font-semibold text-accent shadow-xs'
              : 'border-border bg-surface text-muted hover:text-fg hover:border-accent/40'
          }`}
          data-cat="visa"
        >
          🛂 Passports ({visaCount})
        </button>
        <button
          type="button"
          class={`pk-cat-filter shrink-0 whitespace-nowrap rounded-lg border px-2.5 py-1 text-xs font-medium cursor-pointer transition-all shadow-2xs ${
            initialCat === 'exam'
              ? 'active border-accent bg-accent/15 font-semibold text-accent shadow-xs'
              : 'border-border bg-surface text-muted hover:text-fg hover:border-accent/40'
          }`}
          data-cat="exam"
        >
          🎓 Exams &amp; Jobs ({examCount})
        </button>
        <button
          type="button"
          class={`pk-cat-filter shrink-0 whitespace-nowrap rounded-lg border px-2.5 py-1 text-xs font-medium cursor-pointer transition-all shadow-2xs ${
            initialCat === 'id'
              ? 'active border-accent bg-accent/15 font-semibold text-accent shadow-xs'
              : 'border-border bg-surface text-muted hover:text-fg hover:border-accent/40'
          }`}
          data-cat="id"
        >
          🪪 IDs &amp; Docs ({idCount})
        </button>
        <button
          type="button"
          class={`pk-cat-filter shrink-0 whitespace-nowrap rounded-lg border px-2.5 py-1 text-xs font-medium cursor-pointer transition-all shadow-2xs ${
            initialCat === 'social'
              ? 'active border-accent bg-accent/15 font-semibold text-accent shadow-xs'
              : 'border-border bg-surface text-muted hover:text-fg hover:border-accent/40'
          }`}
          data-cat="social"
        >
          📱 Social &amp; Web ({socialCount})
        </button>
      </div>
    </div>

    <!-- Hidden standard select for form / test compatibility -->
    <select id="pk-portal-preset-select" class="sr-only" tabindex="-1" aria-hidden="true">
      {PORTAL_PRESETS.map((p) => (
        <option value={p.id} selected={p.id === preset}>{p.name}</option>
      ))}
    </select>

    <!-- Scrollable Preset Cards List: NO TRUNCATION -->
    <div id="pk-portal-cards-list" class="max-h-[460px] overflow-y-auto pr-1 space-y-2 scrollbar-thin" role="listbox" aria-label="Portal Presets">
      {(() => {
        const cards = visiblePresets.map((p) => {
          const isSelected = preset === p.id;
          const searchKeywords = (p.keywords || []).join(' ');
          const searchStr = `${p.name} ${p.countryCode} ${p.desc} ${p.dimLabel} ${searchKeywords} ${p.portalSummary || ''}`.toLowerCase();
          const isMatchInitialCat = initialCat === 'all' || p.category === initialCat;
          return (
            <button
              type="button"
              role="option"
              data-id={p.id}
              data-cat={p.category}
              data-flag={p.flag}
              data-code={p.countryCode}
              data-name={p.name}
              data-desc={p.desc}
              data-badge={p.badge}
              data-target-kb={p.targetKb ?? ''}
              data-crop-aspect={p.cropAspect}
              data-crop-anchor={p.cropAnchor}
              data-width={p.width ?? ''}
              data-height={p.height ?? ''}
              data-search={searchStr}
              aria-selected={isSelected ? 'true' : 'false'}
              class={`pk-portal-preset-card group relative w-full rounded-xl border p-2.5 text-left transition-all cursor-pointer shadow-2xs ${
                !isMatchInitialCat ? 'hidden ' : ''
              }${
                isSelected
                  ? 'border-accent bg-accent/10 shadow-xs'
                  : 'border-border bg-surface hover:border-accent/60 hover:bg-surface/90'
              }`}
            >
              <div class="flex items-start justify-between gap-2">
                <div class="flex items-start gap-2.5 min-w-0">
                  <span class="inline-flex items-center justify-center h-7 w-7 rounded-lg bg-bg border border-border/80 font-bold text-xs uppercase shrink-0 shadow-2xs group-hover:border-accent/40 group-hover:text-accent transition-colors mt-0.5 overflow-hidden">
                    <PresetIcon
                      presetId={p.id}
                      category={p.category}
                      countryCode={p.countryCode}
                      class="w-5 h-5"
                    />
                  </span>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class="font-bold text-fg text-xs group-hover:text-accent transition-colors">
                        {p.name}
                      </span>
                      {p.badge && (
                        <span class="font-mono text-[9px] px-1.5 py-0.2 rounded bg-bg border border-border text-muted font-bold shrink-0">
                          {p.badge}
                        </span>
                      )}
                    </div>

                    <!-- Specs row: Dimensions + File limit -->
                    <div class="mt-1 flex items-center gap-1.5 flex-wrap text-[11px]">
                      <span class="inline-flex items-center rounded-md bg-bg px-2 py-0.5 font-medium text-fg border border-border/70">
                        {p.dimLabel}
                      </span>
                      <span class="inline-flex items-center rounded-md bg-accent/10 px-2 py-0.5 font-semibold text-accent border border-accent/25">
                        Max {p.targetKb} KB JPG
                      </span>
                    </div>

                    <!-- Description: full text, never truncated with ... -->
                    <p class="mt-1 text-[11px] text-muted leading-relaxed">
                      {p.portalSummary || p.desc}
                    </p>
                  </div>
                </div>

                <!-- Active Check Badge -->
                <div class={`pk-portal-card-check shrink-0 mt-0.5 ${isSelected ? '' : 'hidden'}`}>
                  <span class="inline-flex items-center gap-1 rounded-full bg-accent text-accent-fg px-2 py-0.5 text-[10px] font-bold">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Active
                  </span>
                </div>
              </div>
            </button>
          );
        });
        return initialTool === 'passport' ? (
          cards
        ) : (
          <template id="pk-portal-cards-template">{cards}</template>
        );
      })()}

      <!-- Zero search results message -->
      <div id="pk-portal-no-matches" class="hidden rounded-xl border border-border/60 bg-bg/50 p-4 text-center">
        <p class="text-xs text-muted">No presets found matching your filter.</p>
      </div>
    </div>

    <!-- Active Summary -->
    <p id="pk-portal-applied-summary" class="text-[11px] text-accent font-medium hidden">
    </p>

    <!-- Footer of portal panel -->
    <div class="pt-2 border-t border-border/60 flex items-center justify-between text-xs">
      <button
        type="button"
        id="pk-btn-back-to-custom"
        class="text-muted hover:text-accent font-medium transition-colors cursor-pointer inline-flex items-center gap-1"
      >
        <span>← Back to Custom Pipeline</span>
      </button>
      <span class="text-[11px] text-muted">100% In-Browser</span>
    </div>
  </div>
</div>
