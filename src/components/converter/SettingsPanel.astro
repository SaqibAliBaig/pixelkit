---
import PresetIcon from './PresetIcon.astro';
import { PORTAL_PRESETS } from '@lib/portal-presets';

interface Props {
  from: string;
  to: string;
  targetKb: number | null;
  initialTool?: 'all' | 'compress' | 'convert' | 'resize' | 'crop' | 'passport' | 'dpi' | 'exif';
  initialSizeMode?: 'max' | 'exact' | 'range' | 'quality';
  minKb?: number | null;
  maxKb?: number | null;
  initialCropAspect?: string;
  initialUnit?: 'px' | 'cm' | 'mm' | 'in';
  initialWidth?: number | null;
  initialHeight?: number | null;
  initialDpi?: number | null;
  preserveMetadata?: boolean;
  initialMergePdf?: boolean;
  preset?: string;
  category?: 'all' | 'visa' | 'exam' | 'id' | 'social';
}

const {
  from,
  to,
  targetKb,
  initialTool = 'all',
  initialSizeMode = 'max',
  minKb = null,
  maxKb = null,
  initialCropAspect = 'original',
  initialUnit = 'px',
  initialWidth = null,
  initialHeight = null,
  initialDpi = null,
  preserveMetadata,
  initialMergePdf = false,
  preset,
  category,
} = Astro.props;

const allPresetsWithoutNone = PORTAL_PRESETS.filter((p) => p.id !== 'none');
const visiblePresets = allPresetsWithoutNone;

const visaCount = allPresetsWithoutNone.filter((p) => p.category === 'visa').length;
const examCount = allPresetsWithoutNone.filter((p) => p.category === 'exam').length;
const idCount = allPresetsWithoutNone.filter((p) => p.category === 'id').length;
const socialCount = allPresetsWithoutNone.filter((p) => p.category === 'social').length;
const totalCount = allPresetsWithoutNone.length;

const activePresetObj = preset ? PORTAL_PRESETS.find((p) => p.id === preset) : null;
const initialCat = (category && category !== 'all' ? category : null) || activePresetObj?.category || 'all';

const panelTitle = 'Official Preset Profiles';
const panelSubtitle = `${totalCount} verified standards: Passports, Visas, Exams, IDs & Social Media.`;







// Crop Aspects
const CROP_ASPECTS = [
  { value: 'original', label: 'Original', badge: 'AUTO', desc: 'Preserve natural aspect ratio' },
  { value: '1:1', label: '1:1 Square', badge: '1:1', desc: 'US Visa, WhatsApp, Instagram avatar' },
  { value: '3.5:4.5', label: '3.5 : 4.5 Passport', badge: '35×45', desc: 'Indian Passport, Schengen, UKVI' },
  { value: '4:5', label: '4:5 Portrait', badge: '4:5', desc: 'Social mobile feeds & Instagram' },
  { value: '4:3', label: '4:3 Standard', badge: '4:3', desc: 'Classic digital & document frame' },
  { value: '16:9', label: '16:9 Landscape', badge: '16:9', desc: 'Widescreen presentation & YouTube' },
  { value: '9:16', label: '9:16 Story / Reel', badge: '9:16', desc: 'Mobile full screen story & shorts' },
  { value: '3:2', label: '3:2 Photo', badge: '3:2', desc: 'Classic 35mm DSLR photography' },
  { value: '3:4', label: '3:4 Portrait', badge: '3:4', desc: 'Official ID & portrait card' },
  { value: '5:7', label: '5:7 Canada Visa', badge: '5:7', desc: 'Canada IRCC 50×70mm standard' },
  { value: '2:1', label: '2:1 Signature', badge: '2:1', desc: 'Govt signature upload slot' },
  { value: '3:1', label: '3:1 X Header', badge: '3:1', desc: 'Twitter / X widescreen banner' },
  { value: '4:1', label: '4:1 LinkedIn', badge: '4:1', desc: 'LinkedIn profile cover banner' },
];

const activeCropOption = CROP_ASPECTS.find((c) => c.value === initialCropAspect) || CROP_ASPECTS[0]!;
const initialCropHint = activeCropOption.value === 'original' ? 'Original' : activeCropOption.label;

// Target Presets Ladder with KB and MB tiers
const TARGET_PRESETS = [
  { value: '', kb: null, badge: 'AUTO', label: 'Best quality (no limit)', desc: 'Full fidelity without file size limit', section: 'unlimited' },
  // Standard KB Limits
  { value: '20', kb: 20, badge: '20 KB', label: '20 KB', desc: 'Signatures, small stamps & portal uploads', section: 'kb' },
  { value: '50', kb: 50, badge: '50 KB', label: '50 KB', desc: 'Government, exam & job application portals', section: 'kb' },
  { value: '100', kb: 100, badge: '100 KB', label: '100 KB', desc: 'Standard web photo & fast loading', section: 'kb' },
  { value: '200', kb: 200, badge: '200 KB', label: '200 KB', desc: 'Passport, visa & online photo forms', section: 'kb' },
  { value: '300', kb: 300, badge: '300 KB', label: '300 KB', desc: 'ID cards & crisp profile avatars', section: 'kb' },
  { value: '500', kb: 500, badge: '500 KB', label: '500 KB', desc: 'High-quality web presentation & social', section: 'kb' },
  // Megabyte Limits
  { value: '1024', kb: 1024, badge: '1 MB', label: '1 MB (1,024 KB)', desc: 'Email attachment standard & messaging', section: 'mb' },
  { value: '2048', kb: 2048, badge: '2 MB', label: '2 MB (2,048 KB)', desc: 'Discord free tier, blogs & CMS limit', section: 'mb' },
  { value: '5120', kb: 5120, badge: '5 MB', label: '5 MB (5,120 KB)', desc: 'High-res photography & web portfolio', section: 'mb' },
  { value: '10240', kb: 10240, badge: '10 MB', label: '10 MB (10,240 KB)', desc: 'Print-ready graphics & high-res assets', section: 'mb' },
  { value: '25600', kb: 25600, badge: '25 MB', label: '25 MB (25,600 KB)', desc: 'Maximum email file attachment limit', section: 'mb' },
  { value: '51200', kb: 51200, badge: '50 MB', label: '50 MB (51,200 KB)', desc: 'Large raw photo & high-res document', section: 'mb' },
  { value: '102400', kb: 102400, badge: '100 MB', label: '100 MB (102,400 KB)', desc: 'Ultra high-res print & bulk media', section: 'mb' },
  // Custom
  { value: 'custom', kb: null, badge: 'CUST', label: 'Custom Size…', desc: 'Enter any exact KB or MB value without limits', section: 'custom' },
];

const matchedTargetPreset = TARGET_PRESETS.find((p) => p.kb !== null && p.kb === targetKb);
const isCustomTargetKb = Boolean(targetKb && !matchedTargetPreset);
const activePreset = matchedTargetPreset || (targetKb ? TARGET_PRESETS.find((p) => p.value === 'custom')! : TARGET_PRESETS[0]!);
const selectedTargetSelectVal = isCustomTargetKb ? 'custom' : (targetKb ? String(targetKb) : '');
const formattedCustomKbBadge = targetKb
  ? (targetKb >= 1024 && targetKb % 1024 === 0 ? `${targetKb / 1024} MB` : `${targetKb} KB`)
  : 'CUST';
const displayTargetBadge = isCustomTargetKb ? formattedCustomKbBadge : activePreset.badge;
const displayTargetLabel = targetKb
  ? `${initialSizeMode === 'exact' ? 'Exact ' : 'Under '}${isCustomTargetKb ? formattedCustomKbBadge : activePreset.label}`
  : activePreset.label;

function formatInitialTargetBadge(
  kb: number | null,
  mode: 'max' | 'exact' | 'range' | 'quality',
  minVal: number | null,
  maxVal: number | null
): string {
  if (mode === 'quality') return 'Quality 85%';
  if (mode === 'range') {
    const lo = minVal ?? 20;
    const hi = maxVal ?? kb ?? 50;
    return `Range: ${lo}–${hi} KB`;
  }
  if (!kb) return 'Best quality (no limit)';
  const prefix = mode === 'exact' ? 'Exact ' : 'Max ';
  if (kb >= 1024) {
    const mb = kb / 1024;
    return mb % 1 === 0 ? `${prefix}${mb} MB` : `${prefix}${mb.toFixed(1)} MB`;
  }
  return `${prefix}${kb} KB`;
}

function unitValToPx(val: number, u: 'px' | 'cm' | 'mm' | 'in', dpi: number): number {
  if (u === 'cm') return Math.max(10, Math.round((val / 2.54) * dpi));
  if (u === 'mm') return Math.max(10, Math.round((val / 25.4) * dpi));
  if (u === 'in') return Math.max(10, Math.round(val * dpi));
  return Math.max(10, Math.round(val));
}

const activeDimDpi = initialDpi || 300;
const hasInitialCustomDims = Boolean(initialWidth || initialHeight || initialUnit !== 'px');
const initialPxW = initialWidth ? unitValToPx(initialWidth, initialUnit, activeDimDpi) : null;
const initialPxH = initialHeight ? unitValToPx(initialHeight, initialUnit, activeDimDpi) : null;
const initialResizeHint = hasInitialCustomDims && initialWidth && initialHeight
  ? (initialUnit === 'px'
      ? `${initialWidth}×${initialHeight} px`
      : `${initialWidth}×${initialHeight} ${initialUnit} (${initialPxW}×${initialPxH} px)`)
  : '100% (Original)';

const selectedDpiPill = !initialDpi
  ? 'auto'
  : (['72', '150', '200', '300', '600'].includes(String(initialDpi)) ? String(initialDpi) : 'custom');
const initialDpiBadge = initialDpi ? `${initialDpi} DPI` : 'Auto (Original)';
const isExifTool = initialTool === 'exif';
const initialPreserveMetadata = preserveMetadata !== undefined ? preserveMetadata : !isExifTool;

const OUTPUT_FORMATS = [
  { value: 'jpg', label: 'JPG / JPEG', badge: 'JPG', desc: 'Universal web & print photo', mime: 'image/jpeg' },
  { value: 'png', label: 'PNG', badge: 'PNG', desc: 'Lossless transparency & graphics', mime: 'image/png' },
  { value: 'webp', label: 'WEBP', badge: 'WEBP', desc: 'Modern efficient web image', mime: 'image/webp' },
  { value: 'pdf', label: 'PDF Document', badge: 'PDF', desc: 'Printable multi-page document', mime: 'application/pdf' },
  { value: 'avif', label: 'AVIF', badge: 'AVIF', desc: 'Next-gen maximum compression', mime: 'image/avif' },
  { value: 'svg', label: 'SVG Vector', badge: 'SVG', desc: 'Scalable vector graphic', mime: 'image/svg+xml' },
];

const normalizedTo = to.toLowerCase() === 'jpeg' ? 'jpg' : to.toLowerCase();
const isExplicitJpegExt = to.toLowerCase() === 'jpeg';
const activeFmtBase = OUTPUT_FORMATS.find((f) => f.value === normalizedTo) || OUTPUT_FORMATS[0]!;
const activeFmt = isExplicitJpegExt
  ? { ...activeFmtBase, badge: 'JPEG', label: 'JPEG (.jpeg)', desc: 'Strict .jpeg portal extension' }
  : activeFmtBase;
const isFormatPairDifferent =
  from.toLowerCase() !== to.toLowerCase() && !(from.toLowerCase() === 'jpeg' && to.toLowerCase() === 'jpg');
const initialModeBadgeText =
  initialTool === 'all'
    ? 'All-in-One'
    : initialTool === 'passport'
      ? 'PRESETS'
      : initialTool === 'dpi'
        ? `${initialDpi || 300} DPI`
        : initialTool === 'exif'
          ? 'EXIF CLEAN'
          : initialTool.toUpperCase();
---

<div class="rounded-xl border border-border bg-bg/40 p-4">
  <!-- Header with Segmented Mode Tabs -->
  <div class="flex items-center justify-between pb-3 border-b border-border/60">
    <div class="flex items-center gap-2">
      <div class="text-xs uppercase tracking-wider text-muted font-bold" role="heading" aria-level="2">
        Settings
      </div>
      <span id="pk-settings-mode-badge" class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-surface border border-border text-muted font-semibold">
        {initialModeBadgeText}
      </span>
    </div>
    <div class="flex items-center gap-1 shrink-0" role="tablist" aria-label="Settings Mode">
      <button
        type="button"
        id="pk-tab-custom"
        role="tab"
        aria-selected={initialTool !== 'passport'}
        aria-controls="pk-panel-custom"
        class={`rounded-lg px-3 py-1.5 sm:py-1 text-xs transition-all cursor-pointer font-medium touch-manipulation ${
          initialTool !== 'passport'
            ? 'font-semibold bg-surface text-fg border border-border/60 shadow-2xs'
            : 'text-muted hover:text-fg'
        }`}
      >
        Custom
      </button>
      <button
        type="button"
        id="pk-tab-portal"
        role="tab"
        aria-selected={initialTool === 'passport'}
        aria-controls="pk-panel-portal"
        class={`rounded-lg px-3 py-1.5 sm:py-1 text-xs transition-all cursor-pointer flex items-center gap-1 font-medium touch-manipulation ${
          initialTool === 'passport'
            ? 'font-semibold bg-surface text-fg border border-border/60 shadow-2xs'
            : 'text-muted hover:text-fg'
        }`}
      >
        <span>Presets</span>
        <span id="pk-portal-active-dot" class="hidden h-1.5 w-1.5 rounded-full bg-accent"></span>
      </button>
    </div>
  </div>

  <!-- PANEL 1: Custom Pipeline Settings (Stages 1 through 5) -->
  <div id="pk-panel-custom" class={`mt-4 space-y-3.5 ${initialTool === 'passport' ? 'hidden' : ''}`}>
    <!-- Active preset banner in Custom view -->
    <div id="pk-custom-active-preset-banner" class="hidden rounded-xl border border-accent/30 bg-accent/10 p-2.5">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <span id="pk-banner-flag" class="shrink-0 text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <line x1="7" y1="8" x2="17" y2="8"></line>
              <line x1="7" y1="12" x2="17" y2="12"></line>
            </svg>
          </span>
          <div class="min-w-0">
            <div class="text-xs font-bold text-fg flex items-center gap-1.5">
              <span id="pk-banner-name">Preset Active</span>
              <span class="text-[9px] uppercase font-mono px-1.5 py-0.2 rounded bg-accent text-accent-fg font-extrabold">APPLIED</span>
            </div>
            <p id="pk-banner-details" class="text-[11px] text-muted truncate">Specs applied to all cards</p>
          </div>
        </div>
        <button type="button" id="pk-banner-reset" class="text-xs font-semibold text-accent hover:underline shrink-0 cursor-pointer">
          Reset
        </button>
      </div>
    </div>

    <!-- Active Photo Bar (Visible ONLY when a specific photo is selected) -->
    <div id="pk-active-photo-bar" class="hidden flex-col gap-2 rounded-xl border border-accent/30 bg-accent/5 p-3 text-xs shadow-sm transition-all mb-3.5">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <span class="inline-block h-2 w-2 rounded-full bg-accent animate-pulse shrink-0"></span>
          <span class="text-xs font-semibold text-fg truncate max-w-[140px] sm:max-w-[180px]" id="pk-active-photo-name">filename.jpg</span>
          <span id="pk-active-photo-counter" class="text-[10px] font-mono text-accent font-semibold px-1.5 py-0.5 rounded bg-accent/15 border border-accent/20 shrink-0">1 of 4</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button
            type="button"
            id="pk-target-prev-btn"
            class="h-6 w-6 inline-flex items-center justify-center rounded-md text-muted hover:text-fg hover:bg-surface border border-border/60 transition-colors disabled:opacity-20 cursor-pointer"
            title="Previous photo"
            aria-label="Previous photo"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            id="pk-target-next-btn"
            class="h-6 w-6 inline-flex items-center justify-center rounded-md text-muted hover:text-fg hover:bg-surface border border-border/60 transition-colors disabled:opacity-20 cursor-pointer"
            title="Next photo"
            aria-label="Next photo"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            id="pk-deselect-photo-btn"
            class="h-6 px-2 inline-flex items-center gap-1 rounded-md bg-surface text-[11px] font-semibold text-fg hover:bg-surface/80 border border-border transition-colors cursor-pointer shadow-2xs"
            title="Deselect photo and return to all photos"
          >
            <span>Done</span>
            <span class="text-[10px] text-muted">✕</span>
          </button>
        </div>
      </div>
      <div class="pt-2 border-t border-accent/15 flex items-center justify-between text-[11px]">
        <span class="text-muted flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          Editing this photo only
        </span>
        <button
          type="button"
          id="pk-apply-to-all-btn"
          class="inline-flex items-center gap-1 font-semibold text-accent hover:underline cursor-pointer transition-colors"
          title="Apply this photo's crop and resize to all photos in the queue"
        >
          <span>Apply to All Photos</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- ALL-IN-ONE PIPELINE STAGES (1. Format, 2. Compress, 3. Crop, 4. Resize) -->
    <div id="pk-stages-list" class="space-y-3.5 flex flex-col">
<!-- STAGE 1: 🔄 Output Format -->
    <div
      id="pk-stage-format"
      class={`rounded-xl border transition-all p-3 space-y-2.5 ${
        initialTool === 'convert' || (initialTool === 'compress' && isFormatPairDifferent)
          ? 'border-accent bg-accent/5 shadow-xs ring-1 ring-accent/20'
          : 'border-border bg-surface/40'
      } ${['crop', 'resize', 'dpi'].includes(initialTool) || (initialTool === 'compress' && !isFormatPairDifferent) ? 'hidden' : ''}`}
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-fg flex items-center gap-2">
          <span id="pk-dot-format" class={`pk-stage-dot inline-block h-2 w-2 rounded-full transition-all shrink-0 ${initialTool === 'convert' ? 'bg-accent ring-2 ring-accent/25' : 'border-2 border-border/90 bg-surface'}`}></span>
          <span>Output Format</span>
        </span>
        <span class="text-[11px] text-muted">Input: <span id="pk-detected-input-badge" class="font-mono uppercase text-fg font-semibold">{from}</span></span>
      </div>

      <!-- Hidden standard select for form / worker / test compatibility -->
      <select id="pk-output-format" class="sr-only" tabindex="-1" aria-hidden="true">
        {OUTPUT_FORMATS.map((fmt) => (
          <option value={fmt.value} selected={fmt.value === normalizedTo} data-mime={fmt.mime}>
            {fmt.label}
          </option>
        ))}
      </select>

      <!-- Custom High-End Trigger Button -->
      <div class="relative" id="pk-output-format-wrapper">
        <button
          type="button"
          id="pk-custom-format-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="group/trigger relative flex w-full items-center justify-between rounded-xl border border-border bg-surface px-3 py-2 text-left text-xs text-fg shadow-xs transition-all hover:border-accent/50 hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent cursor-pointer"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span
              id="pk-selected-format-badge"
              class="inline-flex items-center justify-center rounded-md font-mono text-[10px] font-bold px-1.5 py-0.5 bg-accent/15 text-accent border border-accent/25 shrink-0 uppercase"
            >
              {activeFmt.badge}
            </span>
            <div class="min-w-0 flex-1">
              <span id="pk-selected-format-title" class="block font-semibold text-fg text-xs truncate">
                {activeFmt.label}
              </span>
              <span id="pk-selected-format-desc" class="block text-[10px] text-muted truncate">
                {activeFmt.desc}
              </span>
            </div>
          </div>
          <svg
            id="pk-custom-format-chevron"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-muted group-hover/trigger:text-fg transition-transform duration-200 shrink-0 ml-1.5"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Custom Dropdown Popover Menu -->
        <div
          id="pk-custom-format-menu"
          role="listbox"
          tabindex="-1"
          class="absolute left-0 right-0 top-full mt-1 z-50 hidden rounded-2xl border border-border bg-surface/98 backdrop-blur-xl shadow-2xl p-1.5 space-y-1 transition-all max-h-[50vh] sm:max-h-72 overflow-y-auto touch-pan-y"
        >
          <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-muted">Select Output Format</div>
          {OUTPUT_FORMATS.map((fmt) => (
            <button
              type="button"
              role="option"
              data-value={fmt.value}
              data-badge={fmt.badge}
              data-title={fmt.label}
              data-desc={fmt.desc}
              aria-selected={fmt.value === normalizedTo}
              class={`pk-custom-format-option w-full flex items-center justify-between rounded-xl px-2.5 py-1.5 text-left transition-all cursor-pointer group ${
                fmt.value === normalizedTo ? 'bg-accent/10 border border-accent/30' : 'hover:bg-bg/80 border border-transparent'
              }`}
            >
              <div class="flex items-center gap-2 min-w-0">
                <span class="inline-flex items-center justify-center rounded-md font-mono text-[10px] font-bold px-1.5 py-0.5 bg-surface border border-border text-fg group-hover:border-accent/40 group-hover:text-accent shrink-0 uppercase">
                  {fmt.badge}
                </span>
                <div class="min-w-0">
                  <span class="block text-xs font-semibold text-fg group-hover:text-accent transition-colors">
                    {fmt.label}
                  </span>
                  <span class="block text-[10px] text-muted">
                    {fmt.desc}
                  </span>
                </div>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={`pk-option-check text-accent shrink-0 ml-2 ${fmt.value === normalizedTo ? '' : 'hidden'}`}
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          ))}
        </div>
      </div>

      <!-- Image to PDF Options Suite -->
      <div
        id="pk-pdf-options-container"
        class={`rounded-xl border border-accent/30 bg-accent/[0.03] p-3 space-y-3 ${normalizedTo === 'pdf' ? '' : 'hidden'}`}
      >
        <div class="flex items-center justify-between border-b border-border/40 pb-2">
          <span class="flex items-center gap-1.5 text-xs font-semibold text-fg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            PDF Page Options
          </span>
