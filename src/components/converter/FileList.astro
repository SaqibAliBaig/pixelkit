---
// Static shell for the file list and actions.
// Items are dynamically injected and updated by ConverterApp island.
---

<div id="pk-file-list" class="space-y-3" aria-live="polite" aria-label="Files">
  <!-- Empty state -->
  <p
    id="pk-empty-state"
    class="rounded-xl border border-border bg-bg/40 px-4 py-8 text-center text-sm text-muted"
  >
    No files selected yet. Drag & drop photos, documents or click browse above.
  </p>

  <!-- Items rendered by JS -->
  <template id="pk-file-item-template">
    <div
      class="pk-file-item group relative rounded-xl border border-border bg-surface/90 p-3.5 sm:p-4 transition-all hover:border-accent/40 shadow-sm min-w-0 w-full overflow-hidden"
      draggable="true"
    >
      <!-- Top Row: Drag Handle + Thumbnail + File Information + Status & Remove -->
      <div class="flex items-start gap-3 sm:gap-3.5 min-w-0 w-full">
        <!-- Drag Handle for Reordering (especially for Multi-page PDF) -->
        <div
          class="pk-drag-handle hidden sm:flex items-center justify-center self-center text-muted/60 hover:text-fg cursor-grab active:cursor-grabbing p-1 -ml-1 rounded transition-colors shrink-0"
          title="Drag to reorder page sequence"
          aria-label="Drag to reorder"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <circle cx="9" cy="5" r="1.5"/>
            <circle cx="15" cy="5" r="1.5"/>
            <circle cx="9" cy="12" r="1.5"/>
            <circle cx="15" cy="12" r="1.5"/>
            <circle cx="9" cy="19" r="1.5"/>
            <circle cx="15" cy="19" r="1.5"/>
          </svg>
        </div>

        <!-- Thumbnail button with inspect/compare hint -->
        <button
          type="button"
          class="pk-file-thumb-btn group/thumb relative h-14 w-14 sm:h-16 sm:w-16 shrink-0 overflow-hidden rounded-lg border border-border bg-bg flex items-center justify-center cursor-pointer hover:border-accent transition-colors"
          title="Click to inspect in fullscreen / compare"
        >
          <img
            class="pk-file-img-preview h-full w-full object-cover hidden transition-transform group-hover/thumb:scale-105"
            loading="lazy"
            decoding="async"
            alt="Thumbnail"
          />
          <div class="pk-file-thumb-badge flex h-full w-full items-center justify-center text-xs font-bold text-muted bg-surface/90">
            <!-- Extension badge -->
          </div>
          <div class="pk-file-thumb-overlay absolute inset-0 bg-accent/20 opacity-0 group-hover/thumb:opacity-100 flex items-center justify-center transition-opacity pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-fg drop-shadow">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
            </svg>
          </div>
        </button>

        <!-- File details and Before/After stats -->
        <div class="min-w-0 flex-1 overflow-hidden">
          <!-- Top line: Filename & Status / Remove -->
          <div class="flex items-start justify-between gap-2 min-w-0 w-full">
            <div class="flex items-start gap-1.5 min-w-0 flex-1 overflow-hidden">
              <span class="pk-page-order-badge hidden text-[10px] font-bold text-accent font-mono bg-accent/10 px-1.5 py-0.5 rounded shrink-0 mt-0.5">#1</span>
              <p class="pk-file-name text-sm font-semibold text-fg break-all line-clamp-2 leading-snug min-w-0" title=""></p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 ml-2">
              <span class="pk-file-status-badge text-[11px] font-medium px-2 py-0.5 rounded-full bg-surface border border-border text-muted shrink-0">
                Queued
              </span>
              <button
                type="button"
                class="pk-file-remove-btn inline-flex items-center justify-center h-6 w-6 rounded-md text-muted hover:text-fg hover:bg-surface border border-transparent hover:border-border transition-colors cursor-pointer shrink-0"
                title="Remove file"
                aria-label="Remove file"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Before -> After stats banner -->
          <div class="pk-file-comparison mt-1.5 flex flex-wrap items-center gap-2 text-xs min-w-0">
            <span class="pk-file-orig-size font-medium text-muted">--</span>
            <span class="pk-file-arrow text-accent font-bold hidden">➔</span>
            <span class="pk-file-result-size font-bold text-fg hidden">--</span>
            <span class="pk-file-saved-badge hidden rounded-md px-2 py-0.5 text-[11px] font-bold">
              --
            </span>
          </div>

          <!-- Secondary metadata / dimensions or errors (only when resized or error) -->
          <p class="pk-file-meta mt-1 text-[11px] text-muted break-words min-w-0 hidden"></p>
          <!-- Live Pre-conversion predicted dimensions -->
          <p class="pk-file-live-dims mt-0.5 text-[11px] font-mono text-accent font-semibold break-words min-w-0 hidden"></p>
        </div>
      </div>

      <!-- Card Footer: Quick Adjustment Tools on left, Action Buttons (Compare, Copy, Download) on right -->
      <div class="pk-card-footer mt-3 pt-2.5 border-t border-border/50 flex flex-wrap items-center justify-between gap-2 min-w-0 w-full">
        <!-- Card Edit Controls (Collapsed by default, toggleable via Edit button) -->
        <div class="flex items-center gap-1.5 flex-wrap">
          <button
            type="button"
            class="pk-tool-edit-toggle inline-flex h-7 items-center gap-1.5 px-2.5 rounded-lg text-xs font-semibold text-muted hover:text-accent hover:bg-accent/10 border border-border/60 transition-colors cursor-pointer"
            title="Edit image (Crop, Resize, Rotate, Flip, B&W)"
            aria-label="Edit image adjustments"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            <span>Edit</span>
          </button>

          <!-- Per-file Quick Adjustment Toolbar (Hidden by default unless Edit is toggled or adjustments exist) -->
          <div class="pk-file-tools hidden flex items-center gap-1 flex-wrap">
            <button
              type="button"
              class="pk-tool-crop inline-flex h-7 items-center gap-1 px-2 rounded-lg text-xs font-semibold text-muted hover:text-accent hover:bg-accent/10 border border-border/60 transition-colors cursor-pointer"
              title="Interactive Quick-Crop & Framing"
              aria-label="Interactive Crop"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
                <path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
              </svg>
              <span class="text-[11px]">Crop</span>
            </button>
            <button
              type="button"
              class="pk-tool-resize inline-flex h-7 items-center gap-1 px-2 rounded-lg text-xs font-semibold text-muted hover:text-accent hover:bg-accent/10 border border-border/60 transition-colors cursor-pointer"
              title="Interactive Resize & Scale Studio"
              aria-label="Interactive Resize"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
              <span class="text-[11px]">Resize</span>
            </button>
            <button
              type="button"
              class="pk-tool-rotate-ccw inline-flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:text-fg hover:bg-surface border border-border/60 transition-colors cursor-pointer"
              title="Rotate 90° Left (↺)"
              aria-label="Rotate left"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
              </svg>
            </button>
            <button
              type="button"
              class="pk-tool-rotate-cw inline-flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:text-fg hover:bg-surface border border-border/60 transition-colors cursor-pointer"
              title="Rotate 90° Right (↻)"
              aria-label="Rotate right"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                <path d="M21 3v5h-5"/>
              </svg>
            </button>
            <button
              type="button"
              class="pk-tool-flip-h inline-flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:text-fg hover:bg-surface border border-border/60 transition-colors cursor-pointer"
              title="Flip Horizontal (⇄)"
              aria-label="Flip horizontal"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 7 5 5-5 5V7zM21 7l-5 5 5 5V7zM12 20v2M12 14v2M12 8v2M12 2v2"/>
              </svg>
            </button>
            <button
              type="button"
              class="pk-tool-grayscale inline-flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:text-fg hover:bg-surface border border-border/60 transition-colors cursor-pointer"
              title="Toggle B&W Grayscale"
              aria-label="Toggle Grayscale"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/>
                <path d="M12 4a8 8 0 0 0 0 16z"/>
              </svg>
            </button>
            <button
              type="button"
              class="pk-tool-reset-all inline-flex h-7 items-center gap-1 px-2 rounded-lg text-[11px] font-semibold text-muted hover:text-danger hover:bg-danger/10 border border-border/60 transition-colors cursor-pointer"
              title="Reset all adjustments for this image back to original"
              aria-label="Reset this image adjustments to original"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
              </svg>
              <span>Reset</span>
            </button>
          </div>
          <span class="pk-transform-badge text-[10px] text-accent font-mono hidden ml-1 font-medium"></span>
        </div>

        <!-- Per-file action buttons (Compare, Copy, Download) -->
        <div class="pk-file-actions flex items-center gap-1.5 ml-auto">
          <!-- Injected dynamically -->
        </div>
      </div>
    </div>
  </template>
</div>

<div class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3" id="pk-actions">
  <button
    id="pk-convert-btn"
    type="button"
    disabled
    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 sm:py-2.5 text-sm font-semibold text-accent-fg disabled:opacity-50 disabled:pointer-events-none hover:opacity-95 shadow-md shadow-accent/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 transition-all cursor-pointer"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
      <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>
    <span>Convert & Compress Now</span>
  </button>

  <button
    id="pk-clear-btn"
    type="button"
    disabled
    class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-surface px-4 py-3 sm:py-2.5 text-sm font-medium text-fg disabled:opacity-50 disabled:pointer-events-none hover:bg-surface/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-all cursor-pointer"
  >
    Clear
  </button>

  <button
    id="pk-download-all-btn"
    type="button"
    disabled
    class="hidden w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-accent/40 bg-accent/10 px-4 py-3 sm:py-2.5 text-sm font-semibold text-accent disabled:opacity-50 disabled:pointer-events-none hover:bg-accent/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-all cursor-pointer shadow-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    <span>Download All (.zip)</span>
  </button>
</div>