---
// Interactive Resize & Scale Studio Modal for PixelKit — Fully responsive for Mobile & Desktop.
// Desktop: Side-by-side Live Stage & Controls.
// Mobile: Full-screen enlarged studio with spacious preview stage, unobstructed image, and untruncated detail stats.
---

<div
  id="pk-resize-modal"
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-0 sm:p-4 md:p-6 bg-black/85 backdrop-blur-sm transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pk-resize-modal-title"
>
  <div
    class="relative w-full max-w-5xl h-full sm:h-[92vh] max-h-none sm:max-h-[860px] flex flex-col rounded-none sm:rounded-2xl border-0 sm:border border-border bg-surface text-fg shadow-2xl overflow-hidden"
  >
    <!-- Header (Pinned) -->
    <header class="flex items-center justify-between border-b border-border bg-surface px-3.5 py-2.5 sm:px-6 sm:py-3 shrink-0">
      <div class="min-w-0 flex-1 pr-2">
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-accent/10 text-accent shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 3 21 3 21 9"></polyline>
              <polyline points="9 21 3 21 3 15"></polyline>
              <line x1="21" y1="3" x2="14" y2="10"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
          </div>
          <div id="pk-resize-modal-title" role="heading" aria-level="3" class="truncate text-sm sm:text-base font-semibold text-fg">
            Resize & Scale Studio
          </div>
          <span
            id="pk-resize-badge"
            class="rounded-full bg-accent/15 px-2 py-0.5 text-[11px] font-bold text-accent border border-accent/30 shrink-0 font-mono"
          >
            100%
          </span>
        </div>
        <p id="pk-resize-filename" class="mt-0.5 text-[11px] sm:text-xs text-muted truncate">
          Adjust output resolution and preview target size before converting
        </p>
      </div>

      <!-- Multi-photo Stepper (visible when multiple images are loaded) -->
      <div id="pk-resize-modal-stepper" class="hidden items-center gap-1.5 px-2 py-1 rounded-lg bg-bg border border-border text-xs shrink-0 mr-2">
        <button
          type="button"
          id="pk-resize-modal-prev-btn"
          class="p-1 rounded text-muted hover:text-fg hover:bg-surface disabled:opacity-30 cursor-pointer transition-colors"
          title="Previous photo"
          aria-label="Previous photo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <span id="pk-resize-modal-counter" class="font-mono text-[11px] font-bold text-fg px-1">1 / 3</span>
        <button
          type="button"
          id="pk-resize-modal-next-btn"
          class="p-1 rounded text-muted hover:text-fg hover:bg-surface disabled:opacity-30 cursor-pointer transition-colors"
          title="Next photo"
          aria-label="Next photo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Close Button with comfortable touch target -->
      <button
        id="pk-resize-close-btn"
        type="button"
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted hover:text-fg hover:bg-bg border border-border/60 transition-colors cursor-pointer shrink-0"
        title="Close (Esc)"
        aria-label="Close"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Main Studio Split View (Desktop = Side-by-Side, Mobile = Stacked with enlarged top stage) -->
    <div class="flex-1 min-h-0 flex flex-col md:flex-row overflow-hidden">
      <!-- Left Column: Visual Interactive Preview Stage & Stats -->
      <div class="flex flex-col md:w-[55%] lg:w-[58%] border-b md:border-b-0 md:border-r border-border bg-black/95 relative shrink-0 md:shrink">
        <!-- Live Preview Stage (Enlarged for clear mobile preview) -->
        <div
          class="relative h-[195px] sm:h-[240px] md:h-auto md:flex-1 overflow-hidden flex items-center justify-center p-3 sm:p-6 select-none cursor-default"
          style="background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 20px 20px;"
        >
          <!-- Outer Original Bounding Envelope (represents 100% natural resolution) -->
          <div
            id="pk-resize-envelope"
            class="relative inline-flex items-center justify-center max-h-[175px] sm:max-h-[220px] md:max-h-[56vh] max-w-full select-none"
          >
            <!-- Ghost reference image: provides exact aspect ratio & 100% boundary up to max stage -->
            <img
              id="pk-resize-ghost-img"
              class="block max-h-[175px] sm:max-h-[220px] md:max-h-[56vh] max-w-full w-auto h-auto pointer-events-none rounded select-none opacity-20 filter grayscale"
              width="1"
              height="1"
              alt=""
              aria-hidden="true"
            />

            <!-- Faint reference border representing 100% canvas bounds -->
            <div
              id="pk-resize-orig-frame"
              class="absolute inset-0 rounded-xl border-2 border-dashed border-white/30 pointer-events-none flex items-start justify-end p-1.5 select-none"
            >
              <span class="rounded bg-black/75 backdrop-blur px-1.5 py-0.5 text-[9px] sm:text-[10px] font-mono text-white/70 border border-white/15">
                100% Canvas
              </span>
            </div>

            <!-- Dynamic Scaled Preview Box: visibly shrinks/expands in real time, NO dark wash blocking image -->
            <div
              id="pk-resize-preview-box"
              class="absolute inset-0 m-auto rounded-lg overflow-hidden shadow-2xl border-2 border-accent transition-colors duration-100 ease-out flex items-center justify-center will-change-[width,height]"
              style="width: 100%; height: 100%;"
            >
              <img
                id="pk-resize-img-preview"
                class="w-full h-full object-contain pointer-events-none rounded select-none"
                width="1"
                height="1"
                alt=""
                aria-hidden="true"
              />

              <!-- Attached Live Dimensions Tag: HIDDEN so it NEVER blocks the picture -->
              <div
                id="pk-resize-live-badge"
                class="hidden"
              >
              </div>
            </div>
          </div>
        </div>

        <!-- Live Dimension Stats Banner (Structured to NEVER truncate dimensions or hide details) -->
        <div class="border-t border-border bg-bg/90 px-4 py-2 sm:px-4 sm:py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-2 shrink-0 text-xs">
          <div class="flex items-center gap-1.5 sm:gap-2 text-xs flex-wrap">
            <span class="text-muted font-medium text-[11px] sm:text-xs">Original:</span>
            <span id="pk-resize-src-dims" class="font-mono text-fg font-semibold text-[11px] sm:text-xs whitespace-nowrap">-- × -- px</span>
            <span class="text-accent font-bold text-xs">➔</span>
            <span class="text-muted font-medium text-[11px] sm:text-xs">Target:</span>
            <span id="pk-resize-target-dims" class="font-mono text-accent font-bold text-[11px] sm:text-xs whitespace-nowrap">-- × -- px</span>
          </div>
          <div id="pk-resize-savings-tag" class="text-success font-semibold flex items-center gap-1 font-mono text-[11px] sm:text-xs shrink-0">
            100% natural resolution
          </div>
        </div>
      </div>

      <!-- Right Column: Scrollable Controls Panel -->
      <div class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-5 space-y-3.5 sm:space-y-4 bg-surface text-fg text-xs md:w-[45%] lg:w-[42%]">
        <!-- 1. Scale Percent Buttons & Slider -->
        <div class="rounded-xl border border-border bg-bg/40 p-3 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-fg flex items-center gap-1.5">
              <span>Scale Resolution</span>
              <span class="text-muted font-normal text-[11px]">· Proportional</span>
            </span>
            <span id="pk-modal-scale-val" class="font-mono font-bold text-accent text-sm">100%</span>
          </div>

          <div class="grid grid-cols-5 gap-1 sm:gap-1.5 p-1 rounded-xl border border-border bg-surface text-center font-medium">
            <button type="button" class="pk-modal-scale-btn py-1.5 rounded-lg border border-accent/40 bg-accent/10 text-accent font-semibold cursor-pointer transition-all text-xs" data-scale="100">100%</button>
            <button type="button" class="pk-modal-scale-btn py-1.5 rounded-lg border border-transparent hover:border-border text-muted hover:text-fg cursor-pointer transition-all text-xs" data-scale="75">75%</button>
            <button type="button" class="pk-modal-scale-btn py-1.5 rounded-lg border border-transparent hover:border-border text-muted hover:text-fg cursor-pointer transition-all text-xs" data-scale="50">50%</button>
            <button type="button" class="pk-modal-scale-btn py-1.5 rounded-lg border border-transparent hover:border-border text-muted hover:text-fg cursor-pointer transition-all text-xs" data-scale="25">25%</button>
            <button type="button" class="pk-modal-scale-btn py-1.5 rounded-lg border border-transparent hover:border-border text-muted hover:text-fg cursor-pointer transition-all text-xs" data-scale="custom">Custom</button>
          </div>

          <!-- Smooth Scale Slider -->
          <div class="flex items-center gap-2.5 pt-0.5">
            <span class="text-muted text-[11px] font-mono shrink-0">10%</span>
            <input
              id="pk-modal-scale-slider"
              type="range"
              min="10"
              max="100"
              step="5"
              value="100"
              class="flex-1 accent-accent h-2 bg-border rounded-lg cursor-pointer"
            />
            <span class="text-muted text-[11px] font-mono shrink-0">100%</span>
          </div>
        </div>

        <!-- 2. Standard Output Presets -->
        <div class="rounded-xl border border-border bg-bg/40 p-3 space-y-2">
          <span class="block font-semibold text-fg">
            Standard Output Presets
          </span>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer" data-preset="passport" data-w="413" data-h="531">
              <span class="block font-semibold text-xs truncate">Passport ID</span>
              <span class="block text-[10px] text-muted font-mono">413 × 531 px</span>
            </button>
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer" data-preset="square" data-w="600" data-h="600">
              <span class="block font-semibold text-xs truncate">Square Avatar</span>
              <span class="block text-[10px] text-muted font-mono">600 × 600 px</span>
            </button>
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer" data-preset="exam" data-w="350" data-h="450">
              <span class="block font-semibold text-xs truncate">🎓 Exam / UPSC</span>
              <span class="block text-[10px] text-muted truncate">350 × 450 px</span>
            </button>
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer" data-preset="sign" data-w="280" data-h="140">
              <span class="block font-semibold text-xs truncate">✍️ Signature</span>
              <span class="block text-[10px] text-muted truncate">280 × 140 px (2:1)</span>
            </button>
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer" data-preset="canada" data-w="420" data-h="540">
              <span class="block font-semibold text-xs truncate">🇨🇦 Canada PR</span>
              <span class="block text-[10px] text-muted truncate">420 × 540 px</span>
            </button>
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer" data-preset="webhd" data-w="1920" data-h="1080">
              <span class="block font-semibold text-xs truncate">Web HD</span>
              <span class="block text-[10px] text-muted font-mono">1920 × 1080 px</span>
            </button>
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer" data-preset="social" data-w="1080" data-h="1080">
              <span class="block font-semibold text-xs truncate">Instagram Post</span>
              <span class="block text-[10px] text-muted font-mono">1080 × 1080 px</span>
            </button>
            <button type="button" class="pk-modal-dim-preset p-2 rounded-lg border border-border bg-surface text-fg hover:border-accent/40 transition-colors text-left cursor-pointer col-span-2 sm:col-span-1" data-preset="story" data-w="1080" data-h="1920">
              <span class="block font-semibold text-xs truncate">Mobile / Story</span>
              <span class="block text-[10px] text-muted font-mono">1080 × 1920 px</span>
            </button>
          </div>
        </div>

        <!-- 3. Exact Dimensions (px / cm / mm / in + DPI) with Aspect Lock -->
        <div class="rounded-xl border border-border bg-bg/40 p-3 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span class="font-semibold text-fg">Exact Dimensions</span>
            <button
              id="pk-modal-lock-btn"
              type="button"
              class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-semibold text-accent bg-accent/10 border border-accent/30 hover:bg-accent/20 transition-colors cursor-pointer"
              title="Lock Aspect Ratio"
            >
              <span id="pk-modal-lock-icon">🔒</span>
              <span id="pk-modal-lock-label">Locked</span>
            </button>
          </div>

          <div class="flex items-center justify-between gap-2">
            <div class="flex rounded-lg border border-border bg-surface p-0.5 text-[11px]" role="group" aria-label="Dimension unit">
              <button type="button" class="pk-modal-unit-btn rounded-md px-2.5 py-1 font-semibold bg-accent/15 text-accent cursor-pointer" data-unit="px">PX</button>
              <button type="button" class="pk-modal-unit-btn rounded-md px-2.5 py-1 font-medium text-muted hover:text-fg cursor-pointer" data-unit="cm">CM</button>
              <button type="button" class="pk-modal-unit-btn rounded-md px-2.5 py-1 font-medium text-muted hover:text-fg cursor-pointer" data-unit="mm">MM</button>
              <button type="button" class="pk-modal-unit-btn rounded-md px-2.5 py-1 font-medium text-muted hover:text-fg cursor-pointer" data-unit="in">IN</button>
            </div>
            <label class="flex items-center gap-1.5 text-[11px] text-muted">
              <span class="font-semibold">Print DPI:</span>
              <select
                id="pk-modal-dpi"
                aria-label="Print DPI resolution"
                class="rounded-lg border border-border bg-surface px-2 py-1 text-[11px] font-mono font-semibold text-fg focus:border-accent focus:outline-none cursor-pointer"
              >
                <option value="72">72</option>
                <option value="96">96</option>
                <option value="150">150</option>
                <option value="200">200</option>
                <option value="300" selected>300</option>
                <option value="600">600</option>
              </select>
            </label>
          </div>

          <div class="flex items-center gap-2">
            <div class="flex-1">
              <span id="pk-modal-w-label" class="block text-[10px] text-muted mb-0.5">Width (px)</span>
              <input
                id="pk-modal-dim-w"
                type="number"
                min="0.1"
                max="16000"
                step="any"
                placeholder="e.g. 1920"
                aria-label="Width dimension"
                class="w-full rounded-lg border border-border bg-surface px-2.5 py-1.5 text-xs font-mono text-fg focus:border-accent focus:outline-none"
              />
            </div>
            <span class="text-muted font-bold mt-3">×</span>
            <div class="flex-1">
              <span id="pk-modal-h-label" class="block text-[10px] text-muted mb-0.5">Height (px)</span>
              <input
                id="pk-modal-dim-h"
                type="number"
                min="0.1"
                max="16000"
                step="any"
                placeholder="e.g. 1080"
                aria-label="Height dimension"
                class="w-full rounded-lg border border-border bg-surface px-2.5 py-1.5 text-xs font-mono text-fg focus:border-accent focus:outline-none"
              />
            </div>
          </div>

          <p id="pk-modal-computed-px" class="hidden text-[11px] font-mono text-accent font-medium"></p>
        </div>

        <!-- 4. Fit Strategy & Guardrail -->
        <div class="rounded-xl border border-border bg-bg/40 p-3 space-y-2.5">
          <div>
            <span class="block font-semibold text-fg mb-1">Fit Strategy</span>
            <div class="flex rounded-lg border border-border bg-surface p-0.5">
              <button type="button" class="pk-modal-fit-btn flex-1 rounded-md py-1.5 text-[11px] font-medium bg-bg text-fg shadow-sm cursor-pointer" data-fit="contain">Fit Within</button>
              <button type="button" class="pk-modal-fit-btn flex-1 rounded-md py-1.5 text-[11px] font-medium text-muted hover:text-fg cursor-pointer" data-fit="cover">Crop to Fill</button>
              <button type="button" class="pk-modal-fit-btn flex-1 rounded-md py-1.5 text-[11px] font-medium text-muted hover:text-fg cursor-pointer" data-fit="fill">Exact Fill</button>
            </div>
          </div>

          <div class="flex items-center gap-2 text-muted hover:text-fg cursor-pointer select-none text-[11px] pt-0.5" onclick="document.getElementById('pk-modal-no-upscale')?.click()">
            <input
              id="pk-modal-no-upscale"
              type="checkbox"
              checked
              aria-label="Do not upscale if original is smaller"
              class="rounded border-border accent-accent h-4 w-4 cursor-pointer"
            />
            <span>Do not upscale if original is smaller</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer: Actions (Enlarged and touch-friendly for mobile) -->
    <footer class="border-t border-border bg-surface px-4 py-2.5 sm:px-6 sm:py-3 shrink-0 z-10 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 sm:gap-4">
      <div class="grid grid-cols-2 sm:flex items-center gap-2">
        <button
          id="pk-resize-reset-btn"
          type="button"
          class="rounded-xl px-3 py-2 text-xs font-medium text-muted hover:text-fg hover:bg-bg border border-border transition-colors cursor-pointer text-center"
        >
          Reset to 100%
        </button>
        <button
          id="pk-resize-cancel-btn"
          type="button"
          class="rounded-xl px-3 py-2 text-xs font-medium text-muted hover:text-fg hover:bg-bg border border-border transition-colors cursor-pointer text-center"
        >
          Cancel
        </button>
      </div>

      <button
        id="pk-resize-apply-btn"
        type="button"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl bg-accent px-5 py-2.5 text-xs font-semibold text-accent-fg hover:opacity-90 shadow transition-opacity cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Apply Resize & Scale</span>
      </button>
    </footer>
  </div>
</div>
