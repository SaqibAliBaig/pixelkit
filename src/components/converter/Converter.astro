---
/**
 * Root of the tool. Renders the static shell (drop zone, settings, file list,
 * privacy note) as SSR HTML so LCP is fast and the tool is usable even
 * before the JS island boots. The island attaches to #pk-converter-root.
 */
import DropZone from '@components/converter/DropZone.astro';
import FileList from '@components/converter/FileList.astro';
import SettingsPanel from '@components/converter/SettingsPanel.astro';
import ProgressBar from '@components/converter/ProgressBar.astro';
import PrivacyNote from '@components/converter/PrivacyNote.astro';
import CompareModal from '@components/converter/CompareModal.astro';
import CropModal from '@components/converter/CropModal.astro';
import ResizeModal from '@components/converter/ResizeModal.astro';

interface Props {
  from: string;
  to: string;
  fromMime: string;
  toMime: string;
  targetKb: number | null;
  initialTool?: 'all' | 'compress' | 'convert' | 'resize' | 'crop' | 'passport';
  preset?: string;
}

const { from, to, fromMime, toMime, targetKb, initialTool = 'all', preset } = Astro.props;

// Universal accept: all supported image formats + PDF
const accept = '.jpg,.jpeg,.png,.webp,.heic,.heif,.avif,.gif,.bmp,.svg,.tif,.tiff,.pdf';
---

<section
  id="pk-converter-root"
  class="rounded-2xl sm:rounded-3xl border border-border/80 bg-surface p-3.5 sm:p-6 overflow-hidden max-w-full shadow-sm"
  data-from={from}
  data-to={to}
  data-from-mime={fromMime}
  data-to-mime={toMime}
  data-target-kb={targetKb ?? ''}
  data-initial-tool={initialTool}
  data-preset={preset ?? ''}
  aria-label="File converter"
>
  <!-- Top Mode Segmented Switcher: All-in-One · Convert · Compress · Crop · Resize · Passport -->
  <div class="mb-4 sm:mb-5 flex items-center justify-between gap-2 border-b border-border/60 pb-3 sm:pb-3.5 overflow-hidden">
    <div
      id="pk-top-mode-bar"
      class="flex items-center gap-1 p-1 rounded-xl bg-surface/80 border border-border text-xs font-semibold overflow-x-auto w-full sm:w-auto max-w-full scrollbar-none shadow-2xs touch-pan-x overscroll-contain"
      style="-webkit-overflow-scrolling: touch;"
      role="tablist"
      aria-label="Processing Mode"
    >
      <a
        href="/"
        data-mode="all"
        class={`pk-mode-tab shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium touch-manipulation ${
          initialTool === 'all' ? 'bg-surface text-fg shadow-xs border border-border/50 font-semibold' : 'text-muted hover:text-fg'
        }`}
      >
        All-in-One
      </a>
      <a
        href="/convert/"
        data-mode="convert"
        class={`pk-mode-tab shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium touch-manipulation ${
          initialTool === 'convert' ? 'bg-surface text-fg shadow-xs border border-border/50 font-semibold' : 'text-muted hover:text-fg'
        }`}
      >
        Convert
      </a>
      <a
        href="/compress-image/"
        data-mode="compress"
        class={`pk-mode-tab shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium touch-manipulation ${
          initialTool === 'compress' ? 'bg-surface text-fg shadow-xs border border-border/50 font-semibold' : 'text-muted hover:text-fg'
        }`}
      >
        Compress
      </a>
      <a
        href="/crop-image/"
        data-mode="crop"
        class={`pk-mode-tab shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium touch-manipulation ${
          initialTool === 'crop' ? 'bg-surface text-fg shadow-xs border border-border/50 font-semibold' : 'text-muted hover:text-fg'
        }`}
      >
        Crop
      </a>
      <a
        href="/resize-image/"
        data-mode="resize"
        class={`pk-mode-tab shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium touch-manipulation ${
          initialTool === 'resize' ? 'bg-surface text-fg shadow-xs border border-border/50 font-semibold' : 'text-muted hover:text-fg'
        }`}
      >
        Resize
      </a>
      <a
        href="/passport-photo-resizer/"
        data-mode="passport"
        class={`pk-mode-tab shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium touch-manipulation ${
          initialTool === 'passport' ? 'bg-surface text-fg shadow-xs border border-border/50 font-semibold' : 'text-muted hover:text-fg'
        }`}
      >
        Portal Presets
      </a>
    </div>

    <div class="hidden md:inline-flex items-center gap-1.5 text-[11px] text-muted shrink-0">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      <span>100% in-browser · Zero uploads</span>
    </div>
  </div>

  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px] items-start min-w-0">
    <div class="space-y-4 min-w-0 w-full">
      <DropZone accept={accept} from={from} to={to} initialTool={initialTool} />
      <ProgressBar />
      <FileList />
    </div>

    <aside class="space-y-4 min-w-0 w-full lg:w-[320px]">
      <SettingsPanel
        from={from}
        to={to}
        targetKb={targetKb}
        initialTool={initialTool}
      />
      <PrivacyNote />
    </aside>
  </div>

  <!-- Keyboard / a11y status line -->
  <p
    id="pk-status"
    role="status"
    aria-live="polite"
    class="mt-4 text-sm text-muted min-h-[1.25rem]"
  ></p>

  <!-- Interactive Modals (wrapped in <template> to keep SSR HTML lightweight and eliminate DOM bloat for search crawlers) -->
  <template id="pk-modals-template">
    <!-- Interactive Before/After Visual Comparison Modal -->
    <CompareModal />

    <!-- Interactive Quick-Crop & Framing Modal -->
    <CropModal />

    <!-- Interactive Resize & Scale Studio Modal -->
    <ResizeModal />
  </template>
</section>

<!-- The island: deferred until browser idle or user interaction for lightning-fast LCP and zero main-thread blocking. -->
<script>
  let isConverterBooted = false;
  function bootConverter() {
    if (isConverterBooted) return;
    isConverterBooted = true;

    ['pointerdown', 'touchstart', 'dragenter', 'keydown'].forEach((ev) => {
      window.removeEventListener(ev, onInteract, { capture: true });
    });

    import('./islands/ConverterApp').then(({ mountConverterApp }) => {
      mountConverterApp();
    });
  }

  function onInteract() {
    bootConverter();
  }

  ['pointerdown', 'touchstart', 'dragenter', 'keydown'].forEach((ev) => {
    window.addEventListener(ev, onInteract, { capture: true, once: true, passive: true });
  });

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(bootConverter, { timeout: 1500 });
  } else {
    setTimeout(bootConverter, 400);
  }
</script>
