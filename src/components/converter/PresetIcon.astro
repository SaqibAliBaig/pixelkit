---
interface Props {
  presetId: string;
  category?: string;
  countryCode?: string;
  class?: string;
}

const { presetId, category, countryCode, class: className = 'w-4 h-4' } = Astro.props;
---

{presetId === 'social-yt-thumb' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="#FF0000"/>
    <polygon points="9.5,7.5 16.5,12 9.5,16.5" fill="#FFFFFF"/>
  </svg>
)}

{presetId === 'social-linkedin-banner' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="#0A66C2"/>
    <path d="M7 10v7H4.5v-7H7zm-1.25-1.5c-.8 0-1.45-.65-1.45-1.45s.65-1.45 1.45-1.45 1.45.65 1.45 1.45-.65 1.45-1.45 1.45zM19.5 17h-2.5v-3.8c0-.9-.02-2.1-1.3-2.1-1.3 0-1.5 1-1.5 2v3.9h-2.5v-7h2.4v1h.03c.33-.6 1.15-1.2 2.3-1.2 2.45 0 2.9 1.6 2.9 3.7V17z" fill="#FFFFFF"/>
  </svg>
)}

{presetId === 'social-whatsapp-dp' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="#25D366"/>
    <path d="M12 4a8 8 0 00-6.9 12L4 20l4.2-1.1A8 8 0 1012 4zm4.5 11.2c-.2.5-1 .9-1.4 1-.4 0-.9.2-2.9-.6-2.4-1-3.9-3.4-4-3.5-.1-.2-1-1.3-1-2.5 0-1.2.6-1.8.9-2 .2-.2.5-.3.8-.3h.6c.2 0 .4 0 .5.4.2.5.7 1.7.7 1.8 0 .1 0 .3-.1.4-.1.1-.2.3-.3.4-.1.1-.2.2-.1.4.3.5.7 1 1.2 1.4.6.4 1.2.7 1.7.9.2.1.4.1.5-.1.1-.2.5-.6.7-.8.2-.2.3-.2.5-.1.2.1 1.3.6 1.5.7.2.1.4.2.4.3 0 .2 0 .9-.5 1.4z" fill="#FFFFFF"/>
  </svg>
)}

{presetId === 'social-instagram-post' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <defs>
      <radialGradient id="ig-grad-icon" cx="20%" cy="100%" r="130%">
        <stop offset="0%" stop-color="#FFDD55"/>
        <stop offset="25%" stop-color="#FF543E"/>
        <stop offset="50%" stop-color="#C837AB"/>
        <stop offset="100%" stop-color="#3771C8"/>
      </radialGradient>
    </defs>
    <rect width="24" height="24" rx="6" fill="url(#ig-grad-icon)"/>
    <rect x="6" y="6" width="12" height="12" rx="3.5" stroke="#FFFFFF" stroke-width="1.8"/>
    <circle cx="12" cy="12" r="3" stroke="#FFFFFF" stroke-width="1.8"/>
    <circle cx="15.5" cy="8.5" r="0.8" fill="#FFFFFF"/>
  </svg>
)}

{presetId === 'social-twitter-header' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="#0F1419"/>
    <path d="M14.2 10.9L19.5 5h-1.3l-4.5 5.1L10 5H5.5l5.6 7.8L5.5 19H6.8l4.9-5.5L15.5 19h4.5l-5.8-8.1zm-1.7 2l-.6-.8-4.6-6.4h1.9l3.7 5.2.6.8 4.8 6.7h-1.9l-3.9-5.5z" fill="#FFFFFF"/>
  </svg>
)}

{presetId === 'social-facebook-cover' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="#1877F2"/>
    <path d="M15.5 8.5H13V7c0-.7.3-.9 1-.9h1.5V3.8S14.2 3.7 13 3.7c-2.3 0-3.5 1.4-3.5 3.6v1.2H7v2.8h2.5V19h3.5v-7.7h2.2l.3-2.8z" fill="#FFFFFF"/>
  </svg>
)}

{presetId === 'signature' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-opacity="0.15"/>
    <path d="M4 17.5c2.5-1 5 1 7.5-1.5s3.5-3 5.5-2.5 3 2.5 3 2.5" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M14 6l4 4-8 8H6v-4l8-8z" stroke="#3b82f6" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>
)}

{presetId === 'thumbprint' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-opacity="0.15"/>
    <path d="M12 7c-2.8 0-5 2.2-5 5v2m10-2c0-2.8-2.2-5-5-5m-2 7a2 2 0 104 0v-2a4 4 0 00-8 0v2m4 4v-2" stroke="#8b5cf6" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
)}

{(presetId === 'pan-card' || presetId === 'aadhaar-doc') && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-opacity="0.15"/>
    <rect x="4" y="6" width="16" height="12" rx="2" stroke="#10b981" stroke-width="1.5"/>
    <circle cx="8.5" cy="11" r="2" fill="#10b981"/>
    <line x1="13" y1="10" x2="17" y2="10" stroke="#10b981" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="13" y1="13" x2="16" y2="13" stroke="#10b981" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}

{category === 'exam' && presetId !== 'signature' && presetId !== 'thumbprint' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-opacity="0.15"/>
    <path d="M12 5L4 9l8 4 8-4-8-4z" fill="#f59e0b" fill-opacity="0.25" stroke="#f59e0b" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M7 11.5v4c0 1.5 2.2 2.5 5 2.5s5-1 5-2.5v-4" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="19" y1="9.5" x2="19" y2="15" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}

{category === 'visa' && (
  <span class="inline-flex items-center justify-center font-mono text-[10px] font-bold tracking-tight text-fg">
    {countryCode || 'VISA'}
  </span>
)}

