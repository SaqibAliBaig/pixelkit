---
import { PORTAL_PRESETS } from '@lib/portal-presets';

interface Props {
  accept: string;
  from: string;
  to?: string;
  initialTool?: string;
  initialSizeMode?: 'max' | 'exact' | 'range' | 'quality';
  targetKb?: number | null;
  minKb?: number | null;
  maxKb?: number | null;
  initialCropAspect?: string;
  initialUnit?: 'px' | 'cm' | 'mm' | 'in';
  initialWidth?: number | null;
  initialHeight?: number | null;
  initialDpi?: number | null;
  preserveMetadata?: boolean;
  initialMergePdf?: boolean;
  preset?: string;
}

const {
  accept,
  from,
  to,
  initialTool = 'all',
  initialSizeMode,
  targetKb,
  minKb,
  maxKb,
  initialCropAspect,
  initialUnit,
  initialWidth,
  initialHeight,
  initialDpi,
  preserveMetadata,
  initialMergePdf,
  preset,
} = Astro.props;
const fromUpper = from.toUpperCase();
const toUpper = to ? to.toUpperCase() : '';

const promptText =
  initialTool === 'crop'
    ? initialCropAspect && initialCropAspect !== 'original'
      ? `Drop any photo to crop to ${initialCropAspect}`
      : 'Drop any photo to crop & frame'
    : initialTool === 'resize'
    ? initialUnit && initialUnit !== 'px'
      ? `Drop any photo to resize in ${initialUnit.toUpperCase()}`
      : 'Drop any photo to resize resolution'
    : initialTool === 'dpi'
    ? `Drop any photo to convert to ${initialDpi || 300} DPI`
    : initialTool === 'exif'
    ? 'Drop any photo to strip EXIF & GPS metadata'
    : initialTool === 'passport'
    ? 'Drop photo for passport or visa portal'
    : initialTool === 'convert'
    ? initialMergePdf
      ? 'Drop multiple photos to merge into PDF'
      : 'Drop any photo or document to convert'
    : initialTool === 'compress'
    ? initialSizeMode === 'exact'
      ? 'Drop any photo to increase or set exact KB size'
      : initialSizeMode === 'range' && minKb && maxKb
      ? `Drop any photo to compress to ${minKb}–${maxKb} KB`
      : 'Drop any photo to compress file size'
    : 'Drop any image or document here';

const matchedPreset = preset ? PORTAL_PRESETS.find((p) => p.id === preset) : null;

function formatKbOrMb(kb: number): string {
  if (kb >= 1024 && kb % 1024 === 0) return `${kb / 1024} MB`;
  return `${kb} KB`;
}

let lockedPresetLabel = '';
if (matchedPreset) {
  const effectiveKb = targetKb ?? matchedPreset.targetKb;
  const kbPart =
    initialSizeMode === 'range' && minKb && maxKb
      ? `${minKb}–${maxKb} KB`
      : effectiveKb
      ? `≤ ${formatKbOrMb(effectiveKb)}`
      : '';
  const dimPart = matchedPreset.dimLabel || '';
  const fmtPart = toUpper === 'PDF' ? ' • PDF' : '';
  if (kbPart && dimPart) {
    lockedPresetLabel = `Locked Preset: ${kbPart} • ${dimPart}${fmtPart}`;
  } else if (kbPart) {
    lockedPresetLabel = `Locked Preset: ${kbPart}${fmtPart}`;
  } else if (dimPart) {
    lockedPresetLabel = `Locked Preset: ${matchedPreset.name} (${dimPart})`;
  } else {
    lockedPresetLabel = `Locked Preset: ${matchedPreset.name}`;
  }
} else if (initialTool === 'dpi' && initialDpi) {
  lockedPresetLabel = `Active Mode: ${initialDpi} DPI Print Header • 100% Lossless`;
} else if (initialTool === 'exif' || preserveMetadata === false) {
  lockedPresetLabel = 'Privacy Mode: Strip All EXIF, GPS & Camera Tags';
} else if (initialCropAspect && initialCropAspect !== 'original') {
  lockedPresetLabel = `Active Crop Ratio: ${initialCropAspect} Aspect Lock`;
} else if (initialUnit && initialUnit !== 'px' && initialWidth && initialHeight) {
  const dpiPart = initialDpi ? ` @ ${initialDpi} DPI` : '';
  const kbPart = targetKb ? ` • ≤ ${formatKbOrMb(targetKb)}` : '';
  lockedPresetLabel = `Preset: ${initialWidth} × ${initialHeight} ${initialUnit}${dpiPart}${kbPart}`;
} else if (initialWidth && initialHeight) {
  const dpiPart = initialDpi ? ` • ${initialDpi} DPI` : '';
  const kbPart = targetKb ? ` • ≤ ${formatKbOrMb(targetKb)}` : '';
  lockedPresetLabel = `Preset: ${initialWidth} × ${initialHeight} px${dpiPart}${kbPart}`;
} else if (initialUnit && initialUnit !== 'px') {
  const dpiPart = initialDpi ? ` @ ${initialDpi} DPI` : '';
  lockedPresetLabel = `Active Unit: Resize in ${initialUnit.toUpperCase()}${dpiPart}`;
} else if (initialSizeMode === 'range' && minKb && maxKb) {
  lockedPresetLabel = `Locked Bracket: ${minKb} KB – ${maxKb} KB`;
} else if (initialSizeMode === 'quality') {
  lockedPresetLabel = 'High-Fidelity Compression • 85% Smart Quality';
} else if (targetKb && initialSizeMode === 'exact') {
  lockedPresetLabel = `Exact Target: ${formatKbOrMb(targetKb)} • Increase or Compress`;
} else if (targetKb) {
  const fmtTarget = toUpper && fromUpper !== toUpper ? `${toUpper} Output` : 'Target File Size';
  lockedPresetLabel = `Locked Preset: ≤ ${formatKbOrMb(targetKb)} • ${fmtTarget}`;
} else if (initialMergePdf) {
  lockedPresetLabel = 'Active Mode: Merge Multiple Images into 1 PDF';
}
---

<div
  id="pk-dropzone"
  role="region"
  aria-label={`Dropzone: ${promptText}`}
  class="group relative flex flex-col items-center justify-center gap-2.5 rounded-xl sm:rounded-2xl border-2 border-dashed border-border bg-bg/40 px-4 py-7 sm:px-6 sm:py-9 text-center cursor-pointer transition-colors duration-150 hover:border-accent hover:bg-bg/60 focus-within:border-accent focus-within:ring-2 focus-within:ring-accent/20"
  data-dragover="false"
>
  <input
    id="pk-file-input"
    type="file"
    accept={accept}
    multiple
    class="absolute inset-0 z-10 h-full w-full opacity-0 cursor-pointer"
    aria-label="Upload files from your device"
  />

  {lockedPresetLabel && (
    <div
      id="pk-locked-preset-badge"
      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent border border-accent/25 shadow-2xs pointer-events-none mb-1 animate-in fade-in duration-200"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>{lockedPresetLabel}</span>
    </div>
  )}

  <div
    class="flex h-12 w-12 items-center justify-center rounded-full bg-surface border border-border text-fg group-hover:border-accent/40 group-hover:scale-105 transition-transform pointer-events-none"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-6 w-6 text-accent"
    >
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="17 8 12 3 7 8"></polyline>
      <line x1="12" y1="3" x2="12" y2="15"></line>
    </svg>
  </div>

  <div class="text-sm pointer-events-none">
    <span id="pk-dropzone-prompt" class="font-semibold text-fg">{promptText}</span>
    <span class="text-muted"> or </span>
    <span class="font-semibold text-accent underline underline-offset-4 group-hover:text-accent/90">
      browse files
    </span>
  </div>
  <p class="text-xs text-muted max-w-sm pointer-events-none">
    Supports <span class="font-medium text-fg">JPG, PNG, HEIC, WEBP, PDF, SVG, TIFF, AVIF, GIF, BMP</span>
    {toUpper && fromUpper !== toUpper && !['crop', 'resize', 'passport'].includes(initialTool) && (
      <span> · Preset for <span class="font-medium text-fg">{fromUpper}</span> → <span class="text-accent font-semibold">{toUpper}</span></span>
    )}
  </p>

  <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 pt-1 text-[11px] text-muted pointer-events-none">
    <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-medium">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      No file size limit
    </span>
    <span class="hidden sm:inline text-muted/40">·</span>
    <span class="inline-flex items-center gap-1 font-medium text-fg/80">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="8.5" cy="7" r="4"></circle>
        <line x1="20" y1="8" x2="20" y2="14"></line>
        <line x1="23" y1="11" x2="17" y2="11"></line>
      </svg>
      Add unlimited photos
    </span>
    <span class="hidden sm:inline text-muted/40">·</span>
    <span class="text-muted/80">100% in-browser</span>
  </div>
</div>
