---
interface Props {
  accept: string;
  from: string;
  to?: string;
  initialTool?: string;
}

const { accept, from, to, initialTool = 'all' } = Astro.props;
const fromUpper = from.toUpperCase();
const toUpper = to ? to.toUpperCase() : '';

const promptText =
  initialTool === 'crop'
    ? 'Drop any photo to crop & frame'
    : initialTool === 'resize'
    ? 'Drop any photo to resize resolution'
    : initialTool === 'passport'
    ? 'Drop photo for passport or visa portal'
    : initialTool === 'convert'
    ? 'Drop any photo or document to convert'
    : initialTool === 'compress'
    ? 'Drop any photo to compress file size'
    : 'Drop any image or document here';
---

<div
  id="pk-dropzone"
  role="region"
  tabindex="0"
  aria-label={`Dropzone: ${promptText}`}
  class="group relative flex flex-col items-center justify-center gap-2.5 rounded-xl sm:rounded-2xl border-2 border-dashed border-border bg-bg/40 px-4 py-7 sm:px-6 sm:py-9 text-center cursor-pointer transition-all hover:border-accent hover:bg-bg/60 active:scale-[0.99] focus-within:border-accent focus-within:ring-2 focus-within:ring-accent/20"
  data-dragover="false"
>
  <input
    id="pk-file-input"
    type="file"
    accept={accept}
    multiple
    class="sr-only"
    aria-label="Upload files from your device"
  />

  <div
    class="flex h-12 w-12 items-center justify-center rounded-full bg-surface border border-border text-fg group-hover:border-accent/40 group-hover:scale-105 transition-transform"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-6 w-6 text-accent"
    >
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="17 8 12 3 7 8"></polyline>
      <line x1="12" y1="3" x2="12" y2="15"></line>
    </svg>
  </div>

  <div class="text-sm">
    <span id="pk-dropzone-prompt" class="font-semibold text-fg">{promptText}</span>
    <span class="text-muted"> or </span>
    <span class="font-semibold text-accent underline underline-offset-4 group-hover:text-accent/90">
      browse files
    </span>
  </div>
  <p class="text-xs text-muted max-w-sm">
    Supports <span class="font-medium text-fg">JPG, PNG, HEIC, WEBP, PDF, SVG, TIFF, AVIF, GIF, BMP</span>
    {toUpper && fromUpper !== toUpper && !['crop', 'resize', 'passport'].includes(initialTool) && (
      <span> · Preset for <span class="font-medium text-fg">{fromUpper}</span> → <span class="text-accent font-semibold">{toUpper}</span></span>
    )}
  </p>
  <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 pt-1 text-[11px] text-muted">
    <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-medium">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      No file size limit
    </span>
    <span class="hidden sm:inline text-muted/40">·</span>
    <span class="inline-flex items-center gap-1 font-medium text-fg/80">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="8.5" cy="7" r="4"></circle>
        <line x1="20" y1="8" x2="20" y2="14"></line>
        <line x1="23" y1="11" x2="17" y2="11"></line>
      </svg>
      Add unlimited photos
    </span>
    <span class="hidden sm:inline text-muted/40">·</span>
    <span class="text-muted/80">100% in-browser</span>
  </div>
</div>
