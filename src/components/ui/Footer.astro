---
// Clean, mobile-friendly Footer with compact multi-column links and privacy guarantee
import Container from '@components/ui/Container.astro';
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { SITE, FOOTER_LINKS } from '@lib/constants';

const year = new Date().getFullYear();
---

<footer class="mt-14 sm:mt-20 border-t border-border bg-bg">
  <Container>
    <div class="py-8 sm:py-12">
      <!-- Top Section: Brand Info + 2-Column Responsive Link Grid -->
      <div class="grid gap-8 lg:grid-cols-5 lg:gap-10">
        <!-- Brand + blurb -->
        <div class="lg:col-span-2">
          <a href="/" class="inline-flex items-center gap-2 font-semibold text-fg hover:opacity-90 transition-opacity">
            <Image
              src={logo}
              width={24}
              height={24}
              alt={SITE.name}
              loading="lazy"
              class="h-6 w-6 rounded-md shrink-0 object-contain shadow-xs"
            />
            <span class="text-base tracking-tight">{SITE.name}</span>
          </a>
          <p class="mt-2.5 max-w-sm text-xs sm:text-sm text-muted leading-relaxed">
            Fast, 100% private file conversion & compression in your browser.
            Convert HEIC, JPG, PNG, WEBP and PDF to exact sizes without server uploads.
          </p>
          <div class="mt-3.5 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-[11px] text-muted">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
            <span>100% Client-Side · Zero uploads</span>
          </div>
        </div>

        <!-- Links Grid: 2 columns on mobile, 3 columns on desktop -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 sm:gap-8 lg:col-span-3 pt-2 lg:pt-0 border-t lg:border-t-0 border-border/50">
          <!-- Convert column -->
          <div>
            <h3 class="text-[11px] uppercase tracking-wider text-muted font-bold">Convert</h3>
            <ul class="mt-3 space-y-1.5 text-xs sm:text-sm">
              {FOOTER_LINKS.tools.map((l) => (
                <li>
                  <a href={l.href} class="text-muted hover:text-fg transition-colors py-0.5 inline-block">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Target column -->
          <div>
            <h3 class="text-[11px] uppercase tracking-wider text-muted font-bold">KB Targets</h3>
            <ul class="mt-3 space-y-1.5 text-xs sm:text-sm">
              {FOOTER_LINKS.targets.map((l) => (
                <li>
                  <a href={l.href} class="text-muted hover:text-fg transition-colors py-0.5 inline-block">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Company / Site column (col-span-2 on mobile so it sits neatly underneath) -->
          <div class="col-span-2 sm:col-span-1 pt-2 sm:pt-0 border-t sm:border-t-0 border-border/40">
            <h3 class="text-[11px] uppercase tracking-wider text-muted font-bold">Site</h3>
            <ul class="mt-3 flex sm:flex-col flex-wrap gap-x-4 gap-y-1.5 text-xs sm:text-sm">
              {FOOTER_LINKS.site.map((l) => (
                <li>
                  <a href={l.href} class="text-muted hover:text-fg transition-colors py-0.5 inline-block">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="mt-8 border-t border-border/60 pt-5 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-[11px] sm:text-xs text-muted text-center sm:text-left">
        <p>© {year} {SITE.name}. All rights reserved.</p>
        <p class="flex items-center gap-1.5 justify-center">
          <span>Private by default.</span>
          <span>·</span>
          <span>No tracking cookies.</span>
        </p>
      </div>
    </div>
  </Container>
</footer>