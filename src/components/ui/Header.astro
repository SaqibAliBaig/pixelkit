---
import Container from '@components/ui/Container.astro';
import ThemeToggle from '@components/ui/ThemeToggle.astro';
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { SITE, NAV } from '@lib/constants';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur supports-[backdrop-filter]:bg-bg/60">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4">
      <!-- Brand -->
      <a
        href="/"
        class="flex items-center gap-2 rounded-md font-semibold text-fg hover:opacity-90"
        aria-label={`${SITE.name} home`}
      >
        <Image
          src={logo}
          width={28}
          height={28}
          alt={SITE.name}
          loading="eager"
          class="h-7 w-7 rounded-lg shrink-0 object-contain shadow-sm"
        />
        <span class="text-[15px] tracking-tight">{SITE.name}</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
        {NAV.map((item) => (
          <a
            href={item.href}
            class={[
              'rounded-md px-3 py-2 text-sm transition-colors',
              isActive(item.href)
                ? 'text-fg bg-surface'
                : 'text-muted hover:text-fg hover:bg-surface',
            ].join(' ')}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-1">
        <ThemeToggle />
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted hover:text-fg hover:bg-surface"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-4" aria-label="Mobile">
      <nav class="flex flex-col gap-1 pt-2">
        {NAV.map((item) => (
          <a
            href={item.href}
            class={[
              'rounded-md px-3 py-2 text-sm transition-colors',
              isActive(item.href)
                ? 'text-fg bg-surface'
                : 'text-muted hover:text-fg hover:bg-surface',
            ].join(' ')}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </Container>
</header>

<script>
  (() => {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });

    // Close on navigation (client-side).
    document.addEventListener('astro:after-swap', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });
  })();
</script>