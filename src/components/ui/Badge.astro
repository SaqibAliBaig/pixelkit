---
interface Props {
  variant?: 'default' | 'accent' | 'success' | 'warning' | 'muted';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'sm',
  class: className = '',
} = Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  default: 'bg-surface text-fg border-border',
  accent: 'bg-accent text-accent-fg border-transparent',
  success: 'bg-success/10 text-success border-success/20',
  warning: 'bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 border-yellow-500/20',
  muted: 'bg-transparent text-muted border-border',
};

const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'text-[11px] px-2 py-0.5',
  md: 'text-xs px-2.5 py-1',
};
---

<span
  class={[
    'inline-flex items-center gap-1 rounded-full border font-medium leading-none whitespace-nowrap',
    variants[variant],
    sizes[size],
    className,
  ].join(' ')}
>
  <slot />
</span>