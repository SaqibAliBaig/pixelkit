---
interface Props {
  as?: 'div' | 'section' | 'article' | 'li';
  href?: string;
  padded?: boolean;
  interactive?: boolean;
  class?: string;
}

const {
  as: Tag = 'div',
  href,
  padded = true,
  interactive = false,
  class: className = '',
} = Astro.props;

const classes = [
  'rounded-2xl border border-border bg-surface',
  padded ? 'p-5 sm:p-6' : '',
  interactive
    ? 'transition-all duration-200 hover:border-fg/20 hover:shadow-soft focus-within:border-fg/20'
    : '',
  href ? 'block' : '',
  className,
].join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <Tag class={classes}>
      <slot />
    </Tag>
  )
}