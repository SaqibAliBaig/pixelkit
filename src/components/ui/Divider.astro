---
interface Props {
  label?: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

{
  label ? (
    <div class={['flex items-center gap-3 my-8', className].join(' ')} role="separator">
      <span class="h-px flex-1 bg-border" />
      <span class="text-xs uppercase tracking-wider text-muted">{label}</span>
      <span class="h-px flex-1 bg-border" />
    </div>
  ) : (
    <hr class={['my-8 border-0 h-px bg-border', className].join(' ')} />
  )
}