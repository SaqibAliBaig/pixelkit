---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={['text-sm', className].join(' ')}>
  <ol class="flex flex-wrap items-center gap-1.5 text-muted">
    {items.map((item, i) => {
      const isLast = i === items.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {item.href && !isLast ? (
            <a href={item.href} class="hover:text-fg transition-colors">
              {item.label}
            </a>
          ) : (
            <span class={isLast ? 'text-fg' : ''} aria-current={isLast ? 'page' : undefined}>
              {item.label}
            </span>
          )}
          {!isLast && (
            <span class="text-muted/60" aria-hidden="true">
              /
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>