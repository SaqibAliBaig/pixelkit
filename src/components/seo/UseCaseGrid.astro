---
import useCaseData from '@data/use-cases.json';

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const useCases = useCaseData.useCases.filter((u) => ids.includes(u.id));
const byId = new Map(useCases.map((u) => [u.id, u]));

const icons: Record<string, string> = {
  'id-card':
    '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M6.5 16a3 3 0 0 1 5 0"/><path d="M15 10h4"/><path d="M15 14h4"/>',
  'file-text':
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/>',
  'clipboard-check':
    '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><polyline points="9 14 11 16 15 12"/>',
  mail:
    '<rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/>',
  smartphone:
    '<rect x="6" y="2" width="12" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
  globe:
    '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/>',
};
---

{
  useCases.length > 0 && (
    <section class="mx-auto mt-16 max-w-prose" aria-labelledby="use-cases-heading">
      <h2
        id="use-cases-heading"
        class="text-xl font-semibold tracking-tight text-fg sm:text-2xl"
      >
        Common use cases
      </h2>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {useCases.map((u) => {
          const icon = icons[u.icon] ?? icons['file-text']!;
          return (
            <div class="rounded-xl border border-border bg-surface p-4">
              <div class="flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-bg/60 border border-border text-fg">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icon}
                  />
                </span>
                <h3 class="text-sm font-medium text-fg">{u.title}</h3>
              </div>
              <p class="mt-2 text-xs text-muted leading-relaxed">{u.blurb}</p>
            </div>
          );
        })}
      </div>
    </section>
  )
}