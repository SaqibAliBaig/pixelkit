---
interface Props {
  format?: string;
  sizeKb?: number | null;
  filterKb?: number | null;
  activePortal?: string;
}

const {
  format = 'JPG',
  sizeKb = null,
  filterKb = null,
  activePortal = undefined,
} = Astro.props;

const targetKb = filterKb ?? sizeKb;

const allPortals = [
  { id: 'pan-sig', name: 'PAN Card & Aadhaar Signature', format: 'JPG', dims: '400 × 200 px', limit: '10 KB to 20 KB', minKb: 10, maxKb: 20 },
  { id: 'ibps-sig', name: 'IBPS PO & Clerk Signature', format: 'JPG', dims: '140 × 60 px', limit: '10 KB to 20 KB', minKb: 10, maxKb: 20 },
  { id: 'ssc-sig', name: 'SSC Signature (CGL / CHSL / MTS)', format: 'JPG', dims: '140 × 60 px (4 × 2 cm)', limit: '10 KB to 20 KB', minKb: 10, maxKb: 20 },
  { id: 'ssc', name: 'SSC CGL, CHSL, GD Photo', format: 'JPG', dims: '350 × 450 px (3.5 × 4.5 cm)', limit: '20 KB to 50 KB', minKb: 20, maxKb: 50 },
  { id: 'upsc', name: 'UPSC Civil Services (IAS/IPS)', format: 'JPG', dims: '350 × 350 to 1000 × 1000 px', limit: '20 KB to 300 KB', minKb: 20, maxKb: 300 },
  { id: 'passport-in', name: 'Passport Seva (India) & PAN Card', format: 'JPG / JPEG', dims: '413 × 531 px (35 × 45 mm)', limit: '20 KB to 50 KB', minKb: 20, maxKb: 50 },
  { id: 'neet', name: 'NEET-UG & JEE Main Photo', format: 'JPG', dims: '413 × 531 px (35 × 45 mm)', limit: '10 KB to 200 KB', minKb: 10, maxKb: 200 },
  { id: 'us-visa', name: 'US Visa (DS-160) & DV Lottery', format: 'JPEG', dims: '600 × 600 px (2 × 2 inch square)', limit: 'Under 240 KB', minKb: 20, maxKb: 240 },
  { id: 'schengen', name: 'Schengen Visa (France, Germany, Italy)', format: 'JPG', dims: '413 × 531 px (35 × 45 mm)', limit: 'Under 200 KB', minKb: 20, maxKb: 200 },
  { id: 'uk-passport', name: 'UK Passport & UKVI Visa Portal', format: 'JPG', dims: '600 × 750 px (3:4 ratio)', limit: '50 KB to 10 MB', minKb: 50, maxKb: 10000 },
  { id: 'canada', name: 'Canada Visa & Express Entry (IRCC)', format: 'JPG', dims: '420 × 540 px (35 × 45 mm)', limit: '60 KB to 240 KB', minKb: 60, maxKb: 240 },
  { id: 'australia', name: 'Australia Visa (ImmiAccount)', format: 'JPG / PNG', dims: '413 × 531 px (35 × 45 mm)', limit: 'Under 500 KB', minKb: 50, maxKb: 500 },
];

let displayedPortals = allPortals;

if (activePortal) {
  const norm = activePortal.toLowerCase();
  displayedPortals = allPortals.filter((p) => p.id.includes(norm) || p.name.toLowerCase().includes(norm));
  if (displayedPortals.length < 3) {
    displayedPortals = allPortals.slice(0, 4);
  }
} else if (targetKb) {
  displayedPortals = allPortals.filter((p) => p.minKb <= targetKb && p.maxKb >= targetKb);
  if (displayedPortals.length === 0) {
    displayedPortals = allPortals.filter((p) => Math.abs(p.maxKb - targetKb) <= 50);
  }
  if (displayedPortals.length === 0) {
    displayedPortals = allPortals.slice(0, 4);
  }
} else {
  displayedPortals = allPortals.slice(0, 5);
}
---

<section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8" aria-labelledby="portal-guide-heading">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div>
      <h2 id="portal-guide-heading" class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Official Portal Upload Specifications &amp; Requirements Guide
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted leading-relaxed">
        Government recruitment, visa, and exam portals enforce rigid biometric upload rules for {format} files:
      </p>
    </div>
    <a
      href="/portal-photo-size-chart/"
      class="text-xs font-semibold text-accent hover:underline shrink-0"
    >
      Full 50+ Portal Chart →
    </a>
  </div>

  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead>
        <tr class="border-b border-border text-muted">
          <th class="pb-2.5 font-medium">Application Portal / Authority</th>
          <th class="pb-2.5 font-medium">Format</th>
          <th class="pb-2.5 font-medium">Dimensions (Pixels &amp; MM)</th>
          <th class="pb-2.5 font-medium text-accent">File Size Limit</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60 text-fg/85">
        {displayedPortals.map((p) => (
          <tr>
            <td class="py-2.5 font-medium text-fg">{p.name}</td>
            <td class="py-2.5">{p.format}</td>
            <td class="py-2.5">{p.dims}</td>
            <td class="py-2.5 font-medium text-accent">{p.limit}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-6 border-t border-border/60 pt-5 space-y-3 text-xs sm:text-sm text-fg/80 leading-relaxed">
    <p>
      <strong>Biometric Facial Ratio (70%–80% Rule):</strong> Automated passport and exam gates require the subject's face (from the bottom of the chin to the top of the head) to measure strictly between 70% and 80% of total image height. Cropping too closely into the forehead or leaving excessive empty margins above the hair triggers automated rejection.
    </p>
    <p>
      <strong>Bicubic Downsampling Before Compression:</strong> When reducing large smartphone photos (e.g. 12MP–48MP) to small targets like 20KB or 50KB, always downsample pixel dimensions (e.g. to 350×450 px) first. Downscaling eliminates redundant pixel count before quantization begins, preserving crisp facial contours and high-contrast signature lines without blocky JPEG noise.
    </p>
  </div>

  <div class="mt-6 rounded-xl border border-accent/25 bg-accent/5 p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h3 class="font-semibold text-fg text-sm">Need specifications for another portal?</h3>
      <p class="text-xs text-muted mt-0.5">Explore exact pixel dimensions, millimeter ratios, and kilobyte rules for 50+ global authorities in our master chart.</p>
    </div>
    <a href="/portal-photo-size-chart/" class="shrink-0 px-3.5 py-1.5 rounded-lg bg-accent text-accent-fg text-xs font-semibold hover:opacity-90 transition-opacity">
      View 50+ Portal Size Chart →
    </a>
  </div>
</section>
