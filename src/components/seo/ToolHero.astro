---
import Badge from '@components/ui/Badge.astro';

interface Combo {
  from: string;
  to: string;
  sizeKb: number | null;
}

interface Props {
  combo: Combo;
}

const { combo } = Astro.props;
const fromLabel = combo.from.toUpperCase();
const toLabel = combo.to.toUpperCase();

const h1 = combo.sizeKb
  ? `Convert & Compress ${fromLabel} to ${toLabel} Under ${combo.sizeKb}KB Online`
  : `${fromLabel} to ${toLabel} Converter — Convert Online Free`;

const subtitle = combo.sizeKb
  ? `Convert ${fromLabel} to ${toLabel} and hit strictly under ${combo.sizeKb}KB in one pass — highest possible visual clarity, no watermark, 100% private in your browser.`
  : `Free online ${fromLabel} to ${toLabel} converter with batch ZIP download, optional KB target (20KB–500KB), and built-in crop & resize. Zero server uploads.`;
---

<section class="text-center">
  <Badge variant="muted" class="mx-auto">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
    Free &amp; Unlimited · Batch ZIP · 100% Client-Side
  </Badge>

  <h1 class="mt-4 text-balance text-2xl sm:text-3xl lg:text-5xl font-semibold tracking-tight">
    {h1}
  </h1>

  <p class="mx-auto mt-4 max-w-prose text-balance text-base text-muted leading-relaxed sm:text-lg">
    {subtitle}
  </p>
</section>