---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import ToolHero from '@components/seo/ToolHero.astro';
import ToolIntro from '@components/seo/ToolIntro.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import RelatedCombos from '@components/seo/RelatedCombos.astro';
import UseCaseGrid from '@components/seo/UseCaseGrid.astro';
import RelatedBlog from '@components/seo/RelatedBlog.astro';
import Converter from '../components/converter/Converter.astro';
import { buildToolJsonLd } from '@lib/seo/jsonld';

interface Combo {
  from: string;
  to: string;
  sizeKb: number | null;
  fromMime: string;
  toMime: string;
}

interface Props {
  combo: Combo;
  title: string;
  description: string;
  intro: string;
  faqs: { q: string; a: string }[];
  related: { label: string; href: string }[];
  useCaseIds?: string[];
  relatedBlogSlugs?: string[];
  noindex?: boolean;
}

const {
  combo,
  title,
  description,
  intro,
  faqs,
  related,
  useCaseIds = [],
  relatedBlogSlugs = [],
  noindex = false,
} = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Convert', href: '/convert/' },
  {
    label: combo.sizeKb
      ? `${combo.from.toUpperCase()} to ${combo.to.toUpperCase()} under ${combo.sizeKb}KB`
      : `${combo.from.toUpperCase()} to ${combo.to.toUpperCase()}`,
  },
];

const jsonLd = buildToolJsonLd({
  combo,
  title,
  description,
  faqs,
  url: new URL(Astro.url.pathname, Astro.site).href,
  breadcrumbs: breadcrumbs.map((b) => ({
    name: b.label,
    url: b.href ? new URL(b.href, Astro.site).href : undefined,
  })),
});

const fromLabel = combo.from.toUpperCase();
const toLabel = combo.to.toUpperCase();
const toolKeywords = [
  `${combo.from} to ${combo.to}`,
  `${combo.from} to ${combo.to} converter`,
  `convert ${combo.from} to ${combo.to}`,
  `convert ${fromLabel} to ${toLabel} online free`,
  `${fromLabel} to ${toLabel} converter online`,
  `${fromLabel} converter`,
  `${toLabel} converter`,
  combo.sizeKb ? `compress ${fromLabel} to ${combo.sizeKb}kb` : `compress ${fromLabel}`,
  combo.sizeKb ? `${fromLabel} to ${toLabel} under ${combo.sizeKb}kb` : 'online file converter',
  'client-side converter',
  'no upload image converter',
];

const directAnswerTitle = combo.sizeKb
  ? `Quick Answer: How to Convert ${fromLabel} to ${toLabel} Under ${combo.sizeKb}KB Online`
  : `Quick Answer: How to Convert ${fromLabel} to ${toLabel} Online Free`;

const directAnswerSummary = combo.sizeKb
  ? `To convert ${fromLabel} to ${toLabel} under ${combo.sizeKb}KB: 1. Drag and drop your .${combo.from.toLowerCase()} file(s) into PixelKit above. 2. Output format (${toLabel}) and the ${combo.sizeKb}KB file size limit are pre-locked. 3. PixelKit runs a 12-step binary-search algorithm in browser memory to maximize clarity under ${combo.sizeKb}KB. 4. Click Download to save your compliant .${combo.to.toLowerCase()} file instantly with zero server uploads.`
  : `To convert ${fromLabel} to ${toLabel} online for free: 1. Drag and drop one or more .${combo.from.toLowerCase()} files into the PixelKit converter above. 2. Optionally crop aspect ratio, resize dimensions, or set an exact KB size limit${combo.to.toLowerCase() === 'pdf' ? ' or merge multiple files into one PDF' : ''}. 3. Click Download (or Download All as ZIP) to save your converted .${combo.to.toLowerCase()} files instantly—100% locally in your browser with no watermarks or uploads.`;

const directAnswerSpecs = [
  { label: 'Conversion Pair', value: `.${combo.from.toLowerCase()} → .${combo.to.toLowerCase()} (${fromLabel} to ${toLabel})`, highlight: true },
  {
    label: combo.sizeKb ? 'Target Size Limit' : 'Quality & Size Control',
    value: combo.sizeKb ? `Strictly ≤ ${combo.sizeKb} KB` : 'Lossless / Custom KB (20–500KB)',
    highlight: Boolean(combo.sizeKb),
  },
  {
    label: combo.to.toLowerCase() === 'pdf' ? 'Multi-Page & Batch' : 'Batch & Studio Tools',
    value: combo.to.toLowerCase() === 'pdf' ? 'Merge to 1 PDF or Batch Export' : 'Bulk ZIP, Crop & Resize Included',
  },
  { label: 'Privacy & Cost', value: '100% Free · Zero Server Uploads' },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={toolKeywords}
  jsonLd={jsonLd}
  noindex={noindex}
  width="default"
>
  <Breadcrumbs items={breadcrumbs} />

  <ToolHero combo={combo} />

  <div class="mt-4 sm:mt-8">
    <Converter
      from={combo.from}
      to={combo.to}
      fromMime={combo.fromMime}
      toMime={combo.toMime}
      targetKb={combo.sizeKb}
      initialTool={combo.sizeKb ? 'compress' : 'convert'}
    />
  </div>

  <DirectAnswerBox
    title={directAnswerTitle}
    summaryText={directAnswerSummary}
    specs={directAnswerSpecs}
  />

  <ToolIntro combo={combo} intro={intro} />

  <!-- Focused Government & Visa Portal Callout -->
  <aside class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/60 p-5 sm:p-7 shadow-2xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-accent animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-accent">Need strict passport, visa, or exam dimensions?</span>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
          If you are submitting this {toLabel} file to government portals (such as US Visa DS-160, Schengen, Indian Passport, or UPSC/SSC), automated intake filters enforce strict millimeter aspect ratios and biometric head framing alongside file size ceilings.
          Use our dedicated <a href="/passport-photo-resizer/" class="font-semibold text-fg underline decoration-accent/60 underline-offset-4 hover:decoration-accent transition-colors">Passport Photo Resizer</a> to automatically crop, align framing, and hit exact portal specifications in one click.
        </p>
      </div>
      <a
        href="/passport-photo-resizer/"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-surface px-4 py-2.5 text-xs font-semibold text-fg hover:bg-surface/80 hover:border-accent/40 transition-colors shrink-0"
      >
        View Official Portal Presets →
      </a>
    </div>
  </aside>

  <FAQSection faqs={faqs} />

  {useCaseIds.length > 0 && <UseCaseGrid ids={useCaseIds} />}

  <RelatedCombos items={related} />

  {relatedBlogSlugs.length > 0 && <RelatedBlog slugs={relatedBlogSlugs} />}
</BaseLayout>
