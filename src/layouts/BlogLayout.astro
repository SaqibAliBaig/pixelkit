---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Prose from '@components/ui/Prose.astro';
import RelatedCombos from '@components/seo/RelatedCombos.astro';
import { buildBlogPostingJsonLd, buildBreadcrumbJsonLd } from '@lib/seo/jsonld';
import { SITE } from '@lib/constants';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author?: string;
  tags?: string[];
  cover?: string;
  related: { label: string; href: string }[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author = SITE.name,
  tags = [],
  cover,
  related,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title },
];

const jsonLd = [
  buildBlogPostingJsonLd({
    title,
    description,
    url,
    publishedAt,
    updatedAt,
    author,
    image: cover,
  }),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, Astro.site).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={title.length > 58 ? title : `${title} — ${SITE.name}`}
  description={description}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  author={author}
  keywords={tags}
  jsonLd={jsonLd}
  width="prose"
>
  <div class="px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <article class="mt-4 sm:mt-6">
      <header class="mb-8 sm:mb-10">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-fg leading-tight">
          {title}
        </h1>
        <p class="mt-2.5 sm:mt-3 text-xs sm:text-base text-muted leading-relaxed">
          {description}
        </p>
        <div class="mt-3 sm:mt-4 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs sm:text-sm text-muted">
          <time datetime={publishedAt.toISOString()} class="font-medium text-fg">
            {publishedAt.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {updatedAt && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated {updatedAt.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{author}</span>
        </div>
        {tags.length > 0 && (
          <ul class="mt-3 sm:mt-4 flex flex-wrap gap-1.5 sm:gap-2">
            {tags.map((t) => (
              <li>
                <span class="inline-flex items-center rounded-md border border-border bg-surface px-2 sm:px-2.5 py-0.5 text-[10px] sm:text-xs text-muted">
                  #{t}
                </span>
              </li>
            ))}
          </ul>
        )}
      </header>

      <Prose>
        <slot />
      </Prose>
    </article>
  </div>

  {related.length > 0 && (
    <div class="mt-16">
      <RelatedCombos items={related} heading="Tools mentioned in this post" />
    </div>
  )}
</BaseLayout>