---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Prose from '@components/ui/Prose.astro';
import RelatedCombos from '@components/seo/RelatedCombos.astro';
import { buildBlogPostingJsonLd, buildBreadcrumbJsonLd } from '@lib/seo/jsonld';
import { SITE } from '@lib/constants';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author?: string;
  tags?: string[];
  cover?: string;
  related: { label: string; href: string }[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author = SITE.name,
  tags = [],
  cover,
  related,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title },
];

const jsonLd = [
  buildBlogPostingJsonLd({
    title,
    description,
    url,
    publishedAt,
    updatedAt,
    author,
    image: cover,
  }),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, Astro.site).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={`${title} — ${SITE.name}`}
  description={description}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  author={author}
  keywords={tags}
  jsonLd={jsonLd}
  width="prose"
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="mt-6">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 text-base text-muted leading-relaxed">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <time datetime={publishedAt.toISOString()}>
          {publishedAt.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {updatedAt && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              Updated {updatedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{author}</span>
      </div>
      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((t) => (
            <li>
              <span class="inline-flex items-center rounded-full border border-border px-2.5 py-0.5 text-xs text-muted">
                {t}
              </span>
            </li>
          ))}
        </ul>
      )}
    </header>

    <Prose>
      <slot />
    </Prose>
  </article>

  {related.length > 0 && (
    <div class="mt-16">
      <RelatedCombos items={related} heading="Tools mentioned in this post" />
    </div>
  )}
</BaseLayout>