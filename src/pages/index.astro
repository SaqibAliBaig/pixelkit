---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import TrustBar from '@components/home/TrustBar.astro';
import PopularConversions from '@components/home/PopularConversions.astro';
import FeatureGrid from '@components/home/FeatureGrid.astro';
import HowItWorks from '@components/home/HowItWorks.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import { buildFaqJsonLd } from '@lib/seo/jsonld';
import { SITE } from '@lib/constants';
import { buildSiteSchemaGraph } from '@lib/seo/jsonld';


const homeFaqs = [
  {
    q: 'Is PixelKit truly 100% free with no file limits, watermarks, or signups?',
    a: 'Yes, completely free forever. PixelKit has no subscriptions, no file size throttles, no artificial watermarks, and requires no account registration. Because all conversion and compression algorithms execute entirely on your own device through browser WebAssembly and Web Workers, we incur virtually zero cloud server compute costs, allowing us to keep this service completely free and open to everyone.',
  },
  {
    q: 'How does client-side in-browser processing guarantee 100% privacy for ID cards and sensitive files?',
    a: 'Unlike traditional online converters that upload your confidential documents, tax forms, passports, and personal family photos to remote cloud servers (where they may sit in temporary buckets or be logged), PixelKit processes everything strictly within your browser sandbox. Your images and documents never leave your laptop, tablet, or phone, making it completely compliant with strict data confidentiality standards and GDPR requirements.',
  },
  {
    q: 'How does PixelKit hit exact file size targets like 20KB, 50KB, 100KB, or 200KB?',
    a: 'Rather than forcing you to guess random quality percentages or undergo tedious trial-and-error, PixelKit utilizes an intelligent binary-search algorithm. It automatically iterates compression parameters and quantization matrices within milliseconds until your output file lands just underneath your specified KB threshold without unnecessary loss of clarity.',
  },
  {
    q: 'Can I convert Apple iPhone HEIC photos directly to JPG, PNG, or WebP?',
    a: 'Yes! PixelKit features a dedicated WebAssembly-powered libheif decoder that parses modern Apple iOS High Efficiency Image Container (HEIC) files right in your web browser. You can seamlessly convert HEIC photos to standard JPEG, PNG, or PDF formats for immediate compatibility with job applications, government portals, and legacy software.',
  },
  {
    q: 'Does PixelKit preserve or strip EXIF metadata and GPS location tags?',
    a: 'You have complete control. By default, PixelKit can preserve crucial EXIF data such as camera orientation and capture settings, or you can check the option to sanitize all sensitive GPS coordinates, device serial numbers, and camera timestamps to protect your personal privacy before sharing photos online.',
  },
  {
    q: 'Can I crop or resize photos to exact passport and visa specifications?',
    a: 'Yes. PixelKit includes built-in photo cropping and resizing studios with one-click presets for US Visa (2x2 inches / 600x600 px), Schengen Visa (35x45 mm), Indian Passport, Pan Card, and civil service recruitment portals (SSC, UPSC). You can crop, resize, and compress your image to exact portal dimensions and KB limits simultaneously with real-time millimeter, inch, and pixel feedback.',
  },
  {
    q: 'Can I compress images without losing visual quality or sharp details?',
    a: 'Yes. PixelKit offers both lossless and visually lossless compression modes. For PNG and SVG graphics, lossless optimization cleans redundant metadata and applies indexed palette quantization without altering pixel values. For photographs (JPG, WebP, AVIF), PixelKit uses psychoacoustic and structural similarity models to remove invisible byte overhead while preserving pin-sharp edges and realistic skin textures.',
  },
  {
    q: 'Which image and document formats are supported by PixelKit?',
    a: 'PixelKit supports comprehensive bi-directional conversion and compression across HEIC, JPG/JPEG, PNG, WebP, AVIF, SVG, TIFF, BMP, GIF, and PDF documents. You can convert single files or process bulk batches simultaneously with instant ZIP packaging.',
  },
];

const jsonLd = [
  buildFaqJsonLd(homeFaqs),
  buildSiteSchemaGraph(),
];
---

<BaseLayout
  title={SITE.defaultTitle}
  description={SITE.defaultDescription}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl">
    <Hero />
    <ToolPreview initialTool="all" />
    <TrustBar />
    <PopularConversions />
    <FeatureGrid />
    <HowItWorks />

    <!-- 20 Official Government & Consular Presets Showcase -->
    <section class="mt-16 sm:mt-24 rounded-2xl border border-border bg-surface p-6 sm:p-10 shadow-xs" aria-labelledby="home-portal-presets-heading">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">Consular &amp; Recruitment Verification</span>
          <h2 id="home-portal-presets-heading" class="mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-fg">
            20 One-Click Government &amp; Visa Portal Presets
          </h2>
          <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
            Never fail an automated photo submission check. PixelKit automatically configures head-and-shoulders crop aspect ratios, exact pixel dimensions, and binary-search file size ceilings in a single tap.
          </p>
        </div>
        <a
          href="/passport-photo-resizer/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-4 py-2 text-xs font-bold text-accent hover:bg-accent/15 transition-colors shrink-0 self-start sm:self-auto"
        >
          Open Passport Resizer →
        </a>
      </div>

      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 text-xs">
        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">🇺🇸</span>
            <span class="font-bold text-fg">US Visa &amp; DS-160</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">600×600 px · Max 240 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">1:1 square crop for US Embassy DS-160 and Green Card Lottery.</p>
        </div>

        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">🇮🇳</span>
            <span class="font-bold text-fg">Indian Passport / Police</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">413×531 px · Max 100 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">35×45 mm spec for Passport Seva Kendra &amp; NRI renewal.</p>
        </div>

        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">🇪🇺</span>
            <span class="font-bold text-fg">Schengen Europe Visa</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">413×531 px · Max 200 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">Biometric VFS Global &amp; TLScontact standards for EU states.</p>
        </div>

        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">🇬🇧</span>
            <span class="font-bold text-fg">UK Passport &amp; UKVI</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">413×531 px · Max 200 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">HM Passport Office &amp; UK Visas digital photo guidelines.</p>
        </div>

        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">🇨🇦</span>
            <span class="font-bold text-fg">Canada Visa &amp; PR</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">420×540 px · Max 240 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">50×70 mm biometric framing for IRCC Express Entry &amp; study.</p>
        </div>

        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">🇦🇺</span>
            <span class="font-bold text-fg">Australia ImmiAccount</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">413×531 px · Max 200 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">Department of Home Affairs standard for digital visa lodgement.</p>
        </div>

        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">🎓</span>
            <span class="font-bold text-fg">Civil Service Exams</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">350×450 px · Max 50 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">UPSC, SSC CGL/CHSL, NEET, IBPS &amp; state PSC recruitment forms.</p>
        </div>

        <div class="rounded-xl border border-border bg-bg/60 p-3.5">
          <div class="flex items-center gap-2">
            <span class="text-base">✍️</span>
            <span class="font-bold text-fg">Official Signature / Thumb</span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] text-accent font-semibold">280×140 px · Max 20 KB</div>
          <p class="mt-1 text-muted text-[11px] leading-relaxed">Sharp black/blue ink extraction for banking KYC &amp; applications.</p>
        </div>
      </div>
    </section>

    <div class="mt-16 sm:mt-24"><PortalRequirementsGuide />
      <div class="mt-16 sm:mt-24"><FAQSection faqs={homeFaqs} heading="Frequently Asked Questions About PixelKit" /></div>
    </div>
  </div>
</BaseLayout>