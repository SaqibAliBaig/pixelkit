---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import TrustBar from '@components/home/TrustBar.astro';
import PopularConversions from '@components/home/PopularConversions.astro';
import FeatureGrid from '@components/home/FeatureGrid.astro';
import HowItWorks from '@components/home/HowItWorks.astro';
import { SITE } from '@lib/constants';
import { buildWebSiteJsonLd, buildOrganizationJsonLd, buildSoftwareApplicationJsonLd } from '@lib/seo/jsonld';

const jsonLd = [
  buildWebSiteJsonLd(),
  buildOrganizationJsonLd(),
  buildSoftwareApplicationJsonLd({
    name: SITE.name,
    description: SITE.defaultDescription,
    url: SITE.url,
  }),
];
---

<BaseLayout
  title={SITE.defaultTitle}
  description={SITE.defaultDescription}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl">
    <Hero />
    <ToolPreview />
    <TrustBar />
    <PopularConversions />
    <FeatureGrid />
    <HowItWorks />
  </div>
</BaseLayout>