---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import { SITE } from '@lib/constants';
---

<BaseLayout
  title={`Page not found — ${SITE.name}`}
  description="The page you're looking for doesn't exist. Try the homepage or browse all conversions."
  noindex={true}
  width="default"
>
  <div class="mx-auto max-w-prose text-center py-16">
    <p class="text-sm font-medium tracking-wider text-muted">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-3 text-base text-muted leading-relaxed">
      We couldn't find the page you were looking for. It may have moved, or
      the URL might be slightly off.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href="/" variant="primary" size="md">Back to home</Button>
      <Button href="/convert" variant="secondary" size="md">Browse conversions</Button>
    </div>
  </div>
</BaseLayout>