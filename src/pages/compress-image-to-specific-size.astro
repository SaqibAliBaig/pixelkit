---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
  buildCustomHowToJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress Image', href: '/compress-image/' },
  { label: 'Compress to Specific Size' },
];

const faqs = [
  {
    q: 'How do I compress an image to a specific size in KB or MB?',
    a: 'Drop your image into PixelKit, click the Compression Target dropdown, select "Custom KB" or pick an exact preset (like 50KB, 200KB, 1MB, or 2MB), and enter your exact file size number. PixelKit automatically iterates quality quantization levels inside your browser until the file lands strictly under your specified target.',
  },
  {
    q: 'Can I compress an image between a minimum and maximum specific size?',
    a: 'Yes. Switch the compression mode from "Under Max" to "Range". You can enter both a minimum (e.g. 20 KB) and maximum (e.g. 50 KB) limit. PixelKit will calibrate quality and pixel dimensions to keep the output inside both bounds.',
  },
  {
    q: 'Why do portals reject images even when they match the exact limit?',
    a: 'Certain web portals and upload forms enforce decimal size calculations (1,000 KB = 1 MB) or re-encode files upon upload, adding a tiny byte wrapper. Setting your target 2%–5% lower than the portal limit (for example, targeting 48KB instead of 50KB, or 1.9MB instead of 2MB) guarantees 100% acceptance.',
  },
  {
    q: 'Does compressing to a specific size upload my photos to an external server?',
    a: 'No. PixelKit executes all image decoding, resizing, and compression locally inside your device browser memory via WebAssembly. Your photos, private documents, and ID cards never leave your device.',
  },
];

const pageTitle = `Compress Image to Specific Size (Exact KB or MB) | ${SITE.name}`;
const pageDesc =
  'Compress images to any exact KB or MB file size. 100% private in-browser tool that automatically calculates target quantization with zero server uploads.';
const pageKeywords = [
  'compress image to specific size',
  'compress image to exact size',
  'compress photo to specific size',
  'compress image to specific kb',
  'compress image to custom size',
  'reduce image to specific size',
  'image compressor exact size',
  'compress image to 2mb',
  'compress image to 5mb',
  'compress image to 10mb',
];

const howToJsonLd = buildCustomHowToJsonLd({
  name: 'How to compress image to a specific size online',
  description: 'Step-by-step guide to shrink photos and document scans to an exact KB or MB limit.',
  steps: [
    {
      name: 'Upload your image',
      text: 'Drop any JPG, PNG, WebP, HEIC, or PDF file into the upload zone.',
    },
    {
      name: 'Set your specific size target',
      text: 'Select a preset (e.g. 50KB, 100KB, 1MB, 2MB) or choose Custom to enter your exact kilobyte limit.',
    },
    {
      name: 'Instant in-browser convergence',
      text: 'PixelKit runs an iterative binary-search algorithm in Web Workers to hit the highest possible visual clarity under your target.',
    },
    {
      name: 'Download your optimized file',
      text: 'Save your compressed file instantly with zero server uploads and zero privacy risks.',
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'Compress Image to Specific Size — PixelKit',
    description: pageDesc,
    url: new URL('/compress-image-to-specific-size/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  howToJsonLd,
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero -->
    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Custom KB &amp; MB Targets · 100% Private · No Guesswork</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Compress Image to Specific Size
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Dial in any exact file size target in kilobytes (KB) or megabytes (MB). Smart binary-search quantization ensures maximum image sharpness without exceeding your limit.
      </p>
    </header>

    <!-- Direct Answer Box -->
    <DirectAnswerBox
      title="How Specific Size Compression Works"
      summaryText="Unlike traditional tools that force you to guess arbitrary quality percentages (e.g. 70% or 80%), PixelKit lets you enter the exact number required by your portal (e.g. 50 KB, 200 KB, 2 MB, or 5 MB). The browser engine automatically converges to that exact limit in milliseconds."
      specs={[
        { label: 'Precision', value: 'Single-Kilobyte Accuracy', highlight: true },
        { label: 'Target Range', value: '10 KB up to 50 MB' },
        { label: 'Execution', value: 'Local WebAssembly & Web Workers', highlight: true },
        { label: 'Privacy', value: 'Zero Server Uploads' },
      ]}
    />

    <!-- Tool Preview -->
    <div class="mt-6 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={100}
        initialTool="compress"
      />
    </div>

    <!-- Quick Target Jump Section -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Jump to Common Specific Size Presets
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Select standard file size targets required across job, college, and government upload systems:
      </p>

      <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs sm:text-sm">
        <a href="/compress-image-to-50kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">50 KB Target</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Exam Headshots</div>
          <p class="text-muted mt-1 text-[11px]">UPSC, SSC, and state recruitment forms.</p>
        </a>
        <a href="/compress-image-to-100kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">100 KB Target</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">KYC &amp; Passports</div>
          <p class="text-muted mt-1 text-[11px]">Aadhaar, PAN card, and banking uploads.</p>
        </a>
        <a href="/compress-image-to-200kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">200 KB Target</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Visa DS-160</div>
          <p class="text-muted mt-1 text-[11px]">US embassy, passport, and university forms.</p>
        </a>
        <a href="/compress-image-to-1mb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">1 MB Target</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Corporate Email</div>
          <p class="text-muted mt-1 text-[11px]">Job applications, portfolios, and legal papers.</p>
        </a>
        <a href="/compress-image-to-2mb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">2 MB Target</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Workday &amp; MLS</div>
          <p class="text-muted mt-1 text-[11px]">US job boards, Common App, and real estate.</p>
        </a>
        <a href="/compress-image-to-5mb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">5 MB Target</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">IRS &amp; Print Proofs</div>
          <p class="text-muted mt-1 text-[11px]">Tax e-filing, financial forms, and high-res media.</p>
        </a>
        <a href="/compress-image-to-10mb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">10 MB Target</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Discord File Limit</div>
          <p class="text-muted mt-1 text-[11px]">Discord free uploads, Slack media, and 4K shots.</p>
        </a>
        <a href="/compress-image-to-pdf/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Image to PDF</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Multi-Page Scan</div>
          <p class="text-muted mt-1 text-[11px]">Convert and compress images into compact PDF.</p>
        </a>
      </div>

      <!-- Quick links row -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">All exact targets:</span>
        <a href="/compress-image-to-10kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">10KB</a>
        <a href="/compress-image-to-20kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">20KB</a>
        <a href="/compress-image-to-50kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">50KB</a>
        <a href="/compress-image-to-100kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">100KB</a>
        <a href="/compress-image-to-200kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">200KB</a>
        <a href="/compress-image-to-256kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">256KB</a>
        <a href="/compress-image-to-500kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">500KB</a>
        <a href="/compress-image-to-1mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">1MB</a>
        <a href="/compress-image-to-2mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">2MB</a>
        <a href="/compress-image-to-5mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">5MB</a>
        <a href="/compress-image-to-10mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">10MB</a>
      </div>
    </section>

    <!-- Guide -->
    <div class="mt-12 sm:mt-16">
      <PortalRequirementsGuide />
    </div>

    <!-- FAQ -->
    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>

