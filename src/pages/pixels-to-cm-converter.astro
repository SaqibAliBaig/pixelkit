---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import DimensionCalculator from '@components/converter/DimensionCalculator.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  {
    "label": "Home",
    "href": "/"
  },
  {
    "label": "Image Tools",
    "href": "/image-resizer-in-cm/"
  },
  {
    "label": "Pixels to CM Converter"
  }
];

const faqs = [
  {
    "q": "How many pixels are in 1 cm?",
    "a": "The number of pixels in 1 centimeter depends entirely on the DPI (resolution). At 300 DPI (print standard), 1 cm = 118.11 pixels. At 150 DPI, 1 cm = 59.06 pixels. At 72 DPI (web screen), 1 cm = 28.35 pixels."
  },
  {
    "q": "Can I resize my photo directly after calculating?",
    "a": "Yes. Use the dropzone above, enter your desired width and height in centimeters or pixels, and PixelKit will rescale your image client-side in under 1 second."
  }
];

const pageTitle = 'Pixels to CM Converter Online (At 300 DPI) — Free';
const pageDesc = 'Convert pixels to centimeters (cm) and millimeters (mm) at 300 DPI or custom DPI online. Free instant calculator and image resizer studio.';

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit Pixels to CM Converter Online',
    description: pageDesc,
    url: new URL('/pixels-to-cm-converter/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        <span>Interactive DPI Calculator & Instant Photo Resizer</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Pixels to CM Converter Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Instantly calculate centimeters and millimeters from pixel dimensions at 300 DPI or any custom resolution, then resize your photo in one click.
      </p>
    </header>

    <!-- GEO Direct Answer Definition Block -->
    <DirectAnswerBox
      title="Pixels to CM Conversion Formula (2026 Direct Answer)"
      summaryText="To convert pixels to centimeters: Centimeters = (Pixels × 2.54) ÷ DPI. At the standard print resolution of 300 DPI: 1 cm equals approximately 118.11 pixels, and 1 pixel equals 0.00846 cm. For example, a 413 × 531 pixel passport photo translates to exactly 3.5 × 4.5 cm at 300 DPI."
      portalName="Print & Dimension Conversion Standard"
      specs={[{"label":"Formula","value":"CM = (Pixels × 2.54) ÷ DPI","highlight":true},{"label":"At 300 DPI","value":"1 cm = 118.11 pixels","highlight":true},{"label":"At 72 DPI","value":"1 cm = 28.35 pixels"},{"label":"Passport (3.5×4.5cm)","value":"413 × 531 pixels @ 300 DPI"}]}
    />

    <div class="mt-6 sm:mt-8">
      <DimensionCalculator mode="px-to-cm" defaultDpi={300} />
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        initialTool="resize"
        initialUnit="px"
        initialWidth={413}
        initialHeight={531}
        initialDpi={300}
      />
    </div>

    <!-- Official Specification Table -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Common Pixel to Centimeter Dimensions at 300 DPI
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Quick reference guide for official document and photo sizes:
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-border bg-surface text-fg font-semibold">
              <th class="py-3 px-4">Standard Size Name</th>
              <th class="py-3 px-4">Dimensions in CM</th>
              <th class="py-3 px-4">Dimensions in Pixels (300 DPI)</th>
              <th class="py-3 px-4">Common Application</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            <tr>
              <td class="py-3 px-4 font-medium text-fg">Indian / UK / EU Passport</td>
              <td class="py-3 px-4 text-muted">3.5 × 4.5 cm</td>
              <td class="py-3 px-4 text-muted">413 × 531 px</td>
              <td class="py-3 px-4 text-muted">Passports, Visas, SSC & UPSC</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">US Visa / DS-160</td>
              <td class="py-3 px-4 text-muted">5.08 × 5.08 cm (2×2 in)</td>
              <td class="py-3 px-4 text-muted">600 × 600 px</td>
              <td class="py-3 px-4 text-muted">US Visa, Green Card Lottery</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">Stamp Size Photo</td>
              <td class="py-3 px-4 text-muted">2.5 × 3.5 cm</td>
              <td class="py-3 px-4 text-muted">295 × 413 px</td>
              <td class="py-3 px-4 text-muted">Identity badges, bus passes</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">Official Exam Signature</td>
              <td class="py-3 px-4 text-muted">4.0 × 2.0 cm</td>
              <td class="py-3 px-4 text-muted">472 × 236 px</td>
              <td class="py-3 px-4 text-muted">SSC, Banking & State exams</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">Standard Postcard</td>
              <td class="py-3 px-4 text-muted">10.0 × 15.0 cm (4×6 in)</td>
              <td class="py-3 px-4 text-muted">1181 × 1772 px</td>
              <td class="py-3 px-4 text-muted">NEET Postcard Photo</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">A4 Document Sheet</td>
              <td class="py-3 px-4 text-muted">21.0 × 29.7 cm</td>
              <td class="py-3 px-4 text-muted">2480 × 3508 px</td>
              <td class="py-3 px-4 text-muted">Document print & scan standard</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Technical Principles Section -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Why In-Browser Processing is Essential for Sensitive Photos &amp; IDs
      </h2>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs sm:text-sm text-muted leading-relaxed">
        <div class="p-4 rounded-xl bg-surface/50 border border-border/50">
          <h3 class="font-semibold text-fg text-sm mb-1.5 flex items-center gap-1.5">
            <span>🔒</span> Zero Cloud Uploads
          </h3>
          <p>Signatures, Aadhaar IDs, and passport photos are sensitive personal biometric assets. PixelKit processes all operations locally in browser RAM.</p>
        </div>
        <div class="p-4 rounded-xl bg-surface/50 border border-border/50">
          <h3 class="font-semibold text-fg text-sm mb-1.5 flex items-center gap-1.5">
            <span>⚡</span> Sub-Second Quantization
          </h3>
          <p>Powered by WebAssembly and Canvas binary-search encoding, resizing and compressing takes under 200ms with zero server latency.</p>
        </div>
        <div class="p-4 rounded-xl bg-surface/50 border border-border/50">
          <h3 class="font-semibold text-fg text-sm mb-1.5 flex items-center gap-1.5">
            <span>🎯</span> Portal Pass Guarantee
          </h3>
          <p>Dimensions, aspect ratios, and KB file limits are locked directly to the official government guidelines for immediate intake clearance.</p>
        </div>
      </div>
    </section>

    <FAQSection faqs={faqs} />
  </div>
</BaseLayout>
