const { spec } = Astro.props as { spec: JpgKbTargetSpec };
const allSizes = [10, 15, 20, 30, 40, 50, 80, 100, 150, 200, 256, 300, 500];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress JPG', href: '/compress-jpg/' },
  { label: `Compress JPG to ${spec.size}KB` },
];

const faqs = [
  {
    q: `How do I compress a JPG to ${spec.size}KB without losing quality?`,
    a: `Drop your JPG or JPEG image into the tool above. PixelKit pre-configures a ${spec.size}KB ceiling and runs a 12-iteration binary search algorithm in browser Web Workers to find the highest perceptual quality level that fits strictly at or below ${spec.size}KB.`,
  },
  {
    q: `How can I compress JPG to ${spec.size}KB on mobile (Android and iPhone)?`,
    a: `PixelKit runs 100% locally in mobile Chrome, Safari, and Firefox. You can select photos directly from your phone gallery or camera and compress JPG to ${spec.size}KB in seconds without downloading any apps.`,
  },
  {
    q: `Why do government exam portals reject JPGs over ${spec.size}KB?`,
    a: `Portals for SSC, UPSC, NEET, IBPS, and state PSCs receive millions of applications. To prevent server overload, they enforce strict file size gates (such as 20KB–50KB or under ${spec.size}KB). PixelKit ensures your JPG meets these requirements with 100% acceptance.`,
  },
  {
    q: `Can I crop and resize dimensions before compressing JPG to ${spec.size}KB?`,
    a: `Yes. Click "Crop Studio" to set aspect ratios (1:1, 3:4, 3.5:4.5) or "Scale & Resize" to set exact pixel dimensions (like 350 × 450 px) before downloading your ${spec.size}KB JPG file.`,
  },
  {
    q: `Are my private photos and document scans uploaded to an external server?`,
    a: `Never. PixelKit is 100% client-side. Every JPG decode, crop, resize, and ${spec.size}KB compression pass runs locally in your device's browser memory. Your files never touch an external server.`,
  },
];

const pageTitle = `Compress JPG to ${spec.size}KB Online (Free & Fast) | ${SITE.name}`;
const pageDesc = `Free online tool to compress JPG to ${spec.size}KB, reduce JPEG size to ${spec.size}KB, or compress photo to ${spec.size}KB without losing quality. 100% private in-browser compression.`;
const pageKeywords = [
  `compress jpg to ${spec.size}kb`,
  `compress jpg to ${spec.size} kb`,
  `compress jpeg to ${spec.size}kb`,
  `compress jpeg to ${spec.size} kb`,
  `reduce jpg size to ${spec.size}kb`,
  `reduce jpeg to ${spec.size}kb`,
  `compress jpg to ${spec.size}kb online`,
  `compress photo to ${spec.size}kb jpg`,
  `jpg to ${spec.size}kb converter`,
  `jpg compressor ${spec.size}kb`,
  `resize jpg to ${spec.size}kb`,
  `photo resizer in kb jpg`,
];

const howToJsonLd = buildCustomHowToJsonLd({
  name: `How to compress JPG to ${spec.size}KB online`,
  description: `Step-by-step guide to compress JPG and JPEG files strictly under ${spec.size}KB without blurriness or server uploads.`,
  steps: [
    {
      name: 'Upload your JPG photo',
      text: 'Drop or select your JPG, JPEG, or phone camera photo into PixelKit.',
    },
    {
      name: `Automatic ${spec.size}KB Target Convergence`,
      text: `PixelKit automatically configures the target file size to ${spec.size}KB and runs binary-search quantization.`,
    },
    {
      name: 'Optional Crop & Resize',
      text: 'Optionally adjust aspect ratio (e.g. 3.5 × 4.5 cm passport) or scale pixel dimensions to match portal specs.',
    },
    {
      name: `Download compressed ${spec.size}KB JPG`,
      text: `Save your compliant JPG file instantly. Zero server uploads and zero privacy risks.`,
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: `Compress JPG to ${spec.size}KB — PixelKit`,
    description: pageDesc,
    url: new URL(`/compress-jpg-to-${spec.size}kb/`, SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  howToJsonLd,
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>{spec.badge}</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        {spec.headline}
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        {spec.portalSummary}
      </p>
    </header>

    <!-- Direct Answer GEO Box -->
    <DirectAnswerBox
      title={`How to Compress JPG to ${spec.size}KB Fast`}
      summaryText={`To compress a JPG to ${spec.size}KB, drop your image into PixelKit. The browser executes an iterative binary-search quantization algorithm inside a Web Worker, converging on the highest possible visual clarity that stays strictly at or below ${spec.size}KB without uploading files to remote servers.`}
      specs={[
        { label: 'Target File Size', value: `Strictly ≤ ${spec.size} KB (Max ${spec.size} KB)`, highlight: true },
        { label: 'Input Formats', value: 'JPG, JPEG, PNG, WebP, HEIC (iPhone), PDF' },
        { label: 'Output Format', value: 'Optimized JPEG (.jpg)', highlight: true },
        { label: 'Privacy Guarantee', value: '100% Client-Side / Zero Server Logging' },
      ]}
    />

    <!-- Interactive Tool -->
    <div class="mt-6 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={spec.size}
        initialTool="compress"
      />
    </div>

    <!-- Practical Use Cases Grid -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Official Use Cases for {spec.size}KB JPG Compression
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Common recruitment portals, exam forms, and document upload slots requiring JPG under {spec.size}KB:
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs sm:text-sm">
        {spec.useCases.map((uc) => (
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <div class="font-bold text-fg">{uc.title}</div>
            <div class="font-mono text-accent text-xs mt-1">{uc.dims}</div>
            <p class="text-muted mt-1.5 text-xs leading-relaxed">{uc.body}</p>
          </div>
        ))}
      </div>

      <!-- Quick Links to other sizes -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Other JPG KB Targets:</span>
        {allSizes.map((sz) => (
          <a
            href={`/compress-jpg-to-${sz}kb/`}
            class={`rounded-lg border px-2.5 py-1 font-medium transition-colors ${
              sz === spec.size
                ? 'border-accent bg-accent/15 text-accent font-semibold'
                : 'border-border bg-bg text-fg hover:border-accent hover:text-accent'
            }`}
          >
            {sz}KB
          </a>
        ))}
        <a href="/compress-jpg-to-pdf/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">JPG to PDF →</a>
      </div>
    </section>

    <!-- Technical Guide on JPEG Compression -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        How Binary Search JPEG Compression Retains Maximum Detail
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Unlike primitive online image resizers that blindly set arbitrary compression values (e.g. 70%), PixelKit performs an intelligent binary search across the JPEG Discrete Cosine Transform (DCT) quantization tables.
        </p>
        <p>
          In under 30 milliseconds, the engine evaluates up to 12 quality levels in parallel Web Workers to isolate the precise mathematical inflection point where visual sharpness is maximized while file weight remains safely under {spec.size}KB.
        </p>
        <div class="rounded-xl border border-accent/20 bg-accent/5 p-4 text-xs sm:text-sm text-fg/90">
          <strong class="text-accent font-semibold">Pro Tip:</strong> {spec.tip}
        </div>
      </div>
    </section>

    <!-- Official Portal Specs Guide -->
    <div class="mt-12 sm:mt-16">
      <PortalRequirementsGuide />
    </div>

    <!-- FAQ Section -->
    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>

