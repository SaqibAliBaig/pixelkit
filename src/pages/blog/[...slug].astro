---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogLayout from '@layouts/BlogLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
};

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const { Content } = await post.render();

// Related combos — supports "{from}-to-{to}", "{from}-to-{to}-under-{size}kb",
// "compress-image-to-{size}kb", "compress-{format}", and "passport-photo-resizer".
const related = (post.data.relatedCombos ?? [])
  .map((slug: string) => {
    if (slug === 'passport-photo-resizer') {
      return { label: 'Passport Photo Resizer & Compressor', href: `/${slug}` };
    }
    const kbOnly = slug.match(/^compress-image-to-(\d+)kb$/);
    if (kbOnly?.[1]) {
      return { label: `Compress Image to ${kbOnly[1]}KB`, href: `/${slug}` };
    }
    const fmtOnly = slug.match(/^compress-([a-z]+)$/);
    if (fmtOnly?.[1]) {
      return { label: `Compress ${fmtOnly[1].toUpperCase()} Online`, href: `/${slug}` };
    }
    const m = slug.match(/^([a-z]+)-to-([a-z]+)(?:-under-(\d+)kb)?$/);
    if (!m) return null;
    const [, from, to, size] = m;
    if (!from || !to) return null;
    const label = size
      ? `${from.toUpperCase()} to ${to.toUpperCase()} under ${size}KB`
      : `${from.toUpperCase()} to ${to.toUpperCase()}`;
    const href = `/${slug}`;
    return { label, href };
  })
  .filter((x): x is { label: string; href: string } => x !== null);

const cover = post.data.cover?.src ?? undefined;
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  author={post.data.author}
  tags={post.data.tags}
  cover={cover}
  related={related}
>
  <Content />
</BlogLayout>
