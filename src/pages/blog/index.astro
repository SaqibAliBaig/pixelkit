---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@lib/constants';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `Blog — ${SITE.name}`,
    description: 'Practical guides on file formats, portals, compression, and getting your upload accepted on the first try.',
    url: new URL('/blog', SITE.url).href,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      url: new URL(`/blog/${p.slug}`, SITE.url).href,
      datePublished: p.data.publishedAt.toISOString(),
      dateModified: (p.data.updatedAt ?? p.data.publishedAt).toISOString(),
    })),
  },
];
---

<BaseLayout
  title={`Blog — ${SITE.name}`}
  description="Practical guides on file formats, portals, compression, and getting your upload accepted on the first try."
  jsonLd={jsonLd}
  width="default"
>
  <div class="mx-auto max-w-3xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mt-5 sm:mt-8">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1 text-[11px] text-muted font-medium mb-3">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Guides &amp; Optimization</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-fg">
        PixelKit Blog
      </h1>
      <p class="mt-2 sm:mt-3 text-xs sm:text-base text-muted leading-relaxed">
        Practical guides on file formats, portal upload requirements, image compression, and privacy.
      </p>
    </header>

    <ul class="mt-6 sm:mt-10 space-y-3 sm:space-y-4">
      {posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.slug}`}
            class="group block rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 transition-all hover:border-accent/40 hover:bg-surface hover:shadow-sm active:scale-[0.99] shadow-xs"
          >
            <div class="flex items-center justify-between gap-2 text-[11px] sm:text-xs text-muted">
              <time datetime={post.data.publishedAt.toISOString()} class="font-medium">
                {post.data.publishedAt.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <span class="inline-flex items-center gap-1 text-accent font-semibold group-hover:translate-x-0.5 transition-transform text-[11px] sm:text-xs">
                <span>Read article</span>
                <span>→</span>
              </span>
            </div>

            <h2 class="mt-2 text-base sm:text-xl font-bold text-fg group-hover:text-accent transition-colors leading-snug">
              {post.data.title}
            </h2>

            <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed line-clamp-3 sm:line-clamp-none">
              {post.data.description}
            </p>

            {post.data.tags.length > 0 && (
              <ul class="mt-3.5 flex flex-wrap gap-1.5">
                {post.data.tags.map((t) => (
                  <li>
                    <span class="inline-flex items-center rounded-md border border-border bg-bg/60 px-2 py-0.5 text-[10px] sm:text-[11px] font-medium text-muted">
                      #{t}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>