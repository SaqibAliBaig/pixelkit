---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
  buildCustomHowToJsonLd,
} from '@lib/seo/jsonld';

interface ResizeSpec {
  size: number;
  headline: string;
  badge: string;
  summary: string;
  useCases: { title: string; dims: string; body: string }[];
  tip: string;
}

export const getStaticPaths: GetStaticPaths = () => {
  const specs: ResizeSpec[] = [
    {
      size: 20,
      headline: 'Resize Image to 20KB Online',
      badge: 'Signatures · Thumbprints · Exam Portals',
      summary:
        'Resize image dimensions and compress file size strictly under 20KB online. Engineered for SSC, UPSC, IBPS, and state recruitment signature and thumbprint upload slots.',
      useCases: [
        {
          title: 'Candidate Signatures',
          dims: '140 × 60 px · 10–20 KB',
          body: 'Crop tightly around ink strokes on white paper so signature lines stay crisp and legible under 20KB.',
        },
        {
          title: 'Left Thumb Impressions',
          dims: '240 × 240 px · Under 20 KB',
          body: 'Preserve ridge pattern contrast on scanned thumbprints required by banking and recruitment portals.',
        },
        {
          title: 'Compact Applicant Avatars',
          dims: '200 × 230 px · 15–20 KB',
          body: 'Scale pixel dimensions and compress simultaneously to keep facial biometrics clear at ultra-low sizes.',
        },
      ],
      tip: 'For 20KB targets on high-res phone camera photos, use Crop Studio to trim background borders or set width to 350–500 px before downloading.',
    },
    {
      size: 30,
      headline: 'Resize Image to 30KB Online',
      badge: 'UPSSSC · MPPEB · State Exam Photos',
      summary:
        'Resize image dimensions to passport size and compress to 30KB online without losing clarity. Built for UPSSSC PET, MPPEB, APPSC, and state exam portals requiring 20KB–30KB.',
      useCases: [
        {
          title: 'UPSSSC & State PET Headshots',
          dims: '350 × 450 px · 20–30 KB',
          body: 'Crop passport-style photos to 3.5 × 4.5 cm and land safely between 20KB and 30KB in a single click.',
        },
        {
          title: 'Railway RRB Photos',
          dims: 'JPG · Under 30 KB',
          body: 'Retain clear eyes, ears, and background contrast for automated facial recognition matching.',
        },
        {
          title: 'College Admission Forms',
          dims: 'JPG · Max 30 KB',
          body: 'Compress student identity photos for state university admission portals.',
        },
      ],
      tip: 'Need between 20KB and 30KB? Use Range mode in Settings to set min 20KB and max 30KB for 100% portal acceptance.',
    },
    {
      size: 50,
      headline: 'Resize Image to 50KB Online',
      badge: 'SSC CGL/CHSL · UPSC · NEET Exam Photos',
      summary:
        'Resize image to 50KB online with zero blur. The definitive image resizer for SSC CGL, CHSL, MTS, UPSC Civil Services, and NEET passport photo uploads enforcing 20KB–50KB brackets.',
      useCases: [
        {
          title: 'SSC CGL, CHSL, MTS Photos',
          dims: '350 × 450 px (3.5 × 4.5 cm) · 20–50 KB',
          body: 'Auto-frame with 80% face coverage and compress safely to 35–45 KB to pass automated portal verification.',
        },
        {
          title: 'UPSC Civil Services OTR Headshot',
          dims: '350 × 350 to 1000 × 1000 px · 20–50 KB',
          body: 'Compress crisp formal portraits for One Time Registration (OTR) without visual noise.',
        },
        {
          title: 'PAN Card Applicant Photo',
          dims: '213 × 213 px at 200/300 DPI · Under 50 KB',
          body: 'Meet exact NSDL and UTIITSL criteria for instant PAN card application approvals.',
        },
      ],
      tip: 'For SSC and UPSC, use PixelKit’s "SSC Photo Resizer" preset to apply 3.5 × 4.5 cm cropping and 50KB compression in one click.',
    },
    {
      size: 100,
      headline: 'Resize Image to 100KB Online',
      badge: 'Aadhaar · Passports · Job Portals · KYC',
      summary:
        'Resize image to 100KB online for free without losing quality. Ideal for Aadhaar card updates, Indian Passport Seva, bank KYC, and job portals enforcing strict 100KB limits.',
      useCases: [
        {
          title: 'Aadhaar Card Updates & Enrolment',
          dims: 'JPG · Under 100 KB',
          body: 'Compress identity proofs and applicant headshots for UIDAI portal submissions.',
        },
        {
          title: 'Passport Seva Online Portal',
          dims: '413 × 531 px (35 × 45 mm) · 20–100 KB',
          body: 'Standard 300 DPI passport specifications for Indian Ministry of External Affairs online submissions.',
        },
        {
          title: 'Corporate Job Portals & KYC',
          dims: 'JPG / PNG · Under 100 KB',
          body: 'Upload employee badges, resumes, and bank identity cards to Workday, Taleo, and banking portals.',
        },
      ],
      tip: 'Need document proof scans in PDF format under 100KB? You can switch output format to PDF right inside PixelKit.',
    },
    {
      size: 200,
      headline: 'Resize Image to 200KB Online',
      badge: 'NEET Exam Cards · Schengen Visas · College Portals',
      summary:
        'Resize image to 200KB online with sharp details. Perfect for NTA NEET postcard photos, Schengen visa applications, and university intake forms requiring uploads under 200KB.',
      useCases: [
        {
          title: 'NTA NEET Postcard Photo',
          dims: '4" × 6" Postcard · 10–200 KB',
          body: 'Format large postcard photos with candidate name and date stamp for examination hall identity verification.',
        },
        {
          title: 'Schengen European Visa Photos',
          dims: '35 × 45 mm · Max 200 KB',
          body: 'Meet biometric visa regulations with uniform light grey/white background and zero compression artifacts.',
        },
        {
          title: 'University & Board Exam Registrations',
          dims: 'JPG / WebP · Under 200 KB',
          body: 'Shrink high-resolution graduation photos and certificates without unreadable blurred text.',
        },
      ],
      tip: '200KB provides plenty of headroom for crystal-clear 1200 × 1600 px portraits while easily passing upload gates.',
    },
    {
      size: 500,
      headline: 'Resize Image to 500KB Online',
      badge: 'High-Res Portfolios · Real Estate · Web Graphics',
      summary:
        'Resize image to 500KB online for crystal-clear web graphics, real estate listings, portfolios, and high-definition photography with fast load times.',
      useCases: [
        {
          title: 'E-Commerce & Shopify Products',
          dims: '2048 × 2048 px · Under 500 KB',
          body: 'Maintain retina zoom clarity while boosting page load speed and Google Core Web Vitals scores.',
        },
        {
          title: 'Real Estate MLS Listings',
          dims: '1920 × 1080 px · Under 500 KB',
          body: 'Deliver rich interior and architectural photography within MLS image byte limits.',
        },
        {
          title: 'High-DPI Web Hero Banners',
          dims: '2560 × 1440 px · Under 500 KB',
          body: 'Display vibrant homepage headers that render instantly on mobile networks.',
        },
      ],
      tip: 'For web images, converting to modern WebP format gives 30% higher visual quality at the exact same 500KB size compared to legacy JPEG.',
    },
  ];

  return specs.map((spec) => ({
    params: { size: String(spec.size) },
    props: { spec, allSizes: specs.map((s) => s.size) },
  }));
};

interface Props {
  spec: ResizeSpec;
  allSizes: number[];
}

const { spec, allSizes } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Resize Image', href: '/resize-image/' },
  { label: `Resize Image to ${spec.size}KB` },
];

const faqs = [
  {
    q: `How do I resize an image to ${spec.size}KB online?`,
    a: `Upload your image (JPG, PNG, WebP, or iPhone HEIC) to PixelKit. The tool is pre-configured with a target limit of ${spec.size}KB. Click "Download" to immediately get your perfectly resized file. You can also adjust dimensions (pixels or cm) in the Scale & Resize section before saving.`,
  },
  {
    q: `Will resizing my image to ${spec.size}KB make it blurry or lose quality?`,
    a: `No. PixelKit uses a 12-iteration binary search algorithm in local browser Web Workers. It selects the absolute highest mathematical quality level that stays strictly within ${spec.size}KB, preserving sharp facial features, signature lines, and text.`,
  },
  {
    q: `Can I resize an image to ${spec.size}KB on Android or iPhone?`,
    a: `Yes. PixelKit works directly in your mobile browser (Safari, Chrome, Firefox). Select photos straight from your camera roll or gallery and resize to ${spec.size}KB without installing any app.`,
  },
  {
    q: `Is resizing to ${spec.size}KB safe for confidential government documents?`,
    a: `Yes, 100%. PixelKit operates completely client-side in your device memory. Your photos, biometric signatures, and identity documents are never uploaded to any remote server or stored in any cloud database.`,
  },
  {
    q: `What if my image is already smaller than ${spec.size}KB?`,
    a: `If your portal specifies a minimum file size (for example, SSC requires 20KB to 50KB), you can use PixelKit's "Increase Image Size in KB" tool to safely add standard metadata padding to reach the required range without visual distortion.`,
  },
];

const directAnswer = {
  question: `How to resize an image to ${spec.size}KB online for free?`,
  answer: `To resize an image to ${spec.size}KB online, drop your JPG, PNG, or HEIC photo into PixelKit. The tool automatically applies a ${spec.size}KB target ceiling and high-precision bicubic resampling. Click Download for an instant, compliant file with zero server uploads and zero watermarks.`,
};

const pageTitle = `Resize Image to ${spec.size}KB Online (Free & Fast) | ${SITE.name}`;
const pageDesc = `Resize image to ${spec.size}KB online for free. Compress JPG, PNG, and HEIC photos strictly under ${spec.size}KB with exact dimensions for SSC, UPSC, passports, and job portals.`;
const pageKeywords = [
  `resize image to ${spec.size}kb`,
  `resize image to ${spec.size} kb`,
  `how to resize image to ${spec.size}kb`,
  `online resize image to ${spec.size}kb`,
  `resize photo to ${spec.size}kb`,
  `resize picture to ${spec.size}kb`,
  `image resizer ${spec.size}kb`,
  `compress image to ${spec.size}kb`,
  `reduce image size to ${spec.size}kb`,
  'online image resizer',
  'image resizer in kb',
];

const howToJsonLd = buildCustomHowToJsonLd({
  name: `How to resize an image to ${spec.size}KB online`,
  description: `Step-by-step guide to resizing image dimensions and file size to ${spec.size}KB using PixelKit.`,
  steps: [
    {
      name: 'Upload photo or document',
      text: `Select or drag and drop your image (JPG, PNG, HEIC, WebP) into the ${spec.size}KB resizer tool.`,
    },
    {
      name: 'Adjust dimensions (optional)',
      text: 'If needed, select exam passport presets (3.5 × 4.5 cm) or custom pixel dimensions in Scale & Resize.',
    },
    {
      name: 'Download resized image',
      text: `PixelKit automatically compresses the image strictly under ${spec.size}KB. Click "Download" to save immediately.`,
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: `PixelKit Resize Image to ${spec.size}KB Tool`,
    description: pageDesc,
    path: `/resize-image-to-${spec.size}kb/`,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (Web Browser)',
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(breadcrumbs),
  howToJsonLd,
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={`https://pixelkit.app/resize-image-to-${spec.size}kb/`}
  keywords={pageKeywords}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mt-4 sm:mt-6 text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-xs font-semibold text-accent">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        {spec.badge}
      </div>
      <h1 class="mt-3 text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-fg">
        {spec.headline}
      </h1>
      <p class="mx-auto mt-2 max-w-2xl text-xs sm:text-sm text-muted">
        {spec.summary}
      </p>
    </header>

    <!-- Direct Answer Box (GEO / AI Overview) -->
    <div class="mt-6 sm:mt-8">
      <DirectAnswerBox
        title={`How to Resize an Image to ${spec.size}KB Online`}
        summaryText={directAnswer.answer}
        specs={[
          { label: 'Target File Size', value: `Strictly ≤ ${spec.size} KB (Max ${spec.size} KB)`, highlight: true },
          { label: 'Dimension Controls', value: 'Pixels (px), Millimeters (mm), Passport Presets' },
          { label: 'Output Format', value: 'Optimized JPEG / WebP / PNG', highlight: true },
          { label: 'Privacy Guarantee', value: '100% Client-Side / Zero Server Logging' },
        ]}
      />
    </div>

    <!-- Active Tool Studio Pre-configured to target size -->
    <main class="mt-6 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={spec.size}
        initialTool="resize"
      />
    </main>

    <!-- Official Use Cases Section -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Official Use Cases for Resizing to {spec.size}KB
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Common recruitment portals, exam forms, and document upload slots requiring images under {spec.size}KB:
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs sm:text-sm">
        {spec.useCases.map((uc) => (
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <div class="font-bold text-fg">{uc.title}</div>
            <div class="font-mono text-accent text-xs mt-1">{uc.dims}</div>
            <p class="text-muted mt-1.5 text-xs leading-relaxed">{uc.body}</p>
          </div>
        ))}
      </div>

      <!-- Quick Links to other sizes -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Other Sizes:</span>
        {allSizes.map((sz) => (
          <a
            href={`/resize-image-to-${sz}kb/`}
            class={`rounded-lg border px-2.5 py-1 font-medium transition-colors ${
              sz === spec.size
                ? 'border-accent bg-accent/15 text-accent font-semibold'
                : 'border-border bg-bg text-fg hover:border-accent hover:text-accent'
            }`}
          >
            {sz}KB
          </a>
        ))}
        <a href="/resize-image-to-20kb-to-50kb/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Resize to 20KB–50KB (SSC/UPSC) →</a>
        <a href="/image-resizer-in-kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Image Resizer in KB</a>
      </div>
    </section>

    <!-- Technical Guide on Resizing & Quantization -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        How PixelKit Resizes Images to {spec.size}KB Without Losing Quality
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Traditional online image resizers either distort aspect ratios or aggressively compress photos into pixelated artifacts. PixelKit takes a precision dual-stage engineering approach:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm text-muted">
          <li>
            <strong class="text-fg">Bicubic Spatial Interpolation:</strong> Resamples pixel grid dimensions smoothly using multi-threaded Web Workers, preventing jagged edges and pixelation.
          </li>
          <li>
            <strong class="text-fg">12-Step Binary Quantization Search:</strong> Runs up to 12 iterative test renders in milliseconds to find the highest possible image quality (SSIM &gt; 0.98) that fits strictly within {spec.size}KB.
          </li>
          <li>
            <strong class="text-fg">Privacy-Guaranteed Client Execution:</strong> 100% of the computation happens directly on your device. No photos or biometric scans are ever sent to an external server.
          </li>
        </ul>
        <div class="rounded-xl border border-accent/20 bg-accent/5 p-4 text-xs sm:text-sm text-fg/90">
          <strong class="text-accent font-semibold">Pro Tip:</strong> {spec.tip}
        </div>
      </div>
    </section>

    <!-- Official Portal Specs Guide -->
    <div class="mt-12 sm:mt-16">
      <PortalRequirementsGuide />
    </div>

    <!-- FAQ Section -->
    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>
