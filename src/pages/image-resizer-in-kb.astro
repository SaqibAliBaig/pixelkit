---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
  buildCustomHowToJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image Resizer', href: '/resize-image/' },
  { label: 'Image Resizer in KB' },
];

const faqs = [
  {
    q: 'How does an online image resizer in KB work?',
    a: 'PixelKit executes a dual-stage resizing process directly in your browser: first, it scales pixel dimensions using bicubic interpolation (e.g., 350 × 450 px or 200 × 230 px). Second, it runs a 12-iteration binary search loop across quantization tables to guarantee the resulting file weight strictly satisfies your specified KB ceiling (such as 20KB, 50KB, or 100KB).',
  },
  {
    q: 'Can I resize an image to 50KB or 20KB for government job portals?',
    a: 'Yes. PixelKit has dedicated 1-click presets for SSC (20–50 KB), UPSC (20–300 KB), NTA NEET (10–200 KB), and digital signatures (10–20 KB). You can also enter any custom KB target.',
  },
  {
    q: 'Will resizing an image in KB make it blurry or distorted?',
    a: 'No. PixelKit does not blindly blur your image. It optimizes high-frequency chrominance data and strips unnecessary EXIF camera bloat while preserving sharp edges on text, ink signatures, and facial features.',
  },
  {
    q: 'Can I resize images in KB on mobile (Android and iPhone)?',
    a: 'Yes. PixelKit runs 100% locally in mobile Chrome, Safari, and Firefox. You can pick photos directly from your phone gallery or camera and resize them in KB without installing any apps.',
  },
  {
    q: 'How do I resize an image in KB and pixels simultaneously?',
    a: 'In PixelKit, click "Scale & Resize" to set your required pixel dimensions (such as 350 × 450 px or 600 × 600 px). Then select your target file size limit in KB (e.g. 50KB or 20KB). PixelKit applies smooth bicubic resampling to adjust the pixel grid and runs a 12-iteration binary search to lock the file weight under your exact KB budget in JPG format.',
  },
  {
    q: 'How do I increase image size in KB if my photo is below the portal minimum?',
    a: 'If a portal rejects your image because it is under the minimum size (e.g., SSC or UPSC requiring at least 20KB, but your photo is 15KB), use PixelKit’s "Increase Image Size in KB" tool. It safely adds standard ISO/IEC metadata comment padding to elevate the file weight above 20KB with zero pixel degradation or blurring.',
  },
  {
    q: 'Are my confidential documents or photos uploaded to any server?',
    a: 'Never. PixelKit is 100% client-side. Every image resize and compression pass runs locally in your device’s browser memory via Web Workers and WebAssembly. Your photos never leave your device.',
  },
];

const pageTitle = `Image Resizer in KB Online (Exact KB & Pixel Resizer) | ${SITE.name}`;
const pageDesc =
  'Free online image resizer in KB to resize image dimensions and compress file size strictly to 20KB, 50KB, 100KB, or 200KB. Fast, 100% private in-browser tool.';
const pageKeywords = [
  'image resizer in kb',
  'online image resizer in kb',
  'image resizer in kb online',
  'image resizer in kb jpg',
  'image resizer in kb and pixels',
  'increase image resizer in kb',
  'simple image resizer in kb',
  'image resizer 50kb',
  'image resizer 100kb',
  'image resizer 20kb',
  'image resizer in pixels',
  'image resizer in cm',
  'resize image in kb',
  'photo resizer in kb',
];

const howToJsonLd = buildCustomHowToJsonLd({
  name: 'How to resize an image in KB online',
  description: 'Step-by-step instructions to scale image dimensions and compress file weight strictly under your portal KB limit.',
  steps: [
    {
      name: 'Upload your image',
      text: 'Drop or select your image (JPG, PNG, WebP, or HEIC) into PixelKit.',
    },
    {
      name: 'Adjust dimensions or aspect ratio',
      text: 'Optionally choose passport dimensions (3.5 × 4.5 cm, 200 × 230 px) or custom width and height.',
    },
    {
      name: 'Set target KB ceiling',
      text: 'Pick an exact target limit (such as 20KB, 50KB, 100KB, or 200KB) to meet portal requirements.',
    },
    {
      name: 'Download resized file',
      text: 'Save your compliant, optimized image instantly with zero server uploads and zero privacy risks.',
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'Image Resizer in KB — PixelKit',
    description: pageDesc,
    url: new URL('/image-resizer-in-kb/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  howToJsonLd,
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Dual Dimension &amp; File Size Scaling · 100% Client-Side · Zero Blurring</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Image Resizer in KB Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Resize image dimensions in pixels or centimeters—and lock file size strictly under 20KB, 50KB, 100KB, or 200KB. Perfect for government jobs, exams, passports, and web speed.
      </p>
    </header>

    <!-- Direct Answer GEO Box -->
    <DirectAnswerBox
      title="How to Resize an Image in KB for Online Application Forms"
      summaryText="To resize an image in KB, upload your file to PixelKit. Enter your required pixel dimensions (or pick a portal preset like 3.5 × 4.5 cm) and choose an exact kilobyte target (like 50 KB or 20 KB). PixelKit resamples the pixel matrix using bicubic interpolation and applies iterative quantization search in browser Web Workers, guaranteeing 100% portal acceptance without distorting your image."
      specs={[
        { label: 'Target Size Options', value: '20 KB, 50 KB, 100 KB, 200 KB, 500 KB, Custom KB', highlight: true },
        { label: 'Dimension Controls', value: 'Pixels (px), Millimeters (mm), Centimeters (cm)' },
        { label: 'Supported Formats', value: 'JPG, PNG, WebP, HEIC (iPhone), PDF', highlight: true },
        { label: 'Privacy Guarantee', value: '100% Client-Side / Zero Server Logging' },
      ]}
    />

    <!-- Interactive Tool -->
    <div class="mt-6 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={50}
        initialTool="resize"
      />
    </div>

    <!-- Official Portal Dimensions & KB Limits Table -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Official Image Resizer in KB Requirements Table
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Common recruitment portals requiring combined pixel dimensions and strict KB ceilings:
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-border bg-bg/60">
              <th class="py-3 px-4 font-semibold text-fg">Application / Portal</th>
              <th class="py-3 px-4 font-semibold text-fg">Required Dimensions</th>
              <th class="py-3 px-4 font-semibold text-accent">Target Size in KB</th>
              <th class="py-3 px-4 font-semibold text-fg">Format</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            <tr>
              <td class="py-3 px-4 font-medium text-fg">SSC (CGL, CHSL, MTS, GD)</td>
              <td class="py-3 px-4 text-muted">3.5 × 4.5 cm (350 × 450 px)</td>
              <td class="py-3 px-4 font-mono font-semibold text-accent">20 KB – 50 KB</td>
              <td class="py-3 px-4 text-xs font-mono text-muted">JPG / JPEG</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">UPSC Civil Services / NDA</td>
              <td class="py-3 px-4 text-muted">350 × 350 to 1000 × 1000 px</td>
              <td class="py-3 px-4 font-mono font-semibold text-accent">20 KB – 300 KB</td>
              <td class="py-3 px-4 text-xs font-mono text-muted">JPG / JPEG</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">UPSC Digital Signature</td>
              <td class="py-3 px-4 text-muted">2:1 Ratio (280 × 140 px)</td>
              <td class="py-3 px-4 font-mono font-semibold text-accent">10 KB – 20 KB</td>
              <td class="py-3 px-4 text-xs font-mono text-muted">JPG / JPEG</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">NTA NEET / JEE Main</td>
              <td class="py-3 px-4 text-muted">3.5 × 4.5 cm (80% face coverage)</td>
              <td class="py-3 px-4 font-mono font-semibold text-accent">10 KB – 200 KB</td>
              <td class="py-3 px-4 text-xs font-mono text-muted">JPG / JPEG</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">PAN Card (NSDL / UTIITSL)</td>
              <td class="py-3 px-4 text-muted">213 × 213 px (200/300 DPI)</td>
              <td class="py-3 px-4 font-mono font-semibold text-accent">Under 50 KB</td>
              <td class="py-3 px-4 text-xs font-mono text-muted">JPG / JPEG</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">US Visa &amp; DS-160</td>
              <td class="py-3 px-4 text-muted">2 × 2 inches (600 × 600 px)</td>
              <td class="py-3 px-4 font-mono font-semibold text-accent">Under 240 KB</td>
              <td class="py-3 px-4 text-xs font-mono text-muted">JPG / JPEG</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Quick Links to Target Presets -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Direct KB Target Resizers:</span>
        <a href="/image-resizer-20kb/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Resizer 20KB</a>
        <a href="/image-resizer-50kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors">Resizer 50KB</a>
        <a href="/image-resizer-100kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors">Resizer 100KB</a>
        <a href="/image-resizer-200kb/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Resizer 200KB</a>
        <a href="/resize-image-to-20kb-to-50kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors">Resize to 20KB–50KB (SSC/UPSC)</a>
        <a href="/increase-image-size-in-kb/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Increase Size in KB</a>
        <a href="/image-resizer-in-cm/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Resizer in CM →</a>
      </div>
    </section>

    <!-- Technical Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        How Spatial Resampling &amp; Binary-Search Quantization Work
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Resizing an image to an exact kilobyte weight requires more than just changing width and height. High-resolution photos from modern smartphones contain millions of bytes of uncompressed raster data.
        </p>
        <p>
          PixelKit utilizes a two-step optimization pipeline:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm text-muted">
          <li>
            <strong class="text-fg">Bicubic Convolution Scaling:</strong> Recalculates pixel samples using a 16-pixel neighborhood matrix, ensuring smooth edges and natural skin tones without jagged aliasing.
          </li>
          <li>
            <strong class="text-fg">12-Step Binary-Search Quantization:</strong> Automatically iterates JPEG discrete cosine transform (DCT) quality scaling in multi-threaded Web Workers until the output byte count lands safely within your chosen kilobyte ceiling.
          </li>
        </ul>
      </div>
    </section>

    <!-- Official Portal Specs Guide -->
    <div class="mt-12 sm:mt-16">
      <PortalRequirementsGuide />
    </div>

    <!-- FAQ Section -->
    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>

