---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  {
    "label": "Home",
    "href": "/"
  },
  {
    "label": "Image Tools",
    "href": "/resize-image/"
  },
  {
    "label": "Change DPI to 300"
  }
];

const faqs = [
  {
    "q": "Why does an exam portal reject my photo for not being 300 DPI?",
    "a": "Many government admission software systems read the JFIF or EXIF DPI header tag. Even if your image has thousands of pixels, if the camera saved it with a default 72 DPI screen tag, the portal rejects it. PixelKit injects the official 300 DPI tag into the header in 5 milliseconds."
  },
  {
    "q": "Does changing DPI reduce the visual sharpness of my image?",
    "a": "Not at all. In fact, changing DPI through metadata is 100% lossless. The raw pixel values remain identical byte-for-byte; only the physical printer measurement tag is updated to 300 dots per inch."
  }
];

const pageTitle = 'Change Image DPI to 300 Online (Fast) | PixelKit';
const pageDesc = 'Convert image to 300 DPI online without quality loss. Updates JFIF and PNG metadata instantly in your browser with zero server uploads.';

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit Change Image DPI to 300 Online',
    description: pageDesc,
    url: new URL('/change-image-dpi-to-300/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        <span>Lossless Metadata DPI Injection · 300 DPI Print Ready</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Change Image DPI to 300 Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Convert any JPG, PNG, or WebP photo to 300 DPI print resolution instantly. Modifies header metadata directly without re-encoding, blurring, or quality degradation.
      </p>
    </header>

<div class="mt-5 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        initialTool="dpi"
        initialDpi={300}
      />
    </div>

    <!-- GEO Direct Answer Definition Block -->
    <DirectAnswerBox
      title="How 300 DPI Conversion Works Losslessly (2026 Direct Answer)"
      summaryText="DPI (Dots Per Inch) is a metadata tag in the image header (JFIF APP0 in JPEG, pHYs chunk in PNG) that instructs printers how many pixels to print per physical inch. Changing DPI to 300 does not alter physical pixel dimensions; it updates the print density tag so official portals recognize your image as 300 DPI print-ready."
      portalName="Print & Passport Portals (DPI Metadata Standard)"
      specs={[{"label":"Standard Print DPI","value":"300 DPI (Universal Standard)","highlight":true},{"label":"Pixel Alteration","value":"Zero (Pixels remain 100% untouched)","highlight":true},{"label":"Header Modified","value":"JFIF APP0 (JPG) / pHYs (PNG)"},{"label":"Processing Speed","value":"< 10 milliseconds in browser"}]}
    />

    <!-- Official Specification Table -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Standard DPI Presets & Common Uses
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Comparison of image resolution density standards across printing and display:
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-border bg-surface text-fg font-semibold">
              <th class="py-3 px-4">DPI Density</th>
              <th class="py-3 px-4">Common Use Case</th>
              <th class="py-3 px-4">Print Quality</th>
              <th class="py-3 px-4">File Weight Impact</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            <tr>
              <td class="py-3 px-4 font-medium text-fg">300 DPI</td>
              <td class="py-3 px-4 text-muted">Passports, Visas, Books, Official Exam Portals</td>
              <td class="py-3 px-4 text-muted">High Definition (Sharp)</td>
              <td class="py-3 px-4 text-muted">Zero file size increase</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">600 DPI</td>
              <td class="py-3 px-4 text-muted">Professional Photography & Gallery Printing</td>
              <td class="py-3 px-4 text-muted">Ultra High Definition</td>
              <td class="py-3 px-4 text-muted">Zero file size increase</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">150 DPI</td>
              <td class="py-3 px-4 text-muted">Newspaper & High-Speed Offset Printing</td>
              <td class="py-3 px-4 text-muted">Standard Print</td>
              <td class="py-3 px-4 text-muted">Zero file size increase</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-fg">72 / 96 DPI</td>
              <td class="py-3 px-4 text-muted">Websites, Displays & Smartphone Screens</td>
              <td class="py-3 px-4 text-muted">Screen Only (Blurry on print)</td>
              <td class="py-3 px-4 text-muted">Zero file size increase</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Dedicated DPI Presets:</span>
        <a href="/change-image-dpi-to-200/" class="rounded-lg border border-accent/40 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors">Change DPI to 200 (PAN/IBPS)</a>
        <a href="/change-image-dpi-to-600/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Change DPI to 600 (Journal/Print)</a>
        <a href="/change-image-dpi-to-150/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Change DPI to 150 (A4 Scans)</a>
        <a href="/change-image-dpi-to-72/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Change DPI to 72 (Web/Email)</a>
        <a href="/cm-to-pixels-at-300-dpi/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">CM to Pixels at 300 DPI</a>
        <a href="/mm-to-pixels-converter/" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">MM to Pixels</a>
      </div>
    </section>

    <!-- Technical Principles Section -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Why In-Browser Processing is Essential for Sensitive Photos &amp; IDs
      </h2>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs sm:text-sm text-muted leading-relaxed">
        <div class="p-4 rounded-xl bg-surface/50 border border-border/50">
          <h3 class="font-semibold text-fg text-sm mb-1.5 flex items-center gap-1.5">
            <span>🔒</span> Zero Cloud Uploads
          </h3>
          <p>Signatures, Aadhaar IDs, and passport photos are sensitive personal biometric assets. PixelKit processes all operations locally in browser RAM.</p>
        </div>
        <div class="p-4 rounded-xl bg-surface/50 border border-border/50">
          <h3 class="font-semibold text-fg text-sm mb-1.5 flex items-center gap-1.5">
            <span>⚡</span> Sub-Second Quantization
          </h3>
          <p>Powered by WebAssembly and Canvas binary-search encoding, resizing and compressing takes under 200ms with zero server latency.</p>
        </div>
        <div class="p-4 rounded-xl bg-surface/50 border border-border/50">
          <h3 class="font-semibold text-fg text-sm mb-1.5 flex items-center gap-1.5">
            <span>🎯</span> Portal Pass Guarantee
          </h3>
          <p>Dimensions, aspect ratios, and KB file limits are locked directly to the official government guidelines for immediate intake clearance.</p>
        </div>
      </div>
    </section>

    <FAQSection faqs={faqs} />
  </div>
</BaseLayout>
