---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
} from '@lib/seo/jsonld';

interface FormatCompressSpec {
  ext: string;
  label: string;
  mime: string;
  defaultKb: number | null;
  headline: string;
  titleTag: string;
  metaDesc: string;
  summary: string;
  mechanicsTitle: string;
  mechanicsBody: string;
  faqs: { q: string; a: string }[];
}

export const getStaticPaths: GetStaticPaths = () => {
  const specs: FormatCompressSpec[] = [
    {
      ext: 'jpg',
      label: 'JPG / JPEG',
      mime: 'image/jpeg',
      defaultKb: 100,
      headline: 'Compress JPG Online',
      titleTag: 'Compress JPG Online — Reduce JPEG Size in KB Free',
      metaDesc:
        'Free online JPG compressor. Shrink JPEG photos up to 85% or hit exact 50KB, 100KB, and 200KB limits without losing clarity—100% privately in your browser.',
      summary:
        'Shrink JPEG camera photos and scanned IDs by up to 85%—or dial in an exact KB ceiling like 50KB, 100KB, or 200KB—using client-side binary-search compression.',
      mechanicsTitle: 'How PixelKit Optimizes JPG Without Blocky Artifacts',
      mechanicsBody:
        'Instead of forcing you to guess a quality percentage, PixelKit executes a multi-step binary search across DCT quantization levels inside Web Workers. You can preserve or strip EXIF camera metadata, auto-correct phone orientation, and crop or scale pixel dimensions in the same pass.',
      faqs: [
        {
          q: 'How do I compress a JPG file to under 50KB or 100KB?',
          a: 'Drop your JPG or JPEG photo above and pick 50 KB or 100 KB in the Compression & Size dropdown (100 KB is pre-selected). PixelKit automatically iterates quality until your JPEG lands right under the cap.',
        },
        {
          q: 'Can I keep EXIF camera and date metadata when compressing JPG?',
          a: 'Yes. "Preserve EXIF metadata" is available in Advanced Options, or uncheck it to strip GPS coordinates and camera serial data before sharing online.',
        },
        {
          q: 'Can I also crop or resize my JPG before compressing?',
          a: 'Yes. Click "Crop Studio" or "Scale & Resize" on any dropped JPEG card to adjust aspect ratios or pixel dimensions before downloading.',
        },
      ],
    },
    {
      ext: 'png',
      label: 'PNG',
      mime: 'image/png',
      defaultKb: 100,
      headline: 'Compress PNG Online',
      titleTag: 'Compress PNG Online — Lossless & Indexed Optimization Free',
      metaDesc:
        'Free online PNG compressor. Shrink transparent PNGs, screenshots, and logos with lossless UPNG color quantization—100% private, zero uploads.',
      summary:
        'Shrink heavy PNG screenshots, icons, and transparent logos by 50% to 80% using high-efficiency color quantization and Deflate optimization without losing alpha channels.',
      mechanicsTitle: 'Lossless PNG Color Quantization & Alpha Preservation',
      mechanicsBody:
        'PixelKit uses UPNG.js to run k-means color quantization and DEFLATE stream recompression in your browser. Full 8-bit alpha transparency is preserved, so drop shadows and transparent logos stay smooth without harsh fringing.',
      faqs: [
        {
          q: 'Does compressing a PNG remove transparent backgrounds?',
          a: 'No. PixelKit preserves full 8-bit alpha transparency. You can also pick a solid background fill color in Advanced Options if converting to JPG.',
        },
        {
          q: 'How does PNG compression differ from JPG?',
          a: 'PNG is fundamentally a lossless format optimized for line art, screenshots, and text. PixelKit reduces PNG size by quantizing color palettes while keeping edges pin-sharp, unlike JPG which discards high-frequency details.',
        },
        {
          q: 'Can I convert a heavy PNG into a compact WebP or PDF?',
          a: 'Yes. Choose WebP or PDF in the target format dropdown for dramatic byte savings while keeping transparency or multi-page packaging intact.',
        },
      ],
    },
    {
      ext: 'webp',
      label: 'WebP',
      mime: 'image/webp',
      defaultKb: null,
      headline: 'Compress WebP Online',
      titleTag: 'Compress WebP Online — Next-Gen Image Optimization Free',
      metaDesc:
        'Free online WebP compressor. Optimize next-gen WebP images for green Core Web Vitals and instant page loads—100% in-browser, zero server uploads.',
      summary:
        'Optimize WebP images for green Core Web Vitals and lightning-fast web pages. Balance lossless transparency and predictive lossy compression with real-time preview and exact byte limits.',
      mechanicsTitle: 'Predictive Intra-Frame Compression for Green Web Vitals',
      mechanicsBody:
        'WebP employs VP8 intra-frame spatial prediction to model image blocks directly from neighboring pixels, reducing overall byte weight by 25% to 35% compared to legacy JPEG at equivalent visual fidelity. PixelKit tunes these encoding profiles directly in device memory using multithreaded client-side Web Workers, ensuring maximum compression ratios without sacrificing alpha channel clarity.',
      faqs: [
        {
          q: 'Why should I compress images as WebP for web publishing?',
          a: 'WebP files load significantly faster on mobile networks and are prioritized by Google PageSpeed Insights and Core Web Vitals scoring. Modern web browsers natively render WebP with lower memory consumption.',
        },
        {
          q: 'Can WebP images have transparent backgrounds?',
          a: 'Yes. WebP supports full 8-bit alpha channel transparency in both lossy and lossless modes, combining the small footprint of JPG with the transparency strengths of PNG.',
        },
        {
          q: 'Can I target an exact file size in KB for WebP files?',
          a: 'Yes. Choose any target limit like 50KB or 100KB, or pick Custom KB in the size selector. PixelKit runs an intelligent binary search to find the optimal quality level under your threshold.',
        },
      ],
    },
    {
      ext: 'pdf',
      label: 'PDF Document',
      mime: 'application/pdf',
      defaultKb: 200,
      headline: 'Compress PDF Online',
      titleTag: 'Compress PDF Online — Shrink Scans & Documents to KB Free',
      metaDesc:
        'Free online PDF compressor. Shrink scanned documents, forms, and multi-page PDFs to exact 100KB, 200KB, or 500KB limits—100% privately in your browser.',
      summary:
        'Shrink scanned paperwork, ID certificates, and multi-page PDFs under strict 100KB, 200KB, or 500KB limits for job, visa, and university portal submissions.',
      mechanicsTitle: 'Multi-Page Raster Resampling & Clean Document Assembly',
      mechanicsBody:
        'PixelKit decodes individual PDF pages via PDF.js, optimizes embedded raster imagery using progressive quantization, and reassembles a compact, standards-compliant PDF file using jsPDF without uploading confidential paperwork to third-party servers.',
      faqs: [
        {
          q: 'How do I compress a scanned PDF under 100KB or 200KB for portal upload?',
          a: 'Drop your PDF into PixelKit, select 100KB or 200KB as your target size, and click Convert & Download. PixelKit recalculates raster streams across pages to land safely under the portal ceiling.',
        },
        {
          q: 'Can I reorder or combine pages when compressing PDFs?',
          a: 'Yes. Drag and drop file cards in the upload area to change page sequence before generating your final optimized PDF.',
        },
        {
          q: 'Is my confidential financial or medical PDF safe?',
          a: 'Completely. PixelKit runs 100% inside your browser Web Workers. Zero bytes leave your device.',
        },
      ],
    },
  ];

  return specs.map((spec) => ({
    params: { format: spec.ext },
    props: { spec, allFormats: specs.map((s) => ({ ext: s.ext, label: s.label })) },
  }));
};

const { spec, allFormats } = Astro.props as {
  spec: FormatCompressSpec;
  allFormats: { ext: string; label: string }[];
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress Image', href: '/compress-image/' },
  { label: `Compress ${spec.label}` },
];

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: `PixelKit ${spec.label} Compressor`,
    description: spec.metaDesc,
    url: new URL(`/compress-${spec.ext}/`, SITE.url).href,
  }),
  buildFaqJsonLd(spec.faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={`${spec.titleTag} | ${SITE.name}`}
  description={spec.metaDesc}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>{spec.label} Optimizer · Crop &amp; Resize Built In · Zero Uploads</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-3xl font-bold tracking-tight sm:text-5xl text-fg">
        {spec.headline}
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        {spec.summary}
      </p>
    </header>

    <div class="mt-6 sm:mt-8">
      <ToolPreview
        from={spec.ext}
        to={spec.ext}
        fromMime={spec.mime}
        toMime={spec.mime}
        targetKb={spec.defaultKb}
      />
    </div>

    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        {spec.mechanicsTitle}
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed max-w-3xl">
        {spec.mechanicsBody}
      </p>

      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">More compressors:</span>
        {allFormats
          .filter((f) => f.ext !== spec.ext)
          .map((f) => (
            <a
              href={`/compress-${f.ext}/`}
              class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
            >
              {f.label}
            </a>
          ))}
        <a
          href="/compress-image-to-50kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Under 50KB
        </a>
        <a
          href="/compress-image-to-100kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Under 100KB
        </a>
        <a
          href="/compress-image-to-200kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Under 200KB
        </a>
      </div>
    </section>

    <!-- Deep In-Depth Format Optimization Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Advanced Compression Best Practices for {spec.label}
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Achieving optimal compression efficiency requires tailoring quantization parameters to container-specific encoding behaviors. Digital images contain spatial frequencies distributed across luminance (brightness) and chrominance (color) planes. Because the human eye perceives brightness variations with significantly higher acuity than subtle color gradations, modern compression codecs separate image data into distinct matrix channels.
        </p>
        <p>
          With PixelKit, you never have to guess confusing percentage sliders or risk blurry output. Our automated binary search engine tests quantization tables inside client Web Workers in parallel threads, guaranteeing that your output files land at or just below your designated kilobyte target with maximal structural clarity and zero remote server exposure.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 mt-4 pt-2">
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <h3 class="font-semibold text-fg text-sm">Strict Portal Acceptance</h3>
            <p class="text-xs text-muted mt-1">
              Never risk upload failure on embassy or recruitment portals due to file weight overages. Setting an exact target KB ceiling guarantees first-attempt submission success.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <h3 class="font-semibold text-fg text-sm">Zero Data Retention</h3>
            <p class="text-xs text-muted mt-1">
              Your files never touch external cloud servers. All compression executes in ephemeral browser memory, making it compliant with strict confidentiality protocols.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Articles & Companion Tools -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface/50 p-5 sm:p-8">
      <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-fg">
        Related Optimization Guides
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3 text-sm">
        <a href="/blog/why-portals-reject-200kb-photos/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Troubleshooting</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Why Portals Reject Photos &amp; How to Fix It</h3>
          <p class="text-xs text-muted mt-1.5">Guide to passing automated government and visa upload verification gates.</p>
        </a>
        <a href="/blog/compress-aadhaar-to-100kb-pdf/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Document Workflow</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Compress ID Scans to 100KB PDF</h3>
          <p class="text-xs text-muted mt-1.5">How to package multiple scans into a single compact document under strict portal caps.</p>
        </a>
        <a href="/passport-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Dedicated Tool</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Passport Photo Resizer</h3>
          <p class="text-xs text-muted mt-1.5">Crop to 35×45 mm, resize to 413×531 px, and compress under 50KB in one automated pass.</p>
        </a>
      </div>
    </section>

    <PortalRequirementsGuide />

    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={spec.faqs} />
    </div>
  </div>
</BaseLayout>
