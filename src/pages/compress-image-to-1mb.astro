---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress Image', href: '/compress-image/' },
  { label: 'Under 1MB' },
];

const faqs = [
  {
    q: 'How do I compress an image to under 1MB (1024KB) without losing quality?',
    a: 'Drop your JPG, PNG, WebP, or HEIC image into the box above. PixelKit automatically sets a 1024KB (1MB) target and runs a binary-search optimization loop inside your browser to calculate the exact compression ratio that retains maximum sharpness while keeping file size strictly under 1MB.',
  },
  {
    q: 'Can I compress multi-page PDF documents to under 1MB?',
    a: 'Yes. Switch the output format to PDF, enable "Merge Files into Single PDF", and drop your document pages. PixelKit compresses each scanned page locally to fit the combined file under your 1MB target.',
  },
  {
    q: 'Why do portals reject 1MB files that appear to be 1,000 KB?',
    a: 'Some portal systems calculate 1MB in binary kilobytes (1,024 KB = 1,048,576 bytes) while others enforce a strict 1,000 KB (1,000,000 bytes) ceiling. To prevent automated upload rejections, PixelKit lets you dial in an exact custom size like 950KB or 980KB with single-kilobyte precision.',
  },
  {
    q: 'Are high-resolution photos uploaded to a remote server for compression?',
    a: 'No. PixelKit executes all image processing, decoding, scaling, and compression directly inside your web browser using WebAssembly. Your photos, documents, and private files never leave your device.',
  },
];

const pageTitle = `Compress Image to 1MB Online — Shrink to 1024KB | ${SITE.name}`;
const pageDesc =
  'Compress JPG, PNG, WebP, HEIC, and PDF files to under 1MB (1024KB) online for free. Resize dimensions and preserve high resolution privately in your browser.';

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'Compress Image to 1MB — PixelKit',
    description: pageDesc,
    url: new URL('/compress-image-to-1mb/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>High-Res Photos · Documents · 1024KB Ceiling</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Compress Image to 1MB Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Reduce large smartphone photos, DSLR captures, and scanned documents to under 1MB (1024KB) with crisp detail. 100% private in-browser compression with zero server uploads.
      </p>
    </header>

    <div class="mt-6 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={1024}
      />
    </div>

    <!-- Use cases -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        When You Need an Image Under 1MB
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Need to shrink a 15MB camera capture or multi-page scan? PixelKit preserves fine color depth and photographic grain while reducing file weight by up to 95%:
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs sm:text-sm">
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">Email Attachments &amp; Resumes</div>
          <div class="font-mono text-accent text-xs mt-1">1920 × 1080 px · Under 1MB</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Ensure job applications, resumes, and portfolios pass through corporate email spam filters and mailbox size limits without getting blocked.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">Real Estate &amp; Portfolios</div>
          <div class="font-mono text-accent text-xs mt-1">2560 px Wide · JPG / WebP</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Preserve sharpness on architectural photography and graphic portfolios while keeping page load speeds rapid for web visitors.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">Government &amp; Legal Portals</div>
          <div class="font-mono text-accent text-xs mt-1">Scanned A4 · Under 1024 KB</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Upload deed scans, court declarations, and tax filings to portals enforcing a strict 1MB or 1024KB ceiling per document.
          </p>
        </div>
      </div>

      <!-- Sibling KB switches -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Other exact KB targets:</span>
        <a
          href="/compress-image-to-20kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 20KB
        </a>
        <a
          href="/compress-image-to-50kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 50KB
        </a>
        <a
          href="/compress-image-to-100kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 100KB
        </a>
        <a
          href="/compress-image-to-200kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 200KB
        </a>
        <a
          href="/compress-image-to-500kb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 500KB
        </a>
        <a
          href="/passport-photo-resizer/"
          class="rounded-lg border border-accent/30 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors"
        >
          Passport Photo Resizer →
        </a>
      </div>
    </section>

    <!-- Technical Strategies -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Technical Strategies for 1MB Document &amp; Photo Compression
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          High-end smartphones produce photos exceeding 12MB to 25MB with raw sensor resolutions upwards of 48 megapixels. Uploading files of this size to client portals, email systems, or content management systems wastes bandwidth and often triggers upload timeout errors.
        </p>
        <p>
          PixelKit uses client-side WebAssembly to downscale raw dimensions before compressing. Downscaling a 6000×4000 px photo to 2560×1707 px preserves ultra-HD clarity on Retina and 4K displays while reducing uncompressed bitmap size by over 80%. The binary search quantization then selects the optimal JPEG or WebP quality table to ensure your exported file hits exactly below 1MB (1024KB).
        </p>
      </div>
    </section>

    <!-- Common Validation Errors & Solutions -->
    <section class="mt-8 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Common 1MB Upload Errors &amp; Fixes
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="p-4 rounded-xl border border-border bg-bg/50">
          <h3 class="text-sm font-semibold text-danger flex items-center gap-1.5">
            <span>⚠</span> "File exceeds the maximum allowable size of 1MB"
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed">
            <strong>Cause:</strong> The portal calculates 1MB strictly as 1,000,000 bytes (1,000 KB decimal) while operating systems calculate 1MB as 1,048,576 bytes (1,024 KB binary). A 1,010 KB file will fail decimal checks.<br/>
            <strong>Fix:</strong> Set PixelKit's target size to 950KB or 980KB to safely satisfy both binary and decimal validation rules.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-border bg-bg/50">
          <h3 class="text-sm font-semibold text-danger flex items-center gap-1.5">
            <span>⚠</span> "Image resolution too high for processing"
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed">
            <strong>Cause:</strong> Attempting to compress a 48MP image without resizing causes portal decoders to exceed memory limits.<br/>
            <strong>Fix:</strong> Open PixelKit's Scale &amp; Resize panel and constrain max width to 2048 px or 2560 px prior to exporting.
          </p>
        </div>
      </div>
    </section>

    <PortalRequirementsGuide />

    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>

