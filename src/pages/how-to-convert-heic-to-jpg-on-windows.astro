---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
  buildCustomHowToJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'HEIC to JPG', href: '/heic-to-jpg/' },
  { label: 'How to Convert HEIC to JPG on Windows' },
];

const faqs = [
  {
    q: 'Why can’t Windows 11 or Windows 10 open HEIC files by default?',
    a: 'Windows Photos requires the proprietary HEVC Video Extensions codec to decode Apple HEIC/HEIF images, which Microsoft sells as a paid $0.99 add-on in the Microsoft Store. Without this codec, Windows displays the error: "The HEVC Video Extension is required to display this file." PixelKit solves this by decoding HEIC files locally in your web browser using WebAssembly, without installing any software or paying for codecs.',
  },
  {
    q: 'How do I convert HEIC to JPG on Windows for free?',
    a: 'Simply drag and drop your iPhone .heic photos into the converter tool above. PixelKit instantly decodes the HEIC container in browser memory and converts them to standard JPG format. You can convert individual photos or batch convert entire photo albums and download them as a ZIP.',
  },
  {
    q: 'Do I need to install any software or extensions on Windows?',
    a: 'No. PixelKit runs 100% inside your web browser (Google Chrome, Microsoft Edge, Mozilla Firefox, or Brave). There are no .exe installers, no browser extensions, and no Microsoft Store purchases required.',
  },
  {
    q: 'Are my private iPhone photos uploaded to any online server?',
    a: 'Never. PixelKit executes all image processing client-side in your device’s browser memory via Web Workers and WebAssembly. Your photos never leave your Windows PC or get transmitted across the internet.',
  },
  {
    q: 'How do I stop my iPhone from taking HEIC photos in the future?',
    a: 'On your iPhone, go to Settings → Camera → Formats, and tap "Most Compatible". This configures your iPhone camera to save all future photos directly as standard JPEG files instead of HEIC.',
  },
  {
    q: 'Can I also convert HEIC to PNG or PDF on Windows?',
    a: 'Yes. In the tool above, simply select "PNG" for lossless graphic quality or "PDF" to bundle single or multiple iPhone photos into a clean document for email or portal submission.',
  },
];

const directAnswer = {
  question: 'How to convert HEIC to JPG on Windows without paying for codecs?',
  answer:
    'To convert HEIC to JPG on Windows 10 or 11 for free: 1. Open PixelKit in Microsoft Edge or Google Chrome. 2. Drag and drop your .heic or .heif photos into the box. 3. PixelKit uses client-side WebAssembly to decode the Apple format in device memory. 4. Click Download to save universal, compatible JPG images without installing any paid Microsoft Store extensions or uploading files to third-party servers.',
};

const pageTitle = `Convert HEIC to JPG on Windows (No Codecs Needed) | ${SITE.name}`;
const pageDesc =
  'Learn how to convert iPhone HEIC photos to JPG on Windows 11 & Windows 10 for free without paying for HEVC extensions. 100% private in-browser conversion.';
const pageKeywords = [
  'how to convert heic to jpg on windows',
  'how to convert heic to jpg',
  'how to change heic to jpg',
  'convert heic to jpg windows 11',
  'convert heic to jpg windows 10',
  'heic to jpg windows free',
  'open heic on windows without codec',
  'heic to jpg converter',
  'convert heic to jpg',
  'heic to jpeg',
  'heic to pdf',
  'heic to png',
];

const howToJsonLd = buildCustomHowToJsonLd({
  name: 'How to convert HEIC to JPG on Windows 11 and Windows 10',
  description:
    'Step-by-step guide to converting Apple iPhone HEIC pictures to standard JPG on Windows PCs for free with zero server uploads.',
  steps: [
    {
      name: 'Open PixelKit in your Windows browser',
      text: 'Launch Google Chrome, Microsoft Edge, or Firefox on your Windows 10 or 11 PC and navigate to PixelKit.',
    },
    {
      name: 'Select or drag your HEIC files',
      text: 'Drop one or multiple .heic photos from your Windows File Explorer into the converter.',
    },
    {
      name: 'Instant in-memory decoding',
      text: 'PixelKit’s client-side WebAssembly engine decodes the HEIF image container locally without network transmission.',
    },
    {
      name: 'Download universal JPG files',
      text: 'Click Download to save compatible JPG images that open seamlessly in Windows Photos, paint, and web portals.',
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit HEIC to JPG Converter for Windows',
    description: pageDesc,
    url: 'https://pixelkit.app/how-to-convert-heic-to-jpg-on-windows/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Windows 11, Windows 10, Any OS',
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(breadcrumbs),
  howToJsonLd,
];

const windowsMethods = [
  {
    title: 'Method 1: In-Browser WebAssembly (Recommended)',
    badge: 'Fastest & 100% Free',
    desc: 'Uses PixelKit to decode HEIC directly in browser memory. No installations, no file limits, and complete client-side privacy.',
    pros: 'Instant, zero cost, works on any Windows PC, zero cloud upload.',
  },
  {
    title: 'Method 2: iPhone Camera Settings Toggle',
    badge: 'Permanent Prevention',
    desc: 'Go to Settings → Camera → Formats → "Most Compatible" on your iPhone to shoot in JPEG format permanently.',
    pros: 'Future photos are automatically saved as JPG.',
  },
  {
    title: 'Method 3: Microsoft Store HEVC Extension',
    badge: 'Paid Microsoft Add-on',
    desc: 'Microsoft offers an official HEVC Video Extension in the Microsoft Store for $0.99 to enable native Windows Photos playback.',
    pros: 'Allows native thumbnail preview in File Explorer.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="https://pixelkit.app/how-to-convert-heic-to-jpg-on-windows/"
  keywords={pageKeywords}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mt-4 sm:mt-6 text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-xs font-semibold text-accent">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        Windows 11 · Windows 10 · 100% Free &amp; Private
      </div>
      <h1 class="mt-3 text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-fg">
        How to Convert HEIC to JPG on Windows
      </h1>
      <p class="mx-auto mt-2 max-w-2xl text-xs sm:text-sm text-muted">
        Fix the "HEVC extension required" error on Windows. Convert Apple iPhone photos to universal JPG instantly in your browser with zero server uploads and zero software installation.
      </p>
    </header>

    <!-- Direct Answer Box (GEO / AI Overview) -->
    <div class="mt-6 sm:mt-8">
      <DirectAnswerBox
        title="How to Convert HEIC to JPG on Windows (2026 Solution)"
        summaryText={directAnswer.answer}
        specs={[
          { label: 'Compatible Windows Editions', value: 'Windows 11, Windows 10, Windows 8/7', highlight: true },
          { label: 'Required Software', value: 'None (100% In-Browser WebAssembly)' },
          { label: 'Supported Browsers', value: 'Microsoft Edge, Chrome, Firefox, Brave' },
          { label: 'Privacy & Security', value: 'Zero Server Uploads / Local Memory Only', highlight: true },
        ]}
      />
    </div>

    <!-- Active Tool Studio Pre-configured for HEIC to JPG -->
    <div class="mt-6 sm:mt-8">
      <ToolPreview
        from="heic"
        to="jpg"
        fromMime="image/heic"
        toMime="image/jpeg"
        initialTool="convert"
      />
    </div>

    <!-- Three Methods Comparison Grid -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        3 Ways to Open and Convert HEIC Photos on Windows
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Compare the easiest methods to handle iPhone HEIC photos on Windows 10 and Windows 11:
      </p>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        {windowsMethods.map((m) => (
          <div class="rounded-xl border border-border bg-bg/50 p-5 flex flex-col justify-between">
            <div>
              <div class="inline-block rounded-md bg-accent/10 px-2 py-0.5 text-[11px] font-semibold text-accent">
                {m.badge}
              </div>
              <h3 class="mt-2 text-base font-bold text-fg">{m.title}</h3>
              <p class="mt-2 text-xs text-muted leading-relaxed">{m.desc}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-border/60 text-xs font-medium text-emerald-500">
              ✓ {m.pros}
            </div>
          </div>
        ))}
      </div>

      <!-- Quick Action Links -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Related Converters:</span>
        <a href="/heic-to-jpg/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">HEIC to JPG Hub →</a>
        <a href="/heic-to-pdf/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">HEIC to PDF</a>
        <a href="/heic-to-png/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">HEIC to PNG</a>
        <a href="/heic-to-jpg-under-100kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">HEIC to JPG under 100KB</a>
        <a href="/heic-to-jpg-under-50kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">HEIC to JPG under 50KB</a>
      </div>
    </section>

    <!-- Technical Guide on Windows HEIC Incompatibility -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Why Windows Requires Codecs for iPhone Photos
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Starting with iOS 11, Apple switched default photo storage from legacy JPEG to <strong>High Efficiency Image Container (HEIC)</strong>. HEIC utilizes High Efficiency Video Coding (HEVC / H.265) intra-frame compression, allowing iPhone photos to occupy roughly 50% less storage space with superior color fidelity.
        </p>
        <p>
          However, Microsoft does not bundle native HEVC codecs in default consumer editions of Windows 10 and Windows 11 due to licensing royalties. As a result, when you transfer iPhone pictures via USB cable, iCloud for Windows, or email, the Windows Photos app displays a blank preview and urges you to purchase codec extensions.
        </p>
        <p>
          <strong>The PixelKit Advantage:</strong> Rather than paying for Microsoft Store extensions or uploading personal family photos to sketchy cloud conversion websites, PixelKit runs a compiled WebAssembly binary of <code>libheif</code> directly in your Windows browser. Your CPU decodes the image locally in milliseconds with 100% privacy and zero data leakage.
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>

