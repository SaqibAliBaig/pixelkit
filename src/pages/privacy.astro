---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Button from '@components/ui/Button.astro';
import { SITE } from '@lib/constants';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Privacy' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Privacy Policy — ${SITE.name}`,
    description: "PixelKit runs entirely in your browser. Files are never uploaded, stored, or logged.",
    url: new URL('/privacy', SITE.url).href,
  },
];
---

<BaseLayout
  title={`Privacy — ${SITE.name}`}
  description="PixelKit runs entirely in your browser. Files are never uploaded, stored, or logged. Here's exactly what we do and don't collect."
  jsonLd={jsonLd}
  width="default"
>
  <div class="mx-auto max-w-3xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Page Header -->
    <header class="mt-5 sm:mt-8">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] text-emerald-600 dark:text-emerald-400 font-medium mb-3">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>Zero Data Collection · 100% Client-Side</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-fg">
        Privacy Policy
      </h1>
      <p class="mt-2.5 sm:mt-3 text-xs sm:text-base text-muted leading-relaxed">
        The short version: your files never leave your device. PixelKit does not upload, store, inspect, or log anything you open in the tool.
      </p>
    </header>

    <!-- Privacy Guarantees Highlight -->
    <div class="mt-6 sm:mt-8 rounded-xl sm:rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-4 sm:p-6">
      <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
        Privacy Guarantee at a Glance
      </h2>
      <div class="mt-3.5 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">Zero Uploads:</strong> Files process locally in your device RAM.</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">Zero Cookies:</strong> No ad trackers, marketing scripts, or pixels.</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">No Accounts:</strong> No signups, email capture, or phone numbers.</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">Auto Memory Purge:</strong> All file data vanishes when the tab closes.</span>
        </div>
      </div>
    </div>

    <!-- Policy Sections -->
    <div class="mt-6 sm:mt-8 space-y-4 sm:space-y-6">
      <!-- Files -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Files and Media</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          Every conversion runs locally in your browser using the HTML5 Canvas API and isolated Web Workers. Files are read from disk, processed in memory, and written back to disk as direct downloads. Nothing is transmitted over the network during the conversion, and nothing is retained after the tab is closed.
        </p>
      </section>

      <!-- Analytics -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-500/10 text-indigo-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Analytics</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          We use Cloudflare Web Analytics — a privacy-first, cookie-free analytics service. It counts page views and reports aggregate performance metrics (like load time) but does not set cookies, fingerprint visitors, or track you across sites. No personal data is collected, and no data is sold.
        </p>
      </section>

      <!-- Logs -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h8" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Server Logs</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          Our hosting provider (Cloudflare) keeps standard HTTP access logs for a short retention window, as any web host does. These logs contain IP address, user agent, and requested path — they do not contain any of your converted files, since your files are never sent to the server.
        </p>
      </section>

      <!-- Third Parties -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-500/10 text-teal-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Third Parties &amp; Trackers</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          We do not embed third-party trackers, ad networks, or invasive analytics SDKs. We do not use Facebook Pixel, Google Analytics, or similar services. The only third-party request on the site is the Cloudflare Web Analytics beacon, which is served from Cloudflare's own CDN and is completely cookie-free.
        </p>
      </section>

      <!-- Contact -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-500/10 text-sky-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Contact</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          Have questions or concerns about this privacy policy? Reach out directly to our team:
        </p>
        <div class="mt-3">
          <a
            href="mailto:privacy@pixelkit.app"
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-medium text-fg hover:border-accent hover:text-accent transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
            </svg>
            <span>privacy@pixelkit.app</span>
          </a>
        </div>
      </section>
    </div>

    <!-- Date tag & Actions -->
    <div class="mt-6 flex items-center justify-between text-xs text-muted">
      <span>Last updated: January 2026</span>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row gap-2.5 sm:gap-3 pb-8">
      <Button href="/convert" variant="primary" size="md" class="w-full sm:w-auto text-center justify-center">Start converting safely</Button>
      <Button href="/about" variant="secondary" size="md" class="w-full sm:w-auto text-center justify-center">About PixelKit</Button>
    </div>
  </div>
</BaseLayout>