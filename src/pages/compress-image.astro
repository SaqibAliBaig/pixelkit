---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import { SITE } from '@lib/constants';
import { buildSoftwareApplicationJsonLd, buildFaqJsonLd, buildBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress Image' },
];

const faqs = [
  {
    q: 'How does PixelKit compress images to an exact KB size?',
    a: 'PixelKit uses an iterative binary-search algorithm running locally in Web Workers. It tests compression quantization levels until the output file fits directly under your target limit (e.g. 50 KB, 100 KB, or 200 KB) with maximum visual clarity.',
  },
  {
    q: 'Can I use PixelKit as an image to KB converter (20KB, 50KB, 100KB)?',
    a: 'Yes. PixelKit works as an exact image to KB converter with dedicated 1-click presets for 20KB, 50KB, 100KB, 200KB, and 500KB—specifically tuned for Aadhaar, PAN, passport, UPSC, and university application portals.',
  },
  {
    q: 'Which image format compresses to the smallest file size?',
    a: 'WebP and AVIF generally produce 30% to 50% smaller files than JPG and PNG while maintaining identical visual quality. If your target portal accepts only JPG or PDF, PixelKit will optimize those formats to their absolute limits.',
  },
  {
    q: 'Is there a limit to how many images I can compress?',
    a: 'No. PixelKit does not impose daily limits, file counts, or upload paywalls. You can drop batches of photos and compress them in parallel.',
  },
  {
    q: 'Are my confidential documents and ID scans private?',
    a: 'Yes, 100%. PixelKit never uploads your files to any remote server. Everything is decoded, compressed, and downloaded directly inside your browser.',
  },
];

const pageTitle = `Compress Image Online — Image to KB Converter (50KB, 100KB, 200KB) | ${SITE.name}`;
const pageDesc = 'Free online image compressor & image to KB converter. Shrink JPG, PNG, WebP, HEIC & PDF to exact KB sizes (20KB, 50KB, 100KB, 200KB) without losing quality—zero uploads.';
const pageKeywords = [
  'image compressor',
  'compress image online',
  'image to kb converter',
  'photo to kb converter',
  'reduce image size in kb',
  'compress image to 50kb',
  'compress image to 100kb',
  'compress image to 200kb',
];

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit Image Compressor',
    description: pageDesc,
    url: new URL('/compress-image', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero -->
    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Exact KB Targets · Zero Uploads · Lossless &amp; Lossy Engine</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-3xl font-bold tracking-tight sm:text-5xl text-fg">
        Compress Image Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Reduce image file size to exact KB limits without visible quality loss. Smart binary-search compression tuned for online portals, exam forms, and website speed.
      </p>
    </header>

    <!-- Tool Preview -->
    <div class="mt-6 sm:mt-8">
      <ToolPreview from="jpg" to="jpg" fromMime="image/jpeg" toMime="image/jpeg" targetKb={100} />
    </div>

    <!-- Target KB Portal Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Popular Target Size Limits
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Select standard file limits commonly required by job and government portals:
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-4 gap-3.5 text-xs sm:text-sm">
        <a href="/compress-image-to-50kb" class="block rounded-xl border border-border bg-bg/50 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 50 KB</div>
          <div class="font-mono text-accent text-xs mt-1">Signatures &amp; Exams</div>
          <p class="text-muted mt-1.5 text-xs">Standard limit for digital signatures, thumbprints, and compact application forms.</p>
        </a>
        <a href="/compress-image-to-100kb" class="block rounded-xl border border-border bg-bg/50 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 100 KB</div>
          <div class="font-mono text-accent text-xs mt-1">ID Scans &amp; Passports</div>
          <p class="text-muted mt-1.5 text-xs">Requirement for Aadhaar, PAN card, driver licenses, and state exam portals.</p>
        </a>
        <a href="/compress-image-to-200kb" class="block rounded-xl border border-border bg-bg/50 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 200 KB</div>
          <div class="font-mono text-accent text-xs mt-1">Visa &amp; Official Forms</div>
          <p class="text-muted mt-1.5 text-xs">Standard maximum threshold for immigration, embassy, and university submissions.</p>
        </a>
        <a href="/compress-image-to-500kb" class="block rounded-xl border border-border bg-bg/50 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 500 KB / 1 MB</div>
          <div class="font-mono text-accent text-xs mt-1">Multi-Page &amp; Documents</div>
          <p class="text-muted mt-1.5 text-xs">Ideal for email attachments, PDF certificates, and high-res web imagery.</p>
        </a>
      </div>

      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Compress by format:</span>
        <a href="/compress-jpg" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Compress JPG</a>
        <a href="/compress-png" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Compress PNG</a>
        <a href="/compress-webp" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Compress WebP</a>
        <a href="/compress-pdf" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Compress PDF</a>
        <a href="/compress-image-to-20kb" class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Under 20KB</a>
      </div>
    </section>

    <!-- FAQs -->
    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>
