---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import { SITE } from '@lib/constants';
import { buildSoftwareApplicationJsonLd, buildFaqJsonLd, buildBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress Image' },
];

const faqs = [
  {
    q: 'How does PixelKit compress images to an exact KB size?',
    a: 'PixelKit uses an iterative binary-search algorithm running locally in Web Workers. It tests compression quantization levels until the output file fits directly under your target limit (e.g. 50 KB, 100 KB, or 200 KB) with maximum visual clarity.',
  },
  {
    q: 'Can I use PixelKit as an image to KB converter (20KB, 50KB, 100KB)?',
    a: 'Yes. PixelKit works as an exact image to KB converter with dedicated 1-click presets for 20KB, 50KB, 100KB, 200KB, and 500KB—specifically tuned for Aadhaar, PAN, passport, UPSC, and university application portals.',
  },
  {
    q: 'Which image format compresses to the smallest file size?',
    a: 'WebP and AVIF generally produce 30% to 50% smaller files than JPG and PNG while maintaining identical visual quality. If your target portal accepts only JPG or PDF, PixelKit will optimize those formats to their absolute limits.',
  },
  {
    q: 'Is there a limit to how many images I can compress?',
    a: 'No. PixelKit does not impose daily limits, file counts, or upload paywalls. You can drop batches of photos and compress them in parallel.',
  },
  {
    q: 'Are my confidential documents and ID scans private?',
    a: 'Yes, 100%. PixelKit never uploads your files to any remote server. Everything is decoded, compressed, and downloaded directly inside your browser.',
  },
];

const pageTitle = `Compress Image to Exact KB Online Free (20–200KB) | ${SITE.name}`;
const pageDesc = 'Compress or convert image to exact KB (20KB, 50KB, 100KB, 200KB) online free. Shrink JPG, PNG, WebP & PDF without losing quality—100% private, no upload.';
const pageKeywords = [
  'image compressor',
  'compress image online',
  'compress photo online',
  'compress image to 50kb',
  'compress photo to 50kb',
  'reduce image size to 50kb',
  'compress image to 100kb',
  'compress photo to 100kb',
  'reduce image size to 100kb',
  'compress image to 20kb',
  'compress photo to 20kb',
  'reduce image size to 20kb',
  'compress image to 200kb',
  'compress photo to 200kb',
  'reduce image size to 200kb',
  'compress image to 30kb',
  'compress image to 10kb',
  'compress image to 15kb',
  'compress image to 40kb',
  'compress image to 500kb',
  'compress image to 1mb',
  'compress image to pdf',
  'compress photo to pdf',
  'compress image to 50kb online',
  'compress image to 100kb online',
  'compress image to 20kb online',
  'image to kb converter',
  'photo to kb converter',
  'reduce image size in kb',
  'reduce photo size in kb',
];

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit Image Compressor',
    description: pageDesc,
    url: new URL('/compress-image/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero -->
    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Exact KB Targets · Zero Uploads · Lossless &amp; Lossy Engine</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Compress Image Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Reduce image file size to exact KB limits without visible quality loss. Smart binary-search compression tuned for online portals, exam forms, and website speed.
      </p>
    </header>

    <!-- Tool Preview -->
    <div class="mt-6 sm:mt-8">
      <ToolPreview from="jpg" to="jpg" fromMime="image/jpeg" toMime="image/jpeg" targetKb={100} initialTool="compress" />
    </div>

    <!-- Target KB Portal Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Popular Target Size Limits
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Select standard file limits commonly required by job and government portals:
      </p>

      <div class="mt-5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs sm:text-sm">
        <a href="/compress-image-to-20kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 20 KB</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Signatures &amp; Exams</div>
          <p class="text-muted mt-1 text-[11px]">Strict SSC, UPSC, and IBPS digital signature limit.</p>
        </a>
        <a href="/compress-image-to-30kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 30 KB</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">State Recruitment</div>
          <p class="text-muted mt-1 text-[11px]">UPSSSC, MPPEB, and state public service entrance.</p>
        </a>
        <a href="/compress-image-to-50kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 50 KB</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Exam Headshots</div>
          <p class="text-muted mt-1 text-[11px]">Standard photo ceiling for NEET, JEE, and civil service.</p>
        </a>
        <a href="/compress-image-to-100kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 100 KB</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">ID Scans &amp; Passports</div>
          <p class="text-muted mt-1 text-[11px]">Requirement for Aadhaar, PAN card, and bank KYC.</p>
        </a>
        <a href="/compress-image-to-200kb/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Under 200 KB</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Visa &amp; Documents</div>
          <p class="text-muted mt-1 text-[11px]">US DS-160 visa and university marksheet scans.</p>
        </a>
        <a href="/compress-image-to-pdf/" class="block rounded-xl border border-border bg-bg/50 p-3 hover:border-accent transition-colors">
          <div class="font-bold text-fg">Image to PDF</div>
          <div class="font-mono text-accent text-[11px] mt-0.5">Document Packaging</div>
          <p class="text-muted mt-1 text-[11px]">Convert and compress images directly into PDF.</p>
        </a>
      </div>

      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">All exact targets:</span>
        <a href="/compress-image-to-10kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">10KB</a>
        <a href="/compress-image-to-20kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">20KB</a>
        <a href="/compress-image-to-30kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">30KB</a>
        <a href="/compress-image-to-50kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">50KB</a>
        <a href="/compress-image-to-100kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">100KB</a>
        <a href="/compress-image-to-200kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">200KB</a>
        <a href="/compress-image-to-256kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">256KB</a>
        <a href="/compress-image-to-500kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">500KB</a>
        <a href="/compress-image-to-1mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">1MB</a>
        <a href="/compress-image-to-2mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">2MB</a>
        <a href="/compress-image-to-5mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">5MB</a>
        <a href="/compress-image-to-10mb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">10MB</a>
        <a href="/compress-image-without-losing-quality/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Without Losing Quality</a>
        <a href="/increase-image-size-in-kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Increase Size in KB</a>
        <a href="/reduce-image-size-in-kb/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Reduce Size in KB</a>
        <a href="/compress-image-to-specific-size/" class="rounded-lg border border-accent/40 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Specific Size</a>
        <a href="/compress-image-to-pdf/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">Image to PDF</a>
      </div>
    </section>

    <!-- Comprehensive Technical Guide on Image Compression -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Understanding Client-Side Image Compression Mechanics
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Compressing digital images requires balancing visual fidelity against file weight. In uncompressed form, a standard 12-megapixel smartphone photograph represents approximately 36 megabytes of raw RGB pixel data. Compression algorithms dramatically reduce this byte weight through two primary approaches: lossless redundancy reduction and psycho-visually optimized lossy quantization.
        </p>
        <p>
          Lossy formats such as JPG, WebP, and AVIF discard high-frequency spatial frequencies that the human visual system is least sensitive to, especially across chrominance channels. PixelKit's binary search compression engine iterates quantization matrix scaling factors in multi-threaded Web Workers, determining the highest possible visual clarity that guarantees the final output file does not exceed your designated kilobyte target.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 mt-4 pt-2">
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <h3 class="font-semibold text-fg text-sm">Chroma Subsampling Optimization</h3>
            <p class="text-xs text-muted mt-1">
              By using 4:2:0 chroma subsampling for photographic content, color bandwidth is halved with zero perceived sharpness loss, allowing aggressive byte reductions for passport and exam portal submissions.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <h3 class="font-semibold text-fg text-sm">Target Convergence Without Guesswork</h3>
            <p class="text-xs text-muted mt-1">
              Instead of manually dragging a percentage quality slider and repeatedly checking file size in your file explorer, PixelKit automatically converges to your exact budget in less than half a second.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Articles & Companion Tools -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface/50 p-5 sm:p-8">
      <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-fg">
        Helpful Compression Guides &amp; Tools
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3 text-sm">
        <a href="/blog/why-portals-reject-200kb-photos/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Troubleshooting</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Why Portals Reject Photos &amp; How to Fix It</h3>
          <p class="text-xs text-muted mt-1.5">Detailed guide to passing automated upload gates for visas, government forms, and passports.</p>
        </a>
        <a href="/blog/compress-aadhaar-to-100kb-pdf/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Step-by-Step</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Compress Aadhaar &amp; Scans to 100KB PDF</h3>
          <p class="text-xs text-muted mt-1.5">How to combine multiple ID scans into a single compact PDF document under strict limits.</p>
        </a>
        <a href="/passport-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Dedicated Tool</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Passport Photo Resizer</h3>
          <p class="text-xs text-muted mt-1.5">Pre-configured 35×45 mm &amp; 2×2 inch templates with automated 20–100KB compression.</p>
        </a>
      </div>
    </section>

    <!-- FAQs -->
    <PortalRequirementsGuide />

    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>
