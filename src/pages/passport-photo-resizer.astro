---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import ExamComparisonTable from '@components/seo/ExamComparisonTable.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
  buildCustomHowToJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Resize Image', href: '/resize-image/' },
  { label: 'Passport Photo Resizer & Compressor' },
];

const faqs = [
  {
    q: 'How do I crop, resize, and compress a passport photo in one step?',
    a: 'Drop your photo (JPG, PNG, or iPhone HEIC) above. Click "Crop Studio" to frame a 3:4 or 1:1 ratio, click "Scale & Resize" to apply the 413 × 531 px (35 × 45 mm) or 600 × 600 px (2 × 2 inch) preset, and keep the target size at 50 KB or 100 KB before clicking Convert & Download.',
  },
  {
    q: 'What are the standard passport photo dimensions in pixels?',
    a: 'For 35 × 45 mm passports (India, UK, EU, Schengen, Australia), the standard 300 DPI digital size is 413 × 531 pixels. For US Passports and DS-160 Visas (2 × 2 inches), the standard is 600 × 600 pixels.',
  },
  {
    q: 'Can I convert an iPhone HEIC selfie directly into a 50KB passport JPG?',
    a: 'Yes. PixelKit decodes HEIC locally in your browser, lets you crop and resize to exact passport dimensions, and outputs a standard JPG under 50KB or 100KB accepted by all government portals.',
  },
  {
    q: 'Is my face scan or passport photo uploaded to any server?',
    a: 'No—never. Biometric face photos are sensitive personal data. PixelKit runs 100% inside your browser using HTML5 Canvas and Web Workers, with zero server uploads.',
  },
];

const pageTitle = `Passport Photo Resizer (413×531 px & 50KB) | ${SITE.name}`;
const pageDesc =
  'Free private passport and visa photo resizer. Crop aspect ratio, resize to 413x531 px or 600x600 px, and compress under 50KB or 100KB JPG in one step.';

const howToJsonLd = buildCustomHowToJsonLd({
  name: 'How to crop, resize, and compress passport and visa photos',
  description:
    'Universal guide to crop standard 3:4 portrait or 1:1 square ratios, resize to 413x531 px or 600x600 px, and compress under 50KB-100KB for official passport portals.',
  steps: [
    {
      name: 'Select passport photo',
      text: 'Drag and drop your photo (JPG, PNG, or Apple HEIC) into PixelKit.',
    },
    {
      name: 'Choose country preset or aspect ratio',
      text: 'Select 35x45 mm (413 × 531 px) for Passport Seva/Schengen/UK/Australia or 2x2" (600 × 600 px) for US Visa DS-160.',
    },
    {
      name: 'Target file weight bracket',
      text: 'Set the target size slider to 50KB, 100KB, or 200KB according to your consular portal requirements.',
    },
    {
      name: 'Download formatted file',
      text: 'Save your compliant biometric image directly to your device with 100% privacy and zero cloud uploads.',
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit Passport Photo Cropper, Resizer & Compressor',
    description: pageDesc,
    url: new URL('/passport-photo-resizer/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  howToJsonLd,
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        <span>All-in-One: Crop 3:4 / 1:1 · Resize 413×531 px · Compress &lt; 50KB</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Passport &amp; Visa Photo Resizer
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Crop aspect ratio, resize to official dimensions, and compress to exact KB limits—all inside your browser. No server uploads, zero privacy risk for personal IDs.
      </p>
    </header>

<div class="mt-5 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={100}
        initialTool="passport"
        preset="in-passport"
        category="visa"
      />
    </div>

    <!-- GEO Direct Answer Definition Block -->
    <DirectAnswerBox
      title="Official Passport & Visa Photo Standards Summary (2026 Direct Answer)"
      summaryText="Standard international biometric passport photos (India Passport Seva, UK, EU/Schengen, Australia) require a 35 × 45 mm format (413 × 531 pixels at 300 DPI) in JPG format between 20 KB and 100 KB. United States passports and DS-160 visas require a 2 × 2 inch square (600 × 600 pixels) under 240 KB. Photos must feature a plain white or light background, neutral facial expression, with ears and eyes clearly visible."
      portalName="Consular & Passport Authorities Worldwide"
      specs={[
        { label: 'Standard Passport', value: '35 × 45 mm (413 × 531 px)' },
        { label: 'US Visa / Passport', value: '2 × 2 Inches (600 × 600 px)' },
        { label: 'Standard File Size', value: '20 KB to 100 KB JPG', highlight: true },
        { label: 'Privacy Standard', value: '100% In-Browser Local Wasm', highlight: true },
      ]}
    />

    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Official Digital Photo Specifications
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        All three checks—format, pixel dimensions, and KB cap—handled together:
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs sm:text-sm">
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">35 × 45 mm Standard Passport</div>
          <div class="font-mono text-accent text-xs mt-1">413 × 531 px · 20–100 KB JPG</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Used by Passport Seva, UK, EU/Schengen, Canada, Australia, and university exam portals.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">2 × 2 Inch US Visa &amp; Passport</div>
          <div class="font-mono text-accent text-xs mt-1">600 × 600 px · 1:1 · Under 240 KB</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Square framing required for US DS-160 non-immigrant visas, Green Card DV Lottery, and OCI applications.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">Exam &amp; Recruitment Portals</div>
          <div class="font-mono text-accent text-xs mt-1">350 × 450 px · 20–50 KB JPG</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Strict size brackets for UPSC, SSC, IBPS, state civil services, and digital signature uploads.
          </p>
        </div>
      </div>
    </section>

    <!-- In-Depth Biometric Photo Standards Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        How to Ensure Your Photo Passes Automated Portal Validation
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Automated portal rejection is almost always caused by one of three issues: incorrect aspect ratio, invalid pixel dimensions, or exceeding the portal's byte cap. Government portals like Passport Seva, US Visa DS-160, and state exam portals employ automated machine vision validators that reject images if the facial area occupies less than 70% of the vertical frame or if file size exceeds the ceiling by even 1 single byte.
        </p>
        <p>
          PixelKit's workflow solves all three in a single execution: start with the Crop Studio to frame head-and-shoulders with balanced margins, click the 413×531 px or 600×600 px dimension preset in the Resize panel, and set your target ceiling (e.g. 50KB or 100KB). The output JPG is guaranteed to pass automated validation.
        </p>
        <p>
          With our comprehensive library of 20 1-Click Official Portal Presets, you can instantly configure verified specifications for major consular authorities worldwide. Presets include US Visa &amp; DS-160 (600×600 px, 240KB), Indian Passport Seva Kendra (413×531 px, 100KB), Schengen European Visa (413×531 px, 200KB), UK Visas &amp; Immigration (413×531 px, 200KB), Canada IRCC PR &amp; Study Permit (420×540 px, 240KB), Australia ImmiAccount (413×531 px, 200KB), China Visa (390×567 px, 120KB), Japan MOFA eVisa (413×531 px, 200KB), UAE ICP/GDRFA (413×531 px, 100KB), Saudi Arabia eVisa (600×600 px, 100KB), Singapore ICA (400×514 px, 150KB), Malaysia MyOnline Passport (413×591 px, 100KB), and New Zealand NZeTA (450×600 px, 250KB), alongside Indian national exams (UPSC, SSC, NEET, 350×450 px, 50KB), candidate signatures (280×140 px, 20KB), and thumbprint scans (200×200 px, 20KB).
        </p>
        <p>
          Every biometric capture is handled with bank-grade privacy. Web Workers process all pixels in ephemeral device memory, ensuring your face photos, identification cards, and personal records remain 100% private and never touch remote servers.
        </p>
      </div>
    </section>

    <!-- Dedicated Government & Exam Portal Tools -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Dedicated Portal &amp; Exam Tools
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Single-click, pre-configured resizers strictly calibrated to official portal limits:
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs sm:text-sm">
        <a href="/ssc-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg group-hover:text-accent">SSC Photo Resizer</div>
          <div class="font-mono text-accent text-xs mt-1">350 × 450 px · 20KB–50KB JPG</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            SSC CGL, CHSL, MTS &amp; GD compliant photo crop and compression.
          </p>
        </a>

        <a href="/upsc-signature-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg group-hover:text-accent">UPSC Signature Resizer</div>
          <div class="font-mono text-accent text-xs mt-1">280 × 140 px · 10KB–20KB JPG</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Pre-tuned for UPSC CSE, CDS, NDA and One-Time Registration (OTR).
          </p>
        </a>

        <a href="/pan-card-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg group-hover:text-accent">PAN Card Photo Resizer</div>
          <div class="font-mono text-accent text-xs mt-1">213 × 213 px · 200 DPI · &lt; 50KB</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            NSDL and UTIITSL exact square dimensions and DPI specifications.
          </p>
        </a>

        <a href="/us-visa-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg group-hover:text-accent">US Visa Photo Resizer</div>
          <div class="font-mono text-accent text-xs mt-1">600 × 600 px · 1:1 · &lt; 240KB</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            US DS-160 visa, passport, and Green Card DV Lottery photo maker.
          </p>
        </a>

        <a href="/neet-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg group-hover:text-accent">NEET Photo Resizer</div>
          <div class="font-mono text-accent text-xs mt-1">Passport &amp; 4×6" Postcard · &lt; 200KB</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            NTA NEET-UG &amp; JEE Main passport and postcard photo cropper.
          </p>
        </a>

        <a href="/compress-image-to-1mb/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <div class="font-bold text-fg group-hover:text-accent">Compress Image to 1MB</div>
          <div class="font-mono text-accent text-xs mt-1">High-Res Scans · &lt; 1024KB</div>
          <p class="text-muted mt-1.5 text-xs leading-relaxed">
            Shrink heavy certificates, resumes, and multi-page documents under 1MB.
          </p>
        </a>
      </div>

      <div class="mt-5 pt-4 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">More Exam &amp; Visa Studios:</span>
        <a href="/signature-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Signature Resizer</a>
        <a href="/signature-resizer-10kb-to-20kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Signature 10KB–20KB</a>
        <a href="/ibps-photo-signature-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">IBPS Photo &amp; Sign</a>
        <a href="/sbi-po-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">SBI PO Resizer</a>
        <a href="/jee-main-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">JEE Main Resizer</a>
        <a href="/gate-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">GATE Resizer</a>
        <a href="/cuet-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">CUET Resizer</a>
        <a href="/rrb-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">RRB Railway Resizer</a>
        <a href="/aadhaar-pdf-compressor/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Aadhaar PDF Compressor</a>
        <a href="/schengen-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Schengen Visa</a>
        <a href="/uk-passport-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">UK Passport</a>
        <a href="/canada-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Canada Visa</a>
        <a href="/australia-passport-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Australia Passport</a>
        <a href="/china-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">China Visa (COVA)</a>
        <a href="/japan-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Japan e-Visa</a>
        <a href="/singapore-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Singapore ICA</a>
        <a href="/malaysia-passport-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Malaysia Passport</a>
        <a href="/new-zealand-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">New Zealand Visa</a>
        <a href="/upsc-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">UPSC Photo Resizer</a>
        <a href="/thumb-impression-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Thumb Impression (LTI)</a>
        <a href="/uae-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">UAE &amp; Dubai Visa</a>
        <a href="/saudi-visa-photo-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Saudi eVisa &amp; Umrah</a>
        <a href="/change-image-dpi-to-300/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Change DPI to 300</a>
      </div>
    </section>

    <!-- Related Guides & Links -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface/50 p-5 sm:p-8">
      <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-fg">
        Essential Guides for Document &amp; Visa Uploads
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3 text-sm">
        <a href="/blog/how-to-resize-image-to-passport-size/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Step-by-Step Guide</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">How to Resize Images to Passport Size</h3>
          <p class="text-xs text-muted mt-1.5">Full guide to official millimeter, inch, and 300 DPI pixel dimensions for 30+ countries.</p>
        </a>
        <a href="/blog/why-portals-reject-200kb-photos/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Troubleshooting</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Why Portals Reject Photos &amp; How to Fix It</h3>
          <p class="text-xs text-muted mt-1.5">Common reasons automated government validators fail uploads and how to pass first time.</p>
        </a>
        <a href="/crop-image/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Framing Tool</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Crop Image Studio</h3>
          <p class="text-xs text-muted mt-1.5">Interactive visual cropping with 1:1 square, 3:4 portrait, and rule of thirds grid.</p>
        </a>
      </div>
    </section>

    <ExamComparisonTable />

    <PortalRequirementsGuide />

    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>
