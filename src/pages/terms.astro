---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Button from '@components/ui/Button.astro';
import { SITE } from '@lib/constants';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Terms of Use' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Terms of Use — ${SITE.name}`,
    description: "Plain-English terms for using PixelKit. Free, browser-based, no warranty, private.",
    url: new URL('/terms', SITE.url).href,
  },
];
---

<BaseLayout
  title={`Terms of use — ${SITE.name}`}
  description="Plain-English terms for using PixelKit. Short, because there isn't much to it — free, as-is, no warranty, use responsibly."
  jsonLd={jsonLd}
  width="default"
>
  <div class="mx-auto max-w-3xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Page Header -->
    <header class="mt-5 sm:mt-8">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1 text-[11px] text-muted font-medium mb-3">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Plain-English Terms · Simple &amp; Transparent</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-fg">
        Terms of Use
      </h1>
      <p class="mt-2.5 sm:mt-3 text-xs sm:text-base text-muted leading-relaxed">
        By using PixelKit, you agree to these simple terms. If you don't agree with them, please do not use the service.
      </p>
    </header>

    <!-- Key Terms Summary -->
    <div class="mt-6 sm:mt-8 rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
      <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-fg mb-3.5">
        Summary of Key Terms
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">Free to Use:</strong> You can convert personal and commercial files for free.</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">Provided As-Is:</strong> Free tool offered without guarantees or formal warranties.</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">Keep Your Backups:</strong> Files are never stored, so we cannot recover lost files.</span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-muted"><strong class="text-fg">Lawful Purpose:</strong> Don't use the service to break laws or attack systems.</span>
        </div>
      </div>
    </div>

    <!-- Detailed Sections -->
    <div class="mt-6 sm:mt-8 space-y-4 sm:space-y-6">
      <!-- What PixelKit is -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">What PixelKit is</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          PixelKit is a free, browser-based file converter and compressor. It is provided as-is, with no warranty of any kind, express or implied. We do our best to make it work reliably, but we cannot guarantee any specific result, exact visual reproduction, or acceptance by a third-party portal or government service.
        </p>
      </section>

      <!-- Acceptable use -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-3.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Acceptable use</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed mb-3">
          You may use PixelKit for any lawful purpose. You agree not to:
        </p>
        <ul class="space-y-2 text-xs sm:text-sm text-muted">
          <li class="flex items-start gap-2.5">
            <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-rose-500/15 text-[10px] font-bold text-rose-500 mt-0.5">✕</span>
            <span>Use the site to violate any local, national, or international law.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-rose-500/15 text-[10px] font-bold text-rose-500 mt-0.5">✕</span>
            <span>Attempt to interfere with the site's operation, infrastructure, or availability.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-rose-500/15 text-[10px] font-bold text-rose-500 mt-0.5">✕</span>
            <span>Republish PixelKit as your own standalone product without clear and prominent attribution.</span>
          </li>
        </ul>
      </section>

      <!-- No liability -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Disclaimer of Liability</h2>
        </div>
        <div class="space-y-3 text-xs sm:text-sm text-muted leading-relaxed">
          <p>
            PixelKit is provided "as is" and "as available." To the maximum extent permitted by law, we disclaim all warranties and are not liable for any damages arising from your use of the site, including but not limited to data loss, quality degradation, or rejection of a converted file by a third-party service.
          </p>
          <div class="rounded-lg border border-amber-500/20 bg-amber-500/5 p-3 text-amber-700 dark:text-amber-400">
            <strong class="font-semibold">Important Backup Notice:</strong> Because files are processed entirely in your browser and we never receive or store them, we cannot recover any lost files for you. Always retain copies of your original files.
          </div>
        </div>
      </section>

      <!-- Changes -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-500/10 text-purple-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Changes to Terms</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          We may update these terms occasionally. When modifications are made, we will update the date shown below. Continued use of PixelKit following any changes constitutes your acceptance of the revised terms.
        </p>
      </section>

      <!-- Contact -->
      <section class="rounded-xl sm:rounded-2xl border border-border/80 bg-surface/90 p-4 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-500/10 text-sky-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-fg">Questions &amp; Contact</h2>
        </div>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          Have any questions regarding our terms of service?
        </p>
        <div class="mt-3">
          <a
            href="mailto:saqibbaig110@gmail.com"
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-medium text-fg hover:border-accent hover:text-accent transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
            </svg>
            <span>saqibbaig110@gmail.com</span>
          </a>
        </div>
      </section>
    </div>

    <!-- Date tag & Actions -->
    <div class="mt-6 flex items-center justify-between text-xs text-muted">
      <span>Last updated: January 2026</span>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row gap-2.5 sm:gap-3 pb-8">
      <Button href="/convert/" variant="primary" size="md" class="w-full sm:w-auto text-center justify-center">Start converting files</Button>
      <Button href="/privacy/" variant="secondary" size="md" class="w-full sm:w-auto text-center justify-center">Read Privacy Policy</Button>
    </div>
  </div>
</BaseLayout>