---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import DirectAnswerBox from '@components/seo/DirectAnswerBox.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
  buildCustomHowToJsonLd,
} from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Resize Image', href: '/resize-image/' },
  { label: 'Resize Image to 20KB to 50KB' },
];

const faqs = [
  {
    q: 'How do I resize an image to between 20KB and 50KB?',
    a: 'Upload your photo (JPG, PNG, WebP, or iPhone HEIC) to PixelKit. Select passport dimensions (350 × 450 px or 3.5 × 4.5 cm). PixelKit uses binary-search quantization calibrated to land at ~38 KB, comfortably above the 20 KB minimum and safely beneath the 50 KB maximum required by SSC, UPSC, and state exam portals.',
  },
  {
    q: 'Why do government portals enforce a 20KB to 50KB bracket?',
    a: 'Intake systems reject files over 50KB to conserve server storage and bandwidth. Simultaneously, automated facial recognition scanners reject files under 20KB because excessive compression blurs biometric facial markers, ears, and eyes. PixelKit guarantees your photo stays within this exact 20KB–50KB window.',
  },
  {
    q: 'What should I do if my photo is already smaller than 20KB?',
    a: 'If your photo is under 20KB (e.g. 15KB or 18KB), the portal will reject it. Use PixelKit’s "Increase Image Size in KB" tool to safely add standardized JPEG metadata padding, elevating your file into the 25KB–35KB range with zero visual distortion or blur.',
  },
  {
    q: 'What are the official dimension specifications for 20KB–50KB exam photos?',
    a: 'Most portals requiring 20KB to 50KB photos (SSC CGL/CHSL/MTS, UPSC Civil Services, State PSCs) mandate dimensions of 350 × 450 pixels (3.5 cm width × 4.5 cm height) with 80% face coverage against a clean white or light background.',
  },
  {
    q: 'Are candidate photos uploaded to any external server?',
    a: 'No. PixelKit executes 100% locally on your computer or mobile phone via WebAssembly and Canvas APIs. Your confidential photographs, biometric data, and documents never leave your device.',
  },
];

const directAnswer = {
  question: 'How to resize an image to 20KB to 50KB for online forms?',
  answer:
    'To resize an image between 20KB and 50KB, drop your JPG, PNG, or HEIC photo into PixelKit. Select 3.5 × 4.5 cm (350 × 450 px) passport framing. PixelKit automatically targets ~38 KB, landing right in the sweet spot between the 20 KB minimum and 50 KB maximum required by SSC, UPSC, and State PSC portals. Click Download for an instant, compliant JPEG with zero server uploads.',
};

const pageTitle = `Resize Image to 20KB to 50KB Online Free | ${SITE.name}`;
const pageDesc =
  'Resize image to 20KB, 50KB, or strictly 20KB to 50KB (350×450 px / 3.5×4.5 cm) online free. Instant photo resizer in KB for SSC, UPSC & portals—no upload.';
const pageKeywords = [
  'resize image to 20kb to 50kb',
  'resize photo to 20kb to 50kb',
  'resize image to 20 to 50 kb',
  'compress image to 20kb to 50kb',
  'compress photo to 20kb to 50kb',
  'resize photo 20kb to 50kb online',
  'photo resizer 20kb to 50kb',
  'ssc photo resize 20kb to 50kb',
  'upsc photo resize 20kb to 50kb',
  'image resizer in kb',
  'resize image to 50kb',
  'resize image to 20kb',
];

const howToJsonLd = buildCustomHowToJsonLd({
  name: 'How to resize an image to 20KB to 50KB online',
  description:
    'Step-by-step instructions to crop, dimension-scale, and compress photos strictly within the 20KB to 50KB bracket for government job portals.',
  steps: [
    {
      name: 'Upload candidate photo',
      text: 'Drop or select your photo (JPG, PNG, or iPhone HEIC) into the 20KB to 50KB resizer tool.',
    },
    {
      name: 'Select passport dimensions',
      text: 'Apply 350 × 450 pixels (3.5 × 4.5 cm) framing with 80% face coverage and clear ears.',
    },
    {
      name: 'Auto-calibrate target size',
      text: 'PixelKit targets ~38 KB, safely positioned between the 20 KB lower floor and 50 KB ceiling.',
    },
    {
      name: 'Download compliant JPEG',
      text: 'Click "Download" to immediately save your verified, portal-ready JPEG file.',
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit Resize Image to 20KB to 50KB Tool',
    description: pageDesc,
    url: 'https://pixelkit.app/resize-image-to-20kb-to-50kb/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (Web Browser)',
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(breadcrumbs),
  howToJsonLd,
];

const portalsRequiringBracket = [
  {
    name: 'SSC (Staff Selection Commission)',
    exams: 'SSC CGL, CHSL, MTS, GD, Stenographer, CPO',
    dims: '350 × 450 px (3.5 × 4.5 cm)',
    bracket: '20 KB to 50 KB strictly',
    bg: 'Light / White background, both ears visible',
  },
  {
    name: 'UPSC (Union Public Service Commission)',
    exams: 'Civil Services (IAS/IPS), NDA, CDS, CMS, IES',
    dims: '350 × 350 to 1000 × 1000 px',
    bracket: '20 KB to 50 KB (or 300 KB max)',
    bg: 'Clear frontal portrait taken within 10 days',
  },
  {
    name: 'State PSCs & Recruitment Boards',
    exams: 'UPPSC, BPSC, MPSC, WBPSC, APPSC, TSPSC',
    dims: '3.5 × 4.5 cm (approx 413 × 531 px at 300 DPI)',
    bracket: '20 KB to 50 KB strictly',
    bg: 'Plain white background without glasses or caps',
  },
  {
    name: 'Railway Recruitment Boards (RRB)',
    exams: 'RRB NTPC, Group D, ALP, Technician',
    dims: '35 × 45 mm',
    bracket: '20 KB to 50 KB strictly',
    bg: 'Color photograph with sharp contrast',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="https://pixelkit.app/resize-image-to-20kb-to-50kb/"
  keywords={pageKeywords}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mt-4 sm:mt-6 text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-xs font-semibold text-accent">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        SSC · UPSC · State PSC · Official Bracket Preset
      </div>
      <h1 class="mt-3 text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-fg">
        Resize Image to 20KB to 50KB Online
      </h1>
      <p class="mx-auto mt-2 max-w-2xl text-xs sm:text-sm text-muted">
        Scale photo dimensions to 350 × 450 px (3.5 × 4.5 cm) and compress file weight strictly inside the 20KB–50KB bracket. Zero server uploads, 100% private in-browser tool.
      </p>
    </header>

<div class="mt-5 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={50}
        initialTool="passport"
        preset="exam-ssc"
        category="exam"
        initialSizeMode="range"
        minKb={20}
        maxKb={50}
      />
    </div>

    <!-- GEO Direct Answer Definition Block -->
    <DirectAnswerBox
        title="How to Resize an Image to 20KB to 50KB for Online Forms"
        summaryText={directAnswer.answer}
        specs={[
          { label: 'Allowable File Bracket', value: '20 KB Min to 50 KB Max', highlight: true },
          { label: 'Target Sweet Spot', value: '~38 KB (18 KB floor / 12 KB ceiling margin)', highlight: true },
          { label: 'Required Dimensions', value: '350 × 450 px (3.5 × 4.5 cm)' },
          { label: 'Accepted File Format', value: 'JPEG / JPG with White Background' },
        ]}
      />

    <!-- Official Portal Bracket Table -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Portals Enforcing the 20KB to 50KB File Size Bracket
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Upload portals verify both minimum and maximum limits. PixelKit targets ~38 KB to safely avoid both rejection errors:
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-border bg-surface text-fg font-semibold">
              <th class="py-3 px-4">Authority &amp; Portal</th>
              <th class="py-3 px-4">Exams Covered</th>
              <th class="py-3 px-4">Required Dimensions</th>
              <th class="py-3 px-4">Allowable Bracket</th>
              <th class="py-3 px-4">Background &amp; Framing</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            {portalsRequiringBracket.map((portal) => (
              <tr class="hover:bg-surface/50 transition-colors">
                <td class="py-3.5 px-4 font-semibold text-fg">{portal.name}</td>
                <td class="py-3.5 px-4 text-muted">{portal.exams}</td>
                <td class="py-3.5 px-4 font-mono text-accent text-xs">{portal.dims}</td>
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-500 text-xs">{portal.bracket}</td>
                <td class="py-3.5 px-4 text-muted text-xs">{portal.bg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Quick Links -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Related Tools:</span>
        <a href="/ssc-photo-resizer/" class="rounded-lg border border-accent/30 bg-accent/10 px-2.5 py-1 font-medium text-accent hover:bg-accent/15 transition-colors">SSC Photo Resizer →</a>
        <a href="/upsc-signature-resizer/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">UPSC Signature Resizer (10KB–20KB)</a>
        <a href="/compress-image-to-50kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Resize Image to 50KB</a>
        <a href="/compress-image-to-20kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Resize Image to 20KB</a>
        <a href="/increase-image-size-in-kb/" class="rounded-lg border border-border bg-bg px-2.5 py-1 font-medium text-fg hover:border-accent hover:text-accent transition-colors">Increase Size in KB (If under 20KB)</a>
      </div>
    </section>

    <!-- Technical Guide on Avoiding Bracket Rejections -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Why Simple Compressors Fail on 20KB to 50KB Uploads
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Most general-purpose compressors only push files as small as possible. If your file drops to 17 KB or 19 KB, the SSC or UPSC portal script immediately throws an error:
        </p>
        <div class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-3.5 font-mono text-xs text-rose-400">
          Error: "Photograph file size must be between 20 KB and 50 KB. Current file size: 18.4 KB."
        </div>
        <p>
          PixelKit solves this dual-constraint challenge with intelligent bracket targeting:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm text-muted">
          <li>
            <strong class="text-fg">Target Sweet Spot (38 KB):</strong> Our binary search aims directly at ~38 KB, providing an 18 KB buffer above the minimum floor and a 12 KB buffer below the maximum ceiling.
          </li>
          <li>
            <strong class="text-fg">350 × 450 Pixel Resampling:</strong> Sharp bicubic resampling prevents the blurry facial artifacts that cause candidate rejection during examination hall identity verification.
          </li>
          <li>
            <strong class="text-fg">Client-Side Metadata Stripping:</strong> Removes bulky camera geolocation, device tags, and thumbnail forks while preserving standard JFIF color headers.
          </li>
        </ul>
      </div>
    </section>

    <!-- Official Portal Specs Guide -->
    <div class="mt-12 sm:mt-16">
      <PortalRequirementsGuide />
    </div>

    <!-- FAQ Section -->
    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>

