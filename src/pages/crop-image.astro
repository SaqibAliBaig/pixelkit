---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import { SITE } from '@lib/constants';
import { buildSoftwareApplicationJsonLd, buildFaqJsonLd, buildBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Crop Image' },
];

const faqs = [
  {
    q: 'How do I crop an image to a 1:1 square ratio?',
    a: 'Upload your image, click "Crop Studio" on the file card, and select the "1:1 Square" chip. Drag the handles or frame to position your crop, and click "Apply Crop".',
  },
  {
    q: 'What aspect ratios are supported for cropping?',
    a: 'PixelKit includes 1-click presets for 1:1 (Square), 4:5 (Instagram portrait), 16:9 (YouTube widescreen), 9:16 (TikTok/Reels/Stories), 4:3 (Classic photo), 3:2 (DSLR), and Freeform custom cropping.',
  },
  {
    q: 'Can I crop and compress an image at the same time?',
    a: 'Yes. Once you apply your crop in the Crop Studio, you can choose an output format (JPG, PNG, WebP) and an exact target KB limit (e.g., 50KB or 100KB) in the settings panel.',
  },
  {
    q: 'Does cropping reduce the photo quality?',
    a: 'No. PixelKit extracts the cropped pixel matrix directly from your original image data without extra lossy re-encoding steps before compression.',
  },
  {
    q: 'Is this image cropper completely private?',
    a: 'Yes. The entire crop and canvas framing operation executes inside your local device memory using WebAssembly and Canvas API. Zero images are sent to any remote servers.',
  },
];

const pageTitle = `Crop Image Online — Free Aspect Ratio Photo Cropper | ${SITE.name}`;
const pageDesc = 'Free online image cropper. Crop photos to exact aspect ratios including 1:1 square, 4:5 portrait, 16:9 widescreen, and freeform framing in your browser.';

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: 'PixelKit Image Cropper',
    description: pageDesc,
    url: new URL('/crop-image/', SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero -->
    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Aspect Ratio Framing · Visual Rule of Thirds · 100% Free</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-3xl font-bold tracking-tight sm:text-5xl text-fg">
        Crop Image Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        Crop photos to perfect aspect ratios for social media, document portals, and website headers. Live visual framing with instant in-browser preview.
      </p>
    </header>

    <!-- Tool Preview -->
    <div class="mt-6 sm:mt-8">
      <ToolPreview from="jpg" to="jpg" fromMime="image/jpeg" toMime="image/jpeg" />
    </div>

    <!-- Aspect Ratio Guide Grid -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Supported Aspect Ratio Presets
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Standard aspect ratios for modern platforms:
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-4 gap-3.5 text-xs sm:text-sm">
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">1:1 Square</div>
          <div class="font-mono text-accent text-xs mt-1">Profile &amp; Posts</div>
          <p class="text-muted mt-1.5 text-xs">Ideal for Instagram feed, WhatsApp DP, Discord icons, and avatar uploads.</p>
        </div>
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">4:5 Portrait</div>
          <div class="font-mono text-accent text-xs mt-1">Social Feed</div>
          <p class="text-muted mt-1.5 text-xs">Maximizes screen real estate on mobile feeds like Instagram and Facebook.</p>
        </div>
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">16:9 Landscape</div>
          <div class="font-mono text-accent text-xs mt-1">Widescreen &amp; Video</div>
          <p class="text-muted mt-1.5 text-xs">Standard format for YouTube thumbnails, presentation slides, and web banners.</p>
        </div>
        <div class="rounded-xl border border-border bg-bg/50 p-4">
          <div class="font-bold text-fg">9:16 Story / Reel</div>
          <div class="font-mono text-accent text-xs mt-1">Full Mobile Screen</div>
          <p class="text-muted mt-1.5 text-xs">Vertical full-screen framing for Instagram Reels, TikTok, and YouTube Shorts.</p>
        </div>
      </div>
    </section>

    <!-- Comprehensive In-Depth Cropping Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Mastering Image Cropping for Web &amp; Documents
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Cropping is more than cutting unwanted edges from a photo—it fundamentally alters visual composition, directs viewer focus, and aligns imagery with strict platform specifications. Whether adapting a horizontal DSLR capture for vertical mobile feeds or preparing official biometric documents, choosing the right aspect ratio ensures your visuals look professional without unexpected auto-cropping or distortion.
        </p>
        <p>
          When you use PixelKit's in-browser Crop Studio, your original pixels are manipulated entirely in local device memory via high-performance HTML5 Canvas APIs. You can activate the 3×3 Rule of Thirds grid overlay to align focal points along harmonic visual intersections, lock specific aspect ratios to prevent accidental stretching, or drag freeform crop handles for pixel-level framing precision.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 mt-4 pt-2">
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <h3 class="font-semibold text-fg text-sm">Compositional Integrity</h3>
            <p class="text-xs text-muted mt-1">
              Position key subjects at horizontal and vertical grid intersections. Keep sufficient headroom in portraits to avoid feeling cramped on small mobile viewports.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <h3 class="font-semibold text-fg text-sm">Target Resolution Retention</h3>
            <p class="text-xs text-muted mt-1">
              Cropping discards peripheral pixels. If your target destination demands minimum dimensions (e.g., 600×600 px for passport portals), start from high-resolution source captures.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Articles & Companion Tools -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface/50 p-5 sm:p-8">
      <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-fg">
        Related Cropping &amp; Resizing Resources
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3 text-sm">
        <a href="/blog/how-to-crop-image-to-exact-aspect-ratio/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Tutorial Guide</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">How to Crop Images to Exact Aspect Ratios</h3>
          <p class="text-xs text-muted mt-1.5">Complete walkthrough on 1:1, 4:5, and 16:9 framing for social media and official uploads.</p>
        </a>
        <a href="/passport-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Dedicated Tool</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Passport Photo Resizer</h3>
          <p class="text-xs text-muted mt-1.5">Crop to 35×45 mm or 2×2 inch and compress under 50KB/100KB in one automated pass.</p>
        </a>
        <a href="/resize-image/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Companion Tool</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Resize Image Studio</h3>
          <p class="text-xs text-muted mt-1.5">Resample pixel dimensions with high-fidelity bicubic scaling and locked aspect ratios.</p>
        </a>
      </div>
    </section>

    <!-- FAQs -->
    <PortalRequirementsGuide />

    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>
