          body: 'Bypass Discord profile picture upload limits by compressing animated or static headshots cleanly under 256KB.',
        },
        {
          title: 'US DS-160 Consular Forms',
          dims: '600 × 600 px · Max 240–256 KB',
          body: 'Meet strict US Department of State digital visa standards without automated portal upload rejections.',
        },
        {
          title: 'Fast Mobile Web Imagery',
          dims: '1200 px Wide · WebP / JPG',
          body: 'Ensure blog headers and product cards load under 256KB for green Google PageSpeed and Core Web Vitals scores.',
