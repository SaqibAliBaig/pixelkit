        },
      ],
      tip: 'Uploading an ID card? Use Crop Studio first to remove the desk surface around the card—that single step saves up to 50% of your byte budget for readable text.',
    },
    {
      size: 150,
      headline: 'Compress Image to 150KB Online',
      badge: 'Marksheet Scans · Certificates · Aadhaar & IDs',
      portalSummary:
        'Compress high-resolution certificates, 10th/12th marksheets, and scanned government IDs under 150KB in JPG or PDF. Ensures small text, stamps, and signatures stay crisp.',
      useCases: [
        {
          title: '10th & 12th Board Marksheets',
          dims: 'A4 Scan · Under 150 KB',
          body: 'Keep roll numbers, marks, and official school seals sharp and legible for portal verification.',
        },
        {
          title: 'Aadhaar & Voter Card Scans',
          dims: 'JPG or PDF · Max 150 KB',
          body: 'Preserve small text and QR codes on both front and back identity card sides.',
        },
        {
          title: 'Degree & Category Certificates',
          dims: 'Document Scan · Under 150 KB',
          body: 'Shrink 5MB phone photos to under 150KB without blurring essential registration stamps.',
        },
      ],
      tip: 'Crop desk backgrounds out of your marksheet photo before compression to dedicate all 150KB to document text.',
    },
    {
      size: 200,
      headline: 'Compress Image to 200KB Online',
      badge: 'Visa DS-160 · Passports · Official Portals',
      portalSummary:
        'Shrink high-resolution camera and iPhone photos to under 200KB without visible quality loss. Engineered for US DS-160 visas, international passports, and embassy forms.',
      useCases: [
        {
          title: 'US Visa & Embassy Forms',
          dims: '600 × 600 px · Under 200 KB',
