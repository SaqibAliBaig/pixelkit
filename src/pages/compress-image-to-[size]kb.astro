    {
      size: 256,
      headline: 'Compress Image to 256KB Online',
      badge: 'Discord Avatars · US Visa DS-160 · Web Graphics',
      portalSummary:
        'Compress JPG, PNG, and WebP images strictly under 256KB without visible distortion. Ideal for Discord avatar upload caps, US visa and consular document forms, and high-performance website imagery.',
      useCases: [
        {
          title: 'Discord Avatars & Emotes',
