---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import ToolPreview from '@components/home/ToolPreview.astro';
import FAQSection from '@components/seo/FAQSection.astro';
import PortalRequirementsGuide from '@components/seo/PortalRequirementsGuide.astro';
import { SITE } from '@lib/constants';
import {
  buildSoftwareApplicationJsonLd,
  buildFaqJsonLd,
  buildBreadcrumbJsonLd,
} from '@lib/seo/jsonld';

interface KbTargetSpec {
  size: number;
  headline: string;
  badge: string;
  portalSummary: string;
  useCases: { title: string; dims: string; body: string }[];
  tip: string;
}

export const getStaticPaths: GetStaticPaths = () => {
  const specs: KbTargetSpec[] = [
    {
      size: 20,
      headline: 'Compress Image to 20KB Online',
      badge: 'Signatures · Thumbprints · Exam Portals',
      portalSummary:
        'Shrink JPG, PNG, WebP, or HEIC photos to 20KB or under without unreadable blur. Tuned for strict SSC, UPSC, IBPS, and state-exam signature and thumbprint upload slots.',
      useCases: [
        {
          title: 'Digital Signatures',
          dims: '140 × 60 px · 10–20 KB',
          body: 'Crop tightly around black-or-blue ink signatures on white paper so text stays razor-sharp under 20KB.',
        },
        {
          title: 'Thumbprint Impressions',
          dims: '240 × 240 px · Under 20 KB',
          body: 'Preserve ridge contrast on scanned left/right thumb impressions required by banking and recruitment portals.',
        },
        {
          title: 'Compact Exam Avatars',
          dims: '200 × 230 px · 15–20 KB',
          body: 'Combine PixelKit Resize Studio with binary-search compression to keep facial features crisp at ultra-low byte budgets.',
        },
      ],
      tip: 'For 20KB targets on 12MP phone photos, open Crop Studio first to trim excess background, or scale dimensions to 350–600 px wide before downloading.',
    },
    {
      size: 50,
      headline: 'Compress Image to 50KB Online',
      badge: 'Exam Forms · Passport Portals · Zero Upload',
      portalSummary:
        'Reduce JPG, PNG, HEIC, or WebP images to under 50KB with maximum visual clarity. Ideal for government recruitment forms, university admissions, and passport portals.',
      useCases: [
        {
          title: 'Exam & Recruitment Photos',
          dims: '350 × 450 px · 20–50 KB',
          body: 'Meets strict photo upload brackets enforced by UPSC, SSC, NEET, JEE, and state public service portals.',
        },
        {
          title: 'Passport & ID Portals',
          dims: '413 × 531 px · Under 50 KB',
          body: 'Frame 35 × 45 mm passport proportions in Crop Studio and hit 50KB in a single pass.',
        },
        {
          title: 'High-Clarity Signatures',
          dims: '300 × 120 px · 20–50 KB',
          body: 'Retains crisp pen strokes on scanned declarations and application forms without JPEG halo artifacts.',
        },
      ],
      tip: 'Need an exact bracket like 20KB–50KB? Switch the Compression & Size mode pill to "Range" and enter 20 KB min and 50 KB max.',
    },
    {
      size: 100,
      headline: 'Compress Image to 100KB Online',
      badge: 'Aadhaar · PAN · KYC & Fast Web Images',
      portalSummary:
        'Compress JPG, PNG, WebP, HEIC, and PDF files to under 100KB instantly in your browser. Built for Aadhaar, PAN, bank KYC uploads, and fast ecommerce product thumbnails.',
      useCases: [
        {
          title: 'Aadhaar, PAN & KYC Scans',
          dims: 'JPG or PDF · Max 100 KB',
          body: 'Keep small 12-digit ID numbers and address text crisp at 100% zoom while staying safely below 100KB.',
        },
        {
          title: 'University & Job Portals',
          dims: '413 × 531 px · Under 100 KB',
          body: 'Standard headshot size cap across college registration systems, corporate HR portals, and licensing boards.',
        },
        {
          title: 'Ecommerce & Blog Thumbnails',
          dims: '800 × 800 px · WebP / JPG',
          body: 'Keep product cards and article hero images under 100KB for instant mobile rendering and green LCP scores.',
        },
      ],
      tip: 'Uploading an ID card? Use Crop Studio first to remove the desk surface around the card—that single step saves up to 50% of your byte budget for readable text.',
    },
    {
      size: 200,
      headline: 'Compress Image to 200KB Online',
      badge: 'Visa DS-160 · Passports · Official Portals',
      portalSummary:
        'Shrink high-resolution camera and iPhone photos to under 200KB without visible quality loss. Engineered for US DS-160 visas, international passports, and embassy forms.',
      useCases: [
        {
          title: 'US Visa & Embassy Forms',
          dims: '600 × 600 px · Under 200 KB',
          body: 'Crop to a 1:1 square (2 × 2 inches), resize to 600 × 600 px, and land cleanly below the 200KB–240KB ceiling.',
        },
        {
          title: 'Scanned Certificates',
          dims: 'A4 Scan · JPG or PDF',
          body: 'Compress birth certificates, transcripts, and mark sheets from 6 MB phone shots down to 200KB.',
        },
        {
          title: 'CMS & Social Headers',
          dims: '1920 × 1080 px · WebP / JPG',
          body: 'Deliver crisp Full HD banners and Open Graph cards that load fast on mobile connections.',
        },
      ],
      tip: 'Some portals re-encode uploads on their backend and add a few kilobytes. If 198KB is rejected, set Custom Size to 185KB for guaranteed acceptance.',
    },
    {
      size: 500,
      headline: 'Compress Image to 500KB Online',
      badge: 'Multi-Page PDF · High-Res Web · Portfolios',
      portalSummary:
        'Compress high-resolution photography, scanned documents, and multi-page PDFs under 500KB locally in your browser—zero server uploads, zero watermarks.',
      useCases: [
        {
          title: 'Multi-Page KYC & Tax PDFs',
          dims: '1–3 Pages · Under 500 KB',
          body: 'Switch output format to PDF, toggle "Merge Files into Single PDF", and export front-and-back IDs under 500KB.',
        },
        {
          title: 'Portfolio & Hero Photography',
          dims: '2560 px Wide · JPG / WebP',
          body: 'Preserve fine photographic grain and gradients while cutting 8 MB DSLR exports by over 90%.',
        },
        {
          title: 'Email & Portal Attachments',
          dims: 'Batch ZIP · Fast Delivery',
          body: 'Compress dozens of event or inspection photos in parallel so email attachments send immediately.',
        },
      ],
      tip: 'For modern websites, switch Output Format to WebP or AVIF at 500KB to retain near-lossless 4K clarity.',
    },
  ];

  return specs.map((spec) => ({
    params: { size: String(spec.size) },
    props: { spec },
  }));
};

const { spec } = Astro.props as { spec: KbTargetSpec };
const allSizes = [20, 50, 100, 200, 500];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress Image', href: '/compress-image/' },
  { label: `Under ${spec.size}KB` },
];

const faqs = [
  {
    q: `How do I compress an image to ${spec.size}KB without losing quality?`,
    a: `Drop your JPG, PNG, WebP, or HEIC image into the box above. PixelKit pre-selects a ${spec.size}KB target and runs a 12-step binary-search loop in browser Web Workers to find the highest possible visual quality that fits at or below ${spec.size}KB.`,
  },
  {
    q: `Can I crop and resize pixel dimensions before compressing to ${spec.size}KB?`,
    a: `Yes. Click "Crop Studio" or "Scale & Resize" directly on your dropped image card to set aspect ratios (1:1, 3:4, 16:9) or exact pixel sizes (like 413×531 px passport dimensions) before downloading your ${spec.size}KB output.`,
  },
  {
    q: `What if my portal requires a file between a minimum and ${spec.size}KB?`,
    a: `Click the "Range" mode pill in the Compression & Size panel (for example, 20KB min to ${spec.size}KB max). PixelKit will keep the output strictly inside both bounds.`,
  },
  {
    q: `Are my ID cards or photos uploaded to a server?`,
    a: `Never. Every decode, crop, resize, and ${spec.size}KB compression pass runs 100% locally in your device browser memory. Nothing touches an external server.`,
  },
];

const pageTitle = `Compress Image to ${spec.size}KB Online — Exact Size, Free | ${SITE.name}`;
const pageDesc = `Compress JPG, PNG, WebP, HEIC and PDF to ${spec.size}KB online without losing clarity. Crop, resize pixels, and hit exact ${spec.size}KB portal limits privately.`;

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: `Compress Image to ${spec.size}KB — PixelKit`,
    description: pageDesc,
    url: new URL(`/compress-image-to-${spec.size}kb/`, SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-2 sm:px-0">
    <Breadcrumbs items={breadcrumbs} />

    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>{spec.badge}</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-3xl font-bold tracking-tight sm:text-5xl text-fg">
        {spec.headline}
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        {spec.portalSummary}
      </p>
    </header>

    <div class="mt-6 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={spec.size}
      />
    </div>

    <!-- Use cases -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        When You Need an Image Under {spec.size}KB
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        {spec.tip}
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs sm:text-sm">
        {spec.useCases.map((u) => (
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <div class="font-bold text-fg">{u.title}</div>
            <div class="font-mono text-accent text-xs mt-1">{u.dims}</div>
            <p class="text-muted mt-1.5 text-xs leading-relaxed">{u.body}</p>
          </div>
        ))}
      </div>

      <!-- Sibling KB switches -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Other exact KB targets:</span>
        {allSizes
          .filter((s) => s !== spec.size)
          .map((s) => (
            <a
              href={`/compress-image-to-${s}kb/`}
              class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
            >
              Compress to {s}KB
            </a>
          ))}
        <a
          href="/passport-photo-resizer/"
          class="rounded-lg border border-accent/30 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors"
        >
          Passport Photo Crop &amp; Resizer →
        </a>
      </div>
    </section>
    <!-- Comprehensive Portal Compression Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Technical Strategies for Passing Strict {spec.size}KB Portal Uploads
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
          Online admissions, immigration forms, and job recruitment portals employ automated server-side verification scripts that immediately fail uploads if the file size exceeds {spec.size}KB by even a single byte. Conversely, attempting to shrink large 10MB phone captures down to {spec.size}KB solely through extreme lossy compression often produces muddy, illegible facial features or pixelated signatures that fail biometric review.
        </p>
        <p>
          PixelKit solves this dual constraint by combining client-side dimension rescaling with binary search quantization. If your raw photo is high resolution (such as 3000×4000 pixels), open the Scale &amp; Resize panel to downscale to portal-recommended dimensions (like 350×450 px or 413×531 px). Once dimensions are optimized, PixelKit's iterative binary search finds the exact sweet spot that retains maximum contrast and crisp edges while landing safely under {spec.size}KB.
        </p>
      </div>
    </section>

    <!-- Related Articles & Companion Tools -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface/50 p-5 sm:p-8">
      <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-fg">
        Related Guides &amp; Verification Workflows
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3 text-sm">
        <a href="/blog/why-portals-reject-200kb-photos/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Troubleshooting</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Why Portals Reject Photos &amp; Fixes</h3>
          <p class="text-xs text-muted mt-1.5">Comprehensive breakdown of common automated validation errors and how to pass.</p>
        </a>
        <a href="/blog/how-to-resize-image-to-passport-size/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Dimensions</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">How to Resize to Passport Size</h3>
          <p class="text-xs text-muted mt-1.5">Official pixel standards and 300 DPI millimeter measurements for 30+ countries.</p>
        </a>
        <a href="/passport-photo-resizer/" class="group rounded-xl border border-border bg-bg/60 p-4 hover:border-accent transition-colors">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">All-In-One</span>
          <h3 class="font-medium text-fg group-hover:text-accent mt-1">Passport Photo Resizer</h3>
          <p class="text-xs text-muted mt-1.5">Crop, resize to 413×531 px, and compress under 50KB in one browser execution.</p>
        </a>
      </div>
    </section>


    <PortalRequirementsGuide />

    <div class="mt-12 sm:mt-16">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>

