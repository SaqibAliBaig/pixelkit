    },
    {
      size: 40,
      headline: 'Compress Image to 40KB Online',
      badge: 'TET Exams · University Admissions · Portal Forms',
      portalSummary:
        'Compress JPG and PNG images under 40KB online. Perfect for Teacher Eligibility Tests (TET), state universities, and entrance exams specifying 20KB–40KB photo slots.',
      useCases: [
