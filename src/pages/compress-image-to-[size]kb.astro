    },
    {
      size: 80,
      headline: 'Compress Image to 80KB Online',
      badge: 'Medical Portals · State Exam Forms · High-Res IDs',
      portalSummary:
        'Reduce image size to 80KB or compress photo to 80KB online without blur. Ideal for state nursing, medical admissions, and government recruitment forms enforcing strict 50KB–80KB limits.',
