    },
    {
      size: 300,
      headline: 'Compress Image to 300KB Online',
      badge: 'Scholarship Portals · Certificates · Marksheet Scans',
      portalSummary:
        'Compress photo to 300KB or reduce image size to 300KB in JPG or PDF. Tuned for National Scholarship Portal (NSP), state welfare forms, and multi-page certificate scans.',
      useCases: [
        {
          title: 'National Scholarship Portal (NSP)',
          dims: 'JPG or PDF · Max 300 KB',
