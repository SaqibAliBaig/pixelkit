    },
  ];

  return specs.map((spec) => ({
    params: { size: String(spec.size) },
    props: { spec },
  }));
};

const { spec } = Astro.props as { spec: KbTargetSpec };
const allSizes = [10, 15, 20, 30, 40, 50, 80, 100, 150, 200, 256, 300, 500];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compress Image', href: '/compress-image/' },
  { label: `Under ${spec.size}KB` },
];

const faqs = [
  {
    q: `How do I resize an image to ${spec.size}KB or compress a photo to ${spec.size}KB without losing quality?`,
    a: `Drop your JPG, PNG, WebP, or HEIC image into the box above. PixelKit pre-selects a ${spec.size}KB target and runs a 12-step binary-search loop in browser Web Workers to find the highest possible visual quality that fits strictly at or below ${spec.size}KB.`,
  },
  {
    q: `How can I resize and reduce image size to ${spec.size}KB on mobile (Android & iPhone)?`,
    a: `PixelKit runs 100% locally on Android and iPhone mobile browsers without requiring apps or account signups. Simply select your photo from your phone gallery, and PixelKit resizes and compresses it under ${spec.size}KB directly on your device.`,
  },
  {
    q: `Can I crop and resize pixel or cm dimensions before compressing to ${spec.size}KB?`,
    a: `Yes. Click "Crop Studio" or "Scale & Resize" directly on your dropped image card to set aspect ratios (1:1, 3:4, 3.5×4.5 cm) or exact pixel sizes (like 350×450 px passport or 140×60 px signature dimensions) before downloading your ${spec.size}KB output.`,
  },
  {
    q: `What if my portal requires a file between a minimum and ${spec.size}KB?`,
    a: `Click the "Range" mode pill in the Compression & Size panel (for example, 20KB min to ${spec.size}KB max). PixelKit will keep the output strictly inside both bounds.`,
  },
  {
    q: `Are my ID cards, signatures, or photos uploaded to a server?`,
    a: `Never. Every decode, crop, resize, and ${spec.size}KB compression pass runs 100% locally in your device browser memory. Nothing touches an external server.`,
  },
];

const pageTitle = `Compress & Resize Image to ${spec.size}KB Online Free | ${SITE.name}`;
const pageDesc = `Resize image to ${spec.size}KB or compress photo to exact ${spec.size}KB online free. Shrink JPG, PNG, WebP & PDF dimensions and KB size—no blur, no upload.`;
const pageKeywords = [
  `resize image to ${spec.size}kb`,
  `resize photo to ${spec.size}kb`,
  `compress image to ${spec.size}kb`,
  `compress photo to ${spec.size}kb`,
  `reduce image size to ${spec.size}kb`,
  `reduce photo size to ${spec.size}kb`,
  `resize image to ${spec.size} kb`,
  `compress image to ${spec.size} kb`,
  `compress photo to ${spec.size} kb`,
  `reduce image size to ${spec.size} kb`,
  `reduce photo size to ${spec.size} kb`,
  `compress photo to ${spec.size}kb online`,
  `compress image to ${spec.size}kb online`,
  `resize image to ${spec.size}kb online`,
  `photo to ${spec.size}kb converter`,
  `image compressor ${spec.size}kb`,
  `image resizer ${spec.size}kb`,
  `compress photo to ${spec.size}kb jpg`,
  `compress jpg to ${spec.size}kb`,
  `compress jpg to ${spec.size} kb`,
  `compress jpeg to ${spec.size}kb`,
  `photo resizer in kb`,
  `photo resizer to ${spec.size}kb`,
  `image to ${spec.size}kb`,
];

const howToJsonLd = buildCustomHowToJsonLd({
  name: `How to reduce image size to ${spec.size}KB online`,
  description: `Step-by-step instructions to compress photos or reduce image size strictly under ${spec.size}KB without unreadable blur or server uploads.`,
  steps: [
    {
      name: 'Upload your image',
      text: 'Drag and drop your image file into PixelKit. HEIC, JPG, PNG, and WebP are supported.',
    },
    {
      name: `Select ${spec.size}KB Target Size`,
      text: `PixelKit automatically configures the target file weight limit to ${spec.size}KB using binary search quantization.`,
    },
    {
      name: 'Optional Crop & Resize',
      text: 'Optionally adjust aspect ratio or rescale dimensions to match portal upload specifications.',
    },
    {
      name: `Download compressed ${spec.size}KB file`,
      text: 'Download your optimized file instantly. All processing happens 100% locally in your device browser.',
    },
  ],
});

const jsonLd = [
  buildSoftwareApplicationJsonLd({
    name: `Compress Image to ${spec.size}KB — PixelKit`,
    description: pageDesc,
    url: new URL(`/compress-image-to-${spec.size}kb/`, SITE.url).href,
  }),
  buildFaqJsonLd(faqs),
  howToJsonLd,
  buildBreadcrumbJsonLd(
    breadcrumbs.map((b) => ({
      name: b.label,
      url: b.href ? new URL(b.href, SITE.url).href : undefined,
    }))
  ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  jsonLd={jsonLd}
  width="wide"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="text-center mt-5 sm:mt-8">
      <Badge variant="muted" class="mx-auto inline-flex items-center gap-1.5 py-1 px-3 text-xs shadow-sm">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>{spec.badge}</span>
      </Badge>

      <h1 class="mt-3.5 sm:mt-4 text-balance text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-fg">
        Compress &amp; Resize Image to {spec.size}KB Online
      </h1>

      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-balance text-xs sm:text-base text-muted leading-relaxed">
        {spec.portalSummary}
      </p>
    </header>

<div class="mt-5 sm:mt-8">
      <ToolPreview
        from="jpg"
        to="jpg"
        fromMime="image/jpeg"
        toMime="image/jpeg"
        targetKb={spec.size}
        initialTool="compress"
      />
    </div>

    <!-- GEO Direct Answer Definition Block -->
    <DirectAnswerBox
      title={`How to Resize & Compress Image to ${spec.size}KB Online (2026 Direct Answer)`}
      summaryText={`To resize an image to ${spec.size}KB or compress photos strictly under ${spec.size}KB without blur or artifacts, drop your photo into PixelKit above. Our 12-iteration binary search engine in browser Web Workers dynamically calculates the optimal JPEG/WebP compression quality and optional pixel/cm dimension scaling to land strictly at or below ${spec.size}KB while preserving sharp facial and text clarity.`}
      specs={[
        { label: 'Target File Ceiling', value: `Strictly ≤ ${spec.size} KB`, highlight: true },
        { label: 'Input Formats', value: 'JPG, PNG, WebP, HEIC, PDF' },
        { label: 'Execution', value: '100% In-Browser WebAssembly', highlight: true },
        { label: 'Privacy', value: 'Zero Server Uploads' },
      ]}
    />

    <!-- Use cases -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border/80 bg-surface/90 p-5 sm:p-8 shadow-xs">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        How to Reduce Image Size to {spec.size}KB for Online Portals
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        {spec.tip}
      </p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs sm:text-sm">
        {spec.useCases.map((u) => (
          <div class="rounded-xl border border-border bg-bg/50 p-4">
            <div class="font-bold text-fg">{u.title}</div>
            <div class="font-mono text-accent text-xs mt-1">{u.dims}</div>
            <p class="text-muted mt-1.5 text-xs leading-relaxed">{u.body}</p>
          </div>
        ))}
      </div>

      <!-- Sibling KB switches -->
      <div class="mt-6 pt-5 border-t border-border/60 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted font-medium mr-1">Other exact KB targets:</span>
        {allSizes
          .filter((s) => s !== spec.size)
          .map((s) => (
            <a
              href={`/compress-image-to-${s}kb/`}
              class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
            >
              Compress to {s}KB
            </a>
          ))}
        <a
          href="/compress-image-to-1mb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 1MB
        </a>
        <a
          href="/compress-image-to-2mb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 2MB
        </a>
        <a
          href="/compress-image-to-5mb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 5MB
        </a>
        <a
          href="/compress-image-to-10mb/"
          class="rounded-lg border border-border bg-bg px-3 py-1.5 font-medium text-fg hover:border-accent hover:text-accent transition-colors"
        >
          Compress to 10MB
        </a>
        <a
          href="/compress-image-to-pdf/"
          class="rounded-lg border border-accent/30 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors"
        >
          Compress Image to PDF →
        </a>
        <a
          href="/passport-photo-resizer/"
          class="rounded-lg border border-accent/30 bg-accent/10 px-3 py-1.5 font-medium text-accent hover:bg-accent/15 transition-colors"
        >
          Passport Photo Crop &amp; Resizer →
        </a>
      </div>
    </section>
    <!-- Comprehensive Portal Compression Guide -->
    <section class="mt-12 sm:mt-16 rounded-2xl border border-border bg-surface p-5 sm:p-8">
      <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-fg">
        Technical Strategies for Passing Strict {spec.size}KB Portal Uploads
      </h2>
      <div class="mt-4 space-y-4 text-sm text-fg/85 leading-relaxed">
        <p>
